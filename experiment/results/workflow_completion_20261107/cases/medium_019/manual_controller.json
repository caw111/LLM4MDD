{
  "controller": {
    "states": [
      {
        "name": "distanceMode",
        "type": "bool",
        "initial": false
      },
      {
        "name": "previousPressed",
        "type": "bool",
        "initial": false
      },
      {
        "name": "selectedValue",
        "type": "i32",
        "initial": 0
      }
    ],
    "updates": [
      {
        "if": "io_0 and not previousPressed",
        "then": [
          {
            "assign": "distanceMode",
            "value": "not distanceMode"
          }
        ]
      },
      {
        "assign": "previousPressed",
        "value": "io_0"
      },
      {
        "if": "distanceMode and io_4",
        "then": [
          {
            "assign": "selectedValue",
            "value": "RealFunctions::floor(io_3)"
          }
        ],
        "else": [
          {
            "if": "not distanceMode and io_2",
            "then": [
              {
                "assign": "selectedValue",
                "value": "RealFunctions::floor(io_1)"
              }
            ]
          }
        ]
      }
    ],
    "outputs": {
      "io_5": "selectedValue"
    }
  },
  "req_test_map": {
    "requirements_to_testpoints": [
      {
        "requirement_id": "R1",
        "test_point_id": "source_requirement_R1",
        "test_method": "host_trace",
        "stimulus": "Changed temperature/distance and repeated button edges",
        "oracle": "The display retains only the selected valid sensor value"
      }
    ]
  }
}