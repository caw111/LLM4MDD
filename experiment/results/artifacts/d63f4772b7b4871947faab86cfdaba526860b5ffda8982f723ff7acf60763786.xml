      <Input Name="io_1" Type="bool" />
      <Output Name="io_0" Type="int" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Output Name="io_0" Type="int" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="int" />
          <Expression Expression="sysml_lazy_0 = io_1" />
          <If Condition="sysml_lazy_0">
