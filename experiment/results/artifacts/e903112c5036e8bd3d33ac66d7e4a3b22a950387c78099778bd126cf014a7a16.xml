<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_digit = 0" />
          <Expression Expression="sysml_state_prevBtn1 = true" />
          <Expression Expression="sysml_state_prevBtn2 = true" />
          <Expression Expression="sysml_state_prevBtn3 = true" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_digit" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_prevBtn1" Type="bool" DefaultValue="true" />
    <GlobalVariable Name="sysml_state_prevBtn2" Type="bool" DefaultValue="true" />
    <GlobalVariable Name="sysml_state_prevBtn3" Type="bool" DefaultValue="true" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_1" Type="bool" />
      <Input Name="io_2" Type="bool" />
      <Output Name="io_3" Type="int" />
      <Output Name="io_4" Type="double" />
      <Output Name="io_5" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Input Name="io_2" Type="bool" Source="io_2" />
          <Output Name="io_3" Type="int" />
          <Output Name="io_4" Type="double" />
          <Output Name="io_5" Type="double" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="int" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_conditional_3" Type="int" />
          <LocalVariable Name="sysml_lazy_4" Type="bool" />
          <LocalVariable Name="sysml_conditional_5" Type="int" />
          <LocalVariable Name="sysml_conditional_6" Type="double" />
          <LocalVariable Name="sysml_conditional_7" Type="double" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_prevBtn1" />
          </If>
          <If Condition="sysml_lazy_0">
            <If Condition="(sysml_state_digit + 1) &gt; 9">
              <Expression Expression="sysml_conditional_1 = 0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_1 = sysml_state_digit + 1" />
            </Else>
            <Expression Expression="sysml_state_digit = sysml_conditional_1" />
          </If>
          <Expression Expression="sysml_lazy_2 = io_1" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = !sysml_state_prevBtn2" />
          </If>
          <If Condition="sysml_lazy_2">
            <If Condition="(sysml_state_digit + 2) &gt; 9">
              <Expression Expression="sysml_conditional_3 = 0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_3 = sysml_state_digit + 2" />
            </Else>
            <Expression Expression="sysml_state_digit = sysml_conditional_3" />
          </If>
          <Expression Expression="sysml_lazy_4 = io_2" />
          <If Condition="sysml_lazy_4">
            <Expression Expression="sysml_lazy_4 = !sysml_state_prevBtn3" />
          </If>
          <If Condition="sysml_lazy_4">
            <If Condition="(sysml_state_digit + 3) &gt; 9">
              <Expression Expression="sysml_conditional_5 = 0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_5 = sysml_state_digit + 3" />
            </Else>
            <Expression Expression="sysml_state_digit = sysml_conditional_5" />
          </If>
          <Expression Expression="sysml_state_prevBtn1 = io_0" />
          <Expression Expression="sysml_state_prevBtn2 = io_1" />
          <Expression Expression="sysml_state_prevBtn3 = io_2" />
          <LocalVariable Name="sysml_value_0" Type="int" />
          <Expression Expression="sysml_value_0 = sysml_state_digit" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <If Condition="sysml_state_digit &gt;= 5">
            <Expression Expression="sysml_conditional_6 = 90.0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_6 = 0.0" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_6" />
          <LocalVariable Name="sysml_value_2" Type="double" />
          <If Condition="sysml_state_digit &gt;= 5">
            <Expression Expression="sysml_conditional_7 = 180.0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_7 = 90.0" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_7" />
          <Expression Expression="*io_3 = sysml_value_0" />
          <Expression Expression="*io_4 = sysml_value_1" />
          <Expression Expression="*io_5 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>