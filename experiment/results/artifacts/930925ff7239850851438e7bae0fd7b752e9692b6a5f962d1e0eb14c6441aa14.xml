<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_accumulatedMs = 0" />
          <Expression Expression="sysml_state_lastValidTemp = 0.0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_accumulatedMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_lastValidTemp" Type="double" DefaultValue="0.0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="int" />
      <Input Name="io_1" Type="double" />
      <Input Name="io_2" Type="bool" />
      <Output Name="serial_0_trigger" Type="bool" />
      <Output Name="serial_0_value_0" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="int" Source="io_0" />
          <Input Name="io_1" Type="double" Source="io_1" />
          <Input Name="io_2" Type="bool" Source="io_2" />
          <Output Name="serial_0_trigger" Type="bool" />
          <Output Name="serial_0_value_0" Type="double" />
          <LocalVariable Name="sysml_conditional_0" Type="double" />
          <If Condition="io_2">
            <Expression Expression="sysml_state_lastValidTemp = io_1" />
          </If>
          <Expression Expression="sysml_state_accumulatedMs = (sysml_state_accumulatedMs + io_0)" />
          <If Condition="(sysml_state_accumulatedMs &gt;= 5000)">
            <Expression Expression="sysml_state_accumulatedMs = (sysml_state_accumulatedMs - 5000)" />
          </If>
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <Expression Expression="sysml_value_0 = (sysml_state_accumulatedMs &gt;= 5000)" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <If Condition="io_2">
            <Expression Expression="sysml_conditional_0 = io_1" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_0 = sysml_state_lastValidTemp" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_0" />
          <Expression Expression="*serial_0_trigger = sysml_value_0" />
          <Expression Expression="*serial_0_value_0 = sysml_value_1" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>