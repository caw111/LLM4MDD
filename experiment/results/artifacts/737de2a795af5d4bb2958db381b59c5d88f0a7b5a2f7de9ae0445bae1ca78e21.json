{
  "version": 1,
  "board": "arduino:avr:uno",
  "control_period_ms": 10,
  "planning_notes": [
    "串口波特率固定为9600；framing=line_or_idle；idle_timeout_ms=20。",
    "业务节拍：SysML必须使用elapsed_ms的delta_since_previous_step累积到约3秒，以触发serial_channels触发门控并执行“轮询温度与距离并输出”。",
    "D13为点亮指示：当连续3次测得距离都<20cm时，SysML将digital_output D13置为true，并置位serial_text_output门控以发送固定文本“persistent object detected”。",
    "D7为DHT11单总线引脚：dht_temperature/dht_humidity/dht_valid共用同一物理pin=D7。",
    "D8/D9为HC-SR04：ultrasonic_distance与ultrasonic_valid共享同一触发/回波引脚；超时/越界由catalog将valid置false并保留上一有效距离。"
  ],
  "interfaces": [
    {
      "name": "io_0",
      "direction": "output",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "LED D13（点亮指示：当连续3次距离都<20cm时，SysML点亮并输出固定文本 persistent object detected）",
      "sample_period_ms": 10,
      "device": "digital_output",
      "hardware": "{\"active_high\": true, \"kind\": \"digital_output\", \"pin\": \"D13\"}",
      "binding": {
        "kind": "digital_output",
        "active_high": true,
        "pin": "D13"
      },
      "model_semantics": {
        "kind": "digital_boolean",
        "true_level": "HIGH",
        "false_level": "LOW"
      }
    },
    {
      "name": "io_1",
      "direction": "input",
      "type": "f64",
      "unit": "degC",
      "initial": 0,
      "meaning": "DHT11 温度（参与每约3秒巡检输出；无效读则按hold_last_valid保留上一有效温度）",
      "sample_period_ms": 2000,
      "device": "dht_temperature",
      "hardware": "{\"invalid_policy\": \"hold_last_valid\", \"kind\": \"dht_temperature\", \"pin\": \"D7\", \"sensor\": \"DHT11\"}",
      "binding": {
        "kind": "dht_temperature",
        "invalid_policy": "hold_last_valid",
        "pin": "D7",
        "sensor": "DHT11"
      }
    },
    {
      "name": "io_2",
      "direction": "input",
      "type": "f64",
      "unit": "%RH",
      "initial": 0,
      "meaning": "DHT11 湿度（参与每约3秒巡检输出；无效读则按hold_last_valid保留上一有效湿度）",
      "sample_period_ms": 2000,
      "device": "dht_humidity",
      "hardware": "{\"invalid_policy\": \"hold_last_valid\", \"kind\": \"dht_humidity\", \"pin\": \"D7\", \"sensor\": \"DHT11\"}",
      "binding": {
        "kind": "dht_humidity",
        "invalid_policy": "hold_last_valid",
        "pin": "D7",
        "sensor": "DHT11"
      }
    },
    {
      "name": "io_3",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "DHT11 当前采样有效性：无效时SysML保留上一有效温湿度并将该值置为false",
      "sample_period_ms": 2000,
      "device": "dht_valid",
      "hardware": "{\"invalid_policy\": \"hold_last_valid\", \"kind\": \"dht_valid\", \"pin\": \"D7\", \"sensor\": \"DHT11\"}",
      "binding": {
        "kind": "dht_valid",
        "invalid_policy": "hold_last_valid",
        "pin": "D7",
        "sensor": "DHT11"
      }
    },
    {
      "name": "io_4",
      "direction": "input",
      "type": "f64",
      "unit": "cm",
      "initial": 0,
      "meaning": "HC-SR04 距离（cm）（参与每约3秒巡检输出；超时/越界置valid=false并按hold_last_valid保留上一有效距离）",
      "sample_period_ms": 60,
      "device": "ultrasonic_distance",
      "hardware": "{\"echo_pin\": \"D9\", \"invalid_policy\": \"hold_last_valid\", \"kind\": \"ultrasonic_distance\", \"sensor\": \"HC-SR04\", \"timeout_us\": 30000, \"trigger_pin\": \"D8\"}",
      "binding": {
        "kind": "ultrasonic_distance",
        "sensor": "HC-SR04",
        "timeout_us": 30000,
        "invalid_policy": "hold_last_valid",
        "echo_pin": "D9",
        "trigger_pin": "D8"
      }
    },
    {
      "name": "io_5",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "HC-SR04 距离有效性（超时/越界则false；距离值按hold_last_valid保留上一有效值）",
      "sample_period_ms": 60,
      "device": "ultrasonic_valid",
      "hardware": "{\"echo_pin\": \"D9\", \"invalid_policy\": \"hold_last_valid\", \"kind\": \"ultrasonic_valid\", \"sensor\": \"HC-SR04\", \"timeout_us\": 30000, \"trigger_pin\": \"D8\"}",
      "binding": {
        "kind": "ultrasonic_valid",
        "sensor": "HC-SR04",
        "timeout_us": 30000,
        "invalid_policy": "hold_last_valid",
        "echo_pin": "D9",
        "trigger_pin": "D8"
      }
    },
    {
      "name": "io_6",
      "direction": "input",
      "type": "i32",
      "unit": "ms",
      "initial": 0,
      "meaning": "实际控制步长增量：delta_since_previous_step（用于SysML累积到约3秒后触发一次“轮询温度与距离并通过串口输出”的业务节拍）",
      "sample_period_ms": 10,
      "device": "elapsed_ms",
      "hardware": "{\"kind\": \"elapsed_ms\", \"semantics\": \"delta_since_previous_step\"}",
      "binding": {
        "kind": "elapsed_ms",
        "semantics": "delta_since_previous_step"
      }
    },
    {
      "name": "io_7",
      "direction": "input",
      "type": "i32",
      "unit": "1",
      "initial": 0,
      "meaning": "（可选接收）ASCII命令输入：需求未定义接收协议，由SysML决定是否启用",
      "sample_period_ms": 10,
      "device": "serial_command_input",
      "hardware": "{\"baud\": 9600, \"commands\": {\"OFF\": 2, \"ON\": 1}, \"framing\": \"line_or_idle\", \"idle_timeout_ms\": 20, \"kind\": \"serial_command_input\"}",
      "binding": {
        "kind": "serial_command_input",
        "framing": "line_or_idle",
        "idle_timeout_ms": 20,
        "commands": {
          "ON": 1,
          "OFF": 2
        },
        "baud": 9600
      }
    },
    {
      "name": "io_7_valid",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "True for this model step only when a complete valid serial frame was received; value holds its previous value otherwise",
      "sample_period_ms": 10,
      "device": "Serial receive validity",
      "hardware": "{\"kind\": \"serial_valid\", \"value\": \"io_7\"}",
      "binding": {
        "kind": "serial_valid",
        "value": "io_7"
      }
    },
    {
      "name": "io_8",
      "direction": "output",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "当SysML满足“连续3次距离都<20cm”且需要输出固定文本时，由该门控触发发送",
      "sample_period_ms": 10,
      "device": "serial_text_output",
      "hardware": "{\"baud\": 9600, \"kind\": \"serial_text_output\", \"text\": \"persistent object detected\"}",
      "binding": {
        "kind": "serial_text_output",
        "text": "persistent object detected",
        "baud": 9600
      }
    },
