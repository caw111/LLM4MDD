<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_count = 0" />
          <Expression Expression="sysml_state_alarmLocked = false" />
          <Expression Expression="sysml_state_prevD2Pressed = false" />
          <Expression Expression="sysml_state_prevD3Pressed = false" />
          <Expression Expression="sysml_state_d3PressAccumMs = 0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_count" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_alarmLocked" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_prevD2Pressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_prevD3Pressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_d3PressAccumMs" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_1" Type="bool" />
      <Input Name="io_5" Type="int" />
      <Output Name="io_2" Type="bool" />
      <Output Name="io_3" Type="int" />
      <Output Name="io_4" Type="int" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Input Name="io_5" Type="int" Source="io_5" />
          <Output Name="io_2" Type="bool" />
          <Output Name="io_3" Type="int" />
          <Output Name="io_4" Type="int" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_conditional_4" Type="bool" />
          <LocalVariable Name="sysml_conditional_5" Type="int" />
          <Expression Expression="sysml_lazy_0 = sysml_state_alarmLocked == true" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = io_1 == true" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_alarmLocked = false" />
            <Expression Expression="sysml_state_count = 0" />
          </If>
          <If Condition="(sysml_state_alarmLocked == false)">
            <Expression Expression="sysml_lazy_1 = io_0" />
            <If Condition="sysml_lazy_1">
              <Expression Expression="sysml_lazy_1 = !sysml_state_prevD2Pressed" />
            </If>
            <If Condition="sysml_lazy_1">
              <Expression Expression="sysml_state_count = (sysml_state_count + 1)" />
              <If Condition="((sysml_state_count + 1) &gt;= 15)">
                <Expression Expression="sysml_state_count = 15" />
                <Expression Expression="sysml_state_alarmLocked = true" />
              </If>
            </If>
            <Expression Expression="sysml_lazy_2 = io_1" />
            <If Condition="sysml_lazy_2">
              <Expression Expression="sysml_lazy_2 = !sysml_state_prevD3Pressed" />
            </If>
            <If Condition="sysml_lazy_2">
              <Expression Expression="sysml_state_d3PressAccumMs = 0" />
            </If>
            <If Condition="(io_1 == true)">
              <Expression Expression="sysml_state_d3PressAccumMs = (sysml_state_d3PressAccumMs + io_5)" />
              <If Condition="(sysml_state_d3PressAccumMs &gt;= 1000)">
                <Expression Expression="sysml_state_d3PressAccumMs = 0" />
                <Expression Expression="sysml_state_count = 0" />
              </If>
            </If>
            <Expression Expression="sysml_lazy_3 = !io_1" />
            <If Condition="sysml_lazy_3">
              <Expression Expression="sysml_lazy_3 = sysml_state_prevD3Pressed" />
            </If>
            <If Condition="sysml_lazy_3">
              <If Condition="(sysml_state_d3PressAccumMs &gt;= 1000)">
                <Expression Expression="sysml_state_d3PressAccumMs = 0" />
              </If>
              <Else>
                <Expression Expression="sysml_state_count = (sysml_state_count - 1)" />
                <If Condition="((sysml_state_count - 1) &lt; 0)">
                  <Expression Expression="sysml_state_count = 15" />
                </If>
              </Else>
            </If>
          </If>
          <Expression Expression="sysml_state_prevD2Pressed = io_0" />
          <Expression Expression="sysml_state_prevD3Pressed = io_1" />
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <If Condition="sysml_state_alarmLocked == true">
            <Expression Expression="sysml_conditional_4 = sysml_state_count == 15" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_4 = sysml_state_count == 2" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_4" />
          <LocalVariable Name="sysml_value_1" Type="int" />
          <If Condition="sysml_state_alarmLocked == true">
            <Expression Expression="sysml_conditional_5 = 2000" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_5 = 0" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_5" />
          <LocalVariable Name="sysml_value_2" Type="int" />
          <Expression Expression="sysml_value_2 = sysml_state_count" />
          <Expression Expression="*io_2 = sysml_value_0" />
          <Expression Expression="*io_3 = sysml_value_1" />
          <Expression Expression="*io_4 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>