<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_ledIndex = 7" />
          <Expression Expression="sysml_state_holdMs = 0" />
          <Expression Expression="sysml_state_previousPressed = false" />
          <Expression Expression="sysml_state_pressArmed = false" />
          <Expression Expression="sysml_state_pressedQualified = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_ledIndex" Type="int" DefaultValue="7" />
    <GlobalVariable Name="sysml_state_holdMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_previousPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_pressArmed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_pressedQualified" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Output Name="io_1" Type="double" />
      <Output Name="io_2" Type="double" />
      <Output Name="io_3" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Output Name="io_1" Type="double" />
          <Output Name="io_2" Type="double" />
          <Output Name="io_3" Type="double" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_conditional_4" Type="int" />
          <LocalVariable Name="sysml_lazy_5" Type="bool" />
          <LocalVariable Name="sysml_lazy_6" Type="bool" />
          <LocalVariable Name="sysml_lazy_7" Type="bool" />
          <LocalVariable Name="sysml_lazy_8" Type="bool" />
          <LocalVariable Name="sysml_conditional_9" Type="double" />
          <LocalVariable Name="sysml_lazy_10" Type="bool" />
          <LocalVariable Name="sysml_lazy_11" Type="bool" />
          <LocalVariable Name="sysml_lazy_12" Type="bool" />
          <LocalVariable Name="sysml_conditional_13" Type="double" />
          <LocalVariable Name="sysml_lazy_14" Type="bool" />
          <LocalVariable Name="sysml_lazy_15" Type="bool" />
          <LocalVariable Name="sysml_lazy_16" Type="bool" />
          <LocalVariable Name="sysml_conditional_17" Type="double" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_pressArmed" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_holdMs = 0" />
            <Expression Expression="sysml_state_pressArmed = true" />
          </If>
          <Expression Expression="sysml_lazy_1 = io_0" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = sysml_state_pressArmed" />
          </If>
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_state_holdMs = (sysml_state_holdMs + 5)" />
          </If>
          <Expression Expression="sysml_lazy_2 = !io_0" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = sysml_state_pressArmed" />
          </If>
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_state_pressedQualified = (sysml_state_holdMs &gt;= 150)" />
            <Expression Expression="sysml_state_pressArmed = false" />
            <Expression Expression="sysml_state_holdMs = 0" />
          </If>
          <Expression Expression="sysml_lazy_3 = sysml_state_pressedQualified" />
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_lazy_3 = !sysml_state_previousPressed" />
          </If>
          <If Condition="sysml_lazy_3">
            <If Condition="sysml_state_ledIndex == 7">
              <Expression Expression="sysml_conditional_4 = 0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_4 = sysml_state_ledIndex + 1" />
            </Else>
            <Expression Expression="sysml_state_ledIndex = sysml_conditional_4" />
            <Expression Expression="sysml_state_pressedQualified = false" />
          </If>
          <Expression Expression="sysml_lazy_5 = sysml_state_pressedQualified" />
          <If Condition="sysml_lazy_5">
            <Expression Expression="sysml_lazy_5 = sysml_state_previousPressed" />
          </If>
          <If Condition="sysml_lazy_5">
            <Expression Expression="sysml_state_pressedQualified = false" />
          </If>
          <Expression Expression="sysml_state_previousPressed = io_0" />
          <LocalVariable Name="sysml_value_0" Type="double" />
          <Expression Expression="sysml_lazy_6 = sysml_state_ledIndex == 1" />
          <If Condition="!sysml_lazy_6">
            <Expression Expression="sysml_lazy_6 = sysml_state_ledIndex == 3" />
          </If>
          <Expression Expression="sysml_lazy_7 = sysml_lazy_6" />
          <If Condition="!sysml_lazy_7">
            <Expression Expression="sysml_lazy_7 = sysml_state_ledIndex == 5" />
          </If>
          <Expression Expression="sysml_lazy_8 = sysml_lazy_7" />
          <If Condition="!sysml_lazy_8">
            <Expression Expression="sysml_lazy_8 = sysml_state_ledIndex == 6" />
          </If>
          <If Condition="sysml_lazy_8">
            <Expression Expression="sysml_conditional_9 = 255.0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_9 = 0.0" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_9" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <Expression Expression="sysml_lazy_10 = sysml_state_ledIndex == 1" />
          <If Condition="!sysml_lazy_10">
            <Expression Expression="sysml_lazy_10 = sysml_state_ledIndex == 3" />
          </If>
          <Expression Expression="sysml_lazy_11 = sysml_lazy_10" />
          <If Condition="!sysml_lazy_11">
            <Expression Expression="sysml_lazy_11 = sysml_state_ledIndex == 4" />
          </If>
          <Expression Expression="sysml_lazy_12 = sysml_lazy_11" />
          <If Condition="!sysml_lazy_12">
            <Expression Expression="sysml_lazy_12 = sysml_state_ledIndex == 6" />
          </If>
          <If Condition="sysml_lazy_12">
            <Expression Expression="sysml_conditional_13 = 255.0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_13 = 0.0" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_13" />
          <LocalVariable Name="sysml_value_2" Type="double" />
          <Expression Expression="sysml_lazy_14 = sysml_state_ledIndex == 2" />
          <If Condition="!sysml_lazy_14">
            <Expression Expression="sysml_lazy_14 = sysml_state_ledIndex == 4" />
          </If>
          <Expression Expression="sysml_lazy_15 = sysml_lazy_14" />
          <If Condition="!sysml_lazy_15">
            <Expression Expression="sysml_lazy_15 = sysml_state_ledIndex == 5" />
          </If>
          <Expression Expression="sysml_lazy_16 = sysml_lazy_15" />
          <If Condition="!sysml_lazy_16">
            <Expression Expression="sysml_lazy_16 = sysml_state_ledIndex == 6" />
          </If>
          <If Condition="sysml_lazy_16">
            <Expression Expression="sysml_conditional_17 = 255.0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_17 = 0.0" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_17" />
          <Expression Expression="*io_1 = sysml_value_0" />
          <Expression Expression="*io_2 = sysml_value_1" />
          <Expression Expression="*io_3 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>