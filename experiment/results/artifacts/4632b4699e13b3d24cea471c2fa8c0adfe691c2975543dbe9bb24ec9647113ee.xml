<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_lastValidDistanceCm = 0.0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_lastValidDistanceCm" Type="double" DefaultValue="0.0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="double" />
      <Input Name="io_1" Type="bool" />
      <Output Name="io_2" Type="int" />
      <Output Name="io_3" Type="bool" />
      <Output Name="io_4" Type="int" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="double" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Output Name="io_2" Type="int" />
          <Output Name="io_3" Type="bool" />
          <Output Name="io_4" Type="int" />
          <LocalVariable Name="sysml_conditional_0" Type="int" />
          <LocalVariable Name="sysml_conditional_1" Type="int" />
          <LocalVariable Name="sysml_conditional_2" Type="int" />
          <If Condition="io_1">
            <Expression Expression="sysml_state_lastValidDistanceCm = io_0" />
          </If>
          <LocalVariable Name="sysml_value_0" Type="int" />
          <If Condition="sysml_state_lastValidDistanceCm &lt; ((double) ((int) sysml_state_lastValidDistanceCm))">
            <Expression Expression="sysml_conditional_0 = 1" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_0 = 0" />
          </Else>
          <Expression Expression="sysml_value_0 = ((int) sysml_state_lastValidDistanceCm) - sysml_conditional_0" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <Expression Expression="sysml_value_1 = (sysml_state_lastValidDistanceCm &lt; 30.0)" />
          <LocalVariable Name="sysml_value_2" Type="int" />
          <If Condition="sysml_state_lastValidDistanceCm &lt; 8.0">
            <Expression Expression="sysml_conditional_1 = 220" />
          </If>
          <Else>
            <If Condition="sysml_state_lastValidDistanceCm &lt; 15.0">
              <Expression Expression="sysml_conditional_2 = 140" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_2 = 0" />
            </Else>
            <Expression Expression="sysml_conditional_1 = sysml_conditional_2" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_1" />
          <Expression Expression="*io_2 = sysml_value_0" />
          <Expression Expression="*io_3 = sysml_value_1" />
          <Expression Expression="*io_4 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>