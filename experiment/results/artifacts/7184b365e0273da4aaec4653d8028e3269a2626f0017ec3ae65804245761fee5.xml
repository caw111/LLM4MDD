<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_prevAngle = 0.0" />
          <Expression Expression="sysml_state_holdMsCounter = 0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_prevAngle" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_holdMsCounter" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_2" Type="double" />
      <Output Name="io_0" Type="bool" />
      <Output Name="io_1" Type="bool" />
      <Output Name="io_3" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_2" Type="double" Source="io_2" />
          <Output Name="io_0" Type="bool" />
          <Output Name="io_1" Type="bool" />
          <Output Name="io_3" Type="double" />
          <LocalVariable Name="sysml_conditional_0" Type="double" />
          <LocalVariable Name="sysml_conditional_1" Type="double" />
          <LocalVariable Name="sysml_conditional_2" Type="double" />
          <LocalVariable Name="sysml_conditional_3" Type="double" />
          <LocalVariable Name="sysml_conditional_4" Type="double" />
          <LocalVariable Name="sysml_conditional_5" Type="double" />
          <LocalVariable Name="sysml_conditional_6" Type="double" />
          <LocalVariable Name="sysml_conditional_7" Type="double" />
          <Expression Expression="sysml_state_holdMsCounter = 0" />
          <If Condition="io_2 &gt;= 0.0">
            <If Condition="io_2 &lt;= 1023.0">
              <Expression Expression="sysml_conditional_1 = ((double) (io_2 * 180.0)) / 1023.0" />
            </If>
            <Else>
              <If Condition="io_2 &gt; 1023.0">
                <Expression Expression="sysml_conditional_2 = 180.0" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_2 = 0.0" />
              </Else>
              <Expression Expression="sysml_conditional_1 = sysml_conditional_2" />
            </Else>
            <Expression Expression="sysml_conditional_0 = sysml_conditional_1" />
          </If>
          <Else>
            <If Condition="io_2 &lt; 0.0">
              <Expression Expression="sysml_conditional_3 = 0.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_3 = ((double) (io_2 * 180.0)) / 1023.0" />
            </Else>
            <Expression Expression="sysml_conditional_0 = sysml_conditional_3" />
          </Else>
          <Expression Expression="sysml_state_prevAngle = sysml_conditional_0" />
          <LocalVariable Name="sysml_value_0" Type="double" />
          <If Condition="io_2 &gt;= 0.0">
            <If Condition="io_2 &lt;= 1023.0">
              <Expression Expression="sysml_conditional_5 = ((double) (io_2 * 180.0)) / 1023.0" />
            </If>
            <Else>
              <If Condition="io_2 &gt; 1023.0">
                <Expression Expression="sysml_conditional_6 = 180.0" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_6 = 0.0" />
              </Else>
              <Expression Expression="sysml_conditional_5 = sysml_conditional_6" />
            </Else>
            <Expression Expression="sysml_conditional_4 = sysml_conditional_5" />
          </If>
          <Else>
            <If Condition="io_2 &lt; 0.0">
              <Expression Expression="sysml_conditional_7 = 0.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_7 = ((double) (io_2 * 180.0)) / 1023.0" />
            </Else>
            <Expression Expression="sysml_conditional_4 = sysml_conditional_7" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_4" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <Expression Expression="sysml_value_1 = false" />
          <LocalVariable Name="sysml_value_2" Type="bool" />
          <Expression Expression="sysml_value_2 = false" />
          <Expression Expression="*io_0 = sysml_value_1" />
          <Expression Expression="*io_1 = sysml_value_2" />
          <Expression Expression="*io_3 = sysml_value_0" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>