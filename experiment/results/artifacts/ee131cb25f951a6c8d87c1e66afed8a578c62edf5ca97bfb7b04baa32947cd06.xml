<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_servoAngle = 90.0" />
          <Expression Expression="sysml_state_ledOn = false" />
          <Expression Expression="sysml_state_previousBtn1 = true" />
          <Expression Expression="sysml_state_previousBtn2 = true" />
          <Expression Expression="sysml_state_moving = false" />
          <Expression Expression="sysml_state_remainingMoveMs = 0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_servoAngle" Type="double" DefaultValue="90.0" />
    <GlobalVariable Name="sysml_state_ledOn" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_previousBtn1" Type="bool" DefaultValue="true" />
    <GlobalVariable Name="sysml_state_previousBtn2" Type="bool" DefaultValue="true" />
    <GlobalVariable Name="sysml_state_moving" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_remainingMoveMs" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_1" Type="bool" />
      <Output Name="io_2" Type="double" />
      <Output Name="io_3" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Output Name="io_2" Type="double" />
          <Output Name="io_3" Type="bool" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_conditional_4" Type="double" />
          <LocalVariable Name="sysml_lazy_5" Type="bool" />
          <LocalVariable Name="sysml_lazy_6" Type="bool" />
          <LocalVariable Name="sysml_lazy_7" Type="bool" />
          <LocalVariable Name="sysml_conditional_8" Type="double" />
          <Expression Expression="sysml_lazy_0 = sysml_state_moving" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = sysml_state_remainingMoveMs &lt;= 0" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_moving = false" />
            <Expression Expression="sysml_state_ledOn = false" />
          </If>
          <Expression Expression="sysml_lazy_1 = io_0" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = !sysml_state_previousBtn1" />
          </If>
          <Expression Expression="sysml_lazy_2 = sysml_lazy_1" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = sysml_state_servoAngle &gt;= 0.0" />
          </If>
          <Expression Expression="sysml_lazy_3 = sysml_lazy_2" />
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_lazy_3 = sysml_state_servoAngle &lt; 180.0" />
          </If>
          <If Condition="sysml_lazy_3">
            <If Condition="(sysml_state_servoAngle + 30.0) &gt;= 180.0">
              <Expression Expression="sysml_conditional_4 = 180.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_4 = sysml_state_servoAngle + 30.0" />
            </Else>
            <Expression Expression="sysml_state_servoAngle = sysml_conditional_4" />
            <Expression Expression="sysml_state_moving = true" />
            <Expression Expression="sysml_state_remainingMoveMs = 2000" />
            <Expression Expression="sysml_state_ledOn = true" />
          </If>
          <Expression Expression="sysml_lazy_5 = io_1" />
          <If Condition="sysml_lazy_5">
            <Expression Expression="sysml_lazy_5 = !sysml_state_previousBtn2" />
          </If>
          <Expression Expression="sysml_lazy_6 = sysml_lazy_5" />
          <If Condition="sysml_lazy_6">
            <Expression Expression="sysml_lazy_6 = sysml_state_servoAngle &gt; 0.0" />
          </If>
          <Expression Expression="sysml_lazy_7 = sysml_lazy_6" />
          <If Condition="sysml_lazy_7">
            <Expression Expression="sysml_lazy_7 = sysml_state_servoAngle &lt;= 180.0" />
          </If>
          <If Condition="sysml_lazy_7">
            <If Condition="(sysml_state_servoAngle - 30.0) &lt;= 0.0">
              <Expression Expression="sysml_conditional_8 = 0.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_8 = sysml_state_servoAngle - 30.0" />
            </Else>
            <Expression Expression="sysml_state_servoAngle = sysml_conditional_8" />
            <Expression Expression="sysml_state_moving = true" />
            <Expression Expression="sysml_state_remainingMoveMs = 2000" />
            <Expression Expression="sysml_state_ledOn = true" />
          </If>
          <Expression Expression="sysml_state_previousBtn1 = io_0" />
          <Expression Expression="sysml_state_previousBtn2 = io_1" />
          <LocalVariable Name="sysml_value_0" Type="double" />
          <Expression Expression="sysml_value_0 = sysml_state_servoAngle" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <Expression Expression="sysml_value_1 = sysml_state_ledOn" />
          <Expression Expression="*io_2 = sysml_value_0" />
          <Expression Expression="*io_3 = sysml_value_1" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>