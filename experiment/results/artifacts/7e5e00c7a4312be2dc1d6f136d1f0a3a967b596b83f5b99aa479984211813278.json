      "meaning": "DHT11 measurement validity (true when latest frame read is valid)",
      "sample_period_ms": 2000,
      "device": "dht_valid",
      "hardware": "{\"invalid_policy\": \"hold_last_valid\", \"kind\": \"dht_valid\", \"pin\": \"D7\", \"sensor\": \"DHT11\"}",
      "binding": {
        "kind": "dht_valid",
        "invalid_policy": "hold_last_valid",
        "pin": "D7",
        "sensor": "DHT11"
      }
    },
    {
