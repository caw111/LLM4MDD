{
  "version": 1,
  "board": "arduino:avr:uno",
  "control_period_ms": 10,
  "planning_notes": [
    "Board is Arduino UNO; use D13 for the LED output, D7 for DHT11 data, and HC-SR04 with Trig=D8 and Echo=D9 exactly as provided.",
    "A control period of 10ms is chosen as scheduling granularity; the 3-second polling cadence and the '3 consecutive distances < 20cm' persistence are implemented in the SysML model using elapsed_ms.",
    "Serial protocol for periodic polling is assumed to be numeric (temperature and distance) plus the consecutive counter; exact formatting/tokenization is left to the model. If a fixed text line is required instead, replace the second serial channel with serial_text_output using the exact message text in the requirement.",
    "Ultrasonic timeout_us is set to 30000 (within 25000..60000) to satisfy the catalog constraint and provide reasonable range; out-of-range/timeout is treated as invalid and retains last distance with ultrasonic_valid controlling SysML handling.",
    "No explicit initial DHT temperature/humidity measurement is specified; initial numeric values are set to 0 and validity starts false until the first valid acquisition."
  ],
  "interfaces": [
    {
      "name": "io_0",
      "direction": "output",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "LED status: continuous-distance-detected condition",
      "sample_period_ms": 10,
      "device": "digital_output",
      "hardware": "{\"active_high\": true, \"kind\": \"digital_output\", \"pin\": \"D13\"}",
      "binding": {
        "kind": "digital_output",
        "active_high": true,
        "pin": "D13"
      },
      "model_semantics": {
        "kind": "digital_boolean",
        "true_level": "HIGH",
        "false_level": "LOW"
      }
    },
    {
      "name": "io_1",
      "direction": "input",
      "type": "f64",
      "unit": "degC",
      "initial": 0,
      "meaning": "Measured temperature (for 3s poll reports)",
      "sample_period_ms": 2000,
      "device": "dht_temperature",
      "hardware": "{\"invalid_policy\": \"hold_last_valid\", \"kind\": \"dht_temperature\", \"pin\": \"D7\", \"sensor\": \"DHT11\"}",
      "binding": {
        "kind": "dht_temperature",
        "invalid_policy": "hold_last_valid",
        "pin": "D7",
        "sensor": "DHT11"
      }
    },
    {
      "name": "io_2",
      "direction": "input",
      "type": "f64",
      "unit": "%RH",
      "initial": 0,
      "meaning": "Measured humidity (for 3s poll reports)",
