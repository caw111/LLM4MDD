      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "Ultrasonic measurement validity (true when latest ping is within timeout)",
      "sample_period_ms": 60,
      "device": "ultrasonic_valid",
      "hardware": "{\"echo_pin\": \"D9\", \"invalid_policy\": \"hold_last_valid\", \"kind\": \"ultrasonic_valid\", \"sensor\": \"HC-SR04\", \"timeout_us\": 30000, \"trigger_pin\": \"D8\"}",
      "binding": {
