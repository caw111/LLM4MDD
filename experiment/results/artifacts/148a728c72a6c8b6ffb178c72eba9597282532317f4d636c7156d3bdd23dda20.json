{
  "version": 1,
  "board": "arduino:avr:uno",
  "control_period_ms": 10,
  "planning_notes": [
    "Board is Arduino Uno. Wiring preserved exactly as: DHT11 on D7 (temperature only), potentiometer threshold on A0, TM1637 CLK=D4 and DIO=D5, buzzer on D6, LED on D13.",
    "TM1637 is represented as a single tm1637_number interface; the SysML model decides how to present current temperature vs threshold on the display.",
    "Buzzer periodic alarm behavior (tone/duty/timing) is handled in the SysML model using elapsed_ms; this request only provides a tone output channel.",
    "DHT acquisition and invalid handling: temperature and validity are acquired coherently from the same D7 pin; invalid reads retain last valid temperature and force validity false in the model."
  ],
  "interfaces": [
    {
      "name": "io_0",
      "direction": "input",
      "type": "f64",
      "unit": "adc_count",
      "initial": 0,
      "meaning": "Temperature alarm threshold setpoint from potentiometer",
      "sample_period_ms": 10,
      "device": "analog_input",
      "hardware": "{\"kind\": \"analog_input\", \"offset\": 0.0, \"pin\": \"A0\", \"scale\": 1.0}",
      "binding": {
        "kind": "analog_input",
        "scale": 1.0,
        "offset": 0.0,
        "pin": "A0"
      }
    },
    {
      "name": "io_1",
      "direction": "output",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "Over-temperature alarm LED (constant on when alarm active)",
      "sample_period_ms": 10,
      "device": "digital_output",
      "hardware": "{\"active_high\": true, \"kind\": \"digital_output\", \"pin\": \"D13\"}",
      "binding": {
        "kind": "digital_output",
        "active_high": true,
        "pin": "D13"
      },
      "model_semantics": {
        "kind": "digital_boolean",
        "true_level": "HIGH",
        "false_level": "LOW"
      }
    },
    {
      "name": "io_2",
      "direction": "output",
      "type": "i32",
      "unit": "Hz",
      "initial": 0,
      "meaning": "Buzzer periodic alarm tone output",
      "sample_period_ms": 10,
      "device": "tone_output",
      "hardware": "{\"invalid_policy\": \"silence\", \"kind\": \"tone_output\", \"pin\": \"D6\"}",
      "binding": {
        "kind": "tone_output",
        "invalid_policy": "silence",
        "pin": "D6"
      }
    },
    {
      "name": "io_3",
      "direction": "input",
      "type": "f64",
      "unit": "degC",
      "initial": 0,
      "meaning": "Current temperature reading from DHT11",
      "sample_period_ms": 2000,
      "device": "dht_temperature",
      "hardware": "{\"invalid_policy\": \"hold_last_valid\", \"kind\": \"dht_temperature\", \"pin\": \"D7\", \"sensor\": \"DHT11\"}",
      "binding": {
        "kind": "dht_temperature",
        "invalid_policy": "hold_last_valid",
        "sensor": "DHT11",
        "pin": "D7"
      }
    },
    {
      "name": "io_4",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "Validity of current DHT11 temperature reading",
      "sample_period_ms": 2000,
      "device": "dht_valid",
      "hardware": "{\"invalid_policy\": \"hold_last_valid\", \"kind\": \"dht_valid\", \"pin\": \"D7\", \"sensor\": \"DHT11\"}",
      "binding": {
        "kind": "dht_valid",
        "invalid_policy": "hold_last_valid",
        "sensor": "DHT11",
        "pin": "D7"
      }
    },
    {
      "name": "io_5",
      "direction": "output",
      "type": "i32",
      "unit": "1",
      "initial": 0,
      "meaning": "TM1637 display: current temperature and configured alarm threshold",
      "sample_period_ms": 10,
      "device": "tm1637_number",
      "hardware": "{\"brightness\": 7, \"clk_pin\": \"D4\", \"dio_pin\": \"D5\", \"invalid_policy\": \"blank\", \"kind\": \"tm1637_number\", \"leading_zero\": false}",
      "binding": {
        "kind": "tm1637_number",
        "brightness": 7,
        "leading_zero": false,
        "invalid_policy": "blank",
        "clk_pin": "D4",
        "dio_pin": "D5"
      }
    }
  ],
