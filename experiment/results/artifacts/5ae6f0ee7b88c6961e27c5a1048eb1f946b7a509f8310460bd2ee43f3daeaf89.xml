            <Expression Expression="sysml_state_pressedDurationS = 0.0" />
          </If>
          <Expression Expression="sysml_lazy_2 = sysml_state_running" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = io_0" />
          </If>
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_state_pressedDurationS = 0.0" />
          </If>
          <Expression Expression="sysml_state_previousPressed = io_0" />
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <Expression Expression="sysml_lazy_3 = !sysml_state_running" />
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_lazy_3 = sysml_state_previousPressed" />
          </If>
          <Expression Expression="sysml_value_0 = sysml_lazy_3" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <Expression Expression="sysml_value_1 = sysml_state_pressedDurationS" />
          <Expression Expression="*serial_0_trigger = sysml_value_0" />
          <Expression Expression="*serial_0_value_0 = sysml_value_1" />
