<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_phase_ms = 0" />
          <Expression Expression="sysml_state_led1 = false" />
          <Expression Expression="sysml_state_led2 = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_phase_ms" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_led1" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_led2" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_2" Type="int" />
      <Output Name="io_0" Type="bool" />
      <Output Name="io_1" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_2" Type="int" Source="io_2" />
          <Output Name="io_0" Type="bool" />
          <Output Name="io_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <Expression Expression="sysml_state_phase_ms = (sysml_state_phase_ms + io_2)" />
          <If Condition="(sysml_state_phase_ms &gt;= 15000)">
            <Expression Expression="sysml_state_phase_ms = (sysml_state_phase_ms - 15000)" />
          </If>
          <If Condition="(sysml_state_phase_ms &gt;= 15000)">
            <Expression Expression="sysml_state_phase_ms = (sysml_state_phase_ms - 15000)" />
          </If>
          <If Condition="(sysml_state_phase_ms &lt; 5000)">
            <Expression Expression="sysml_state_led1 = false" />
            <Expression Expression="sysml_state_led2 = false" />
          </If>
          <Expression Expression="sysml_lazy_0 = sysml_state_phase_ms &gt;= 5000" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = sysml_state_phase_ms &lt; 10000" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_led1 = true" />
            <Expression Expression="sysml_state_led2 = false" />
          </If>
          <Expression Expression="sysml_lazy_1 = sysml_state_phase_ms &gt;= 10000" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = sysml_state_phase_ms &lt; 15000" />
          </If>
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_state_led1 = false" />
            <Expression Expression="sysml_state_led2 = false" />
          </If>
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <Expression Expression="sysml_value_0 = sysml_state_led1" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <Expression Expression="sysml_value_1 = sysml_state_led2" />
          <Expression Expression="*io_0 = sysml_value_0" />
          <Expression Expression="*io_1 = sysml_value_1" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>