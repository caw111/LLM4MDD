<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_maxTempDegC = 0.0" />
          <Expression Expression="sysml_state_showMaxActive = false" />
          <Expression Expression="sysml_state_showMaxRemainingMs = 0" />
          <Expression Expression="sysml_state_previousButtonPressed = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_maxTempDegC" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_showMaxActive" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_showMaxRemainingMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_previousButtonPressed" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="double" />
      <Input Name="io_1" Type="bool" />
      <Output Name="io_2" Type="int" />
      <Output Name="serial_0_trigger" Type="bool" />
      <Output Name="serial_0_value_0" Type="double" />
      <Output Name="serial_0_value_1" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="double" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Output Name="io_2" Type="int" />
          <Output Name="serial_0_trigger" Type="bool" />
          <Output Name="serial_0_value_0" Type="double" />
          <Output Name="serial_0_value_1" Type="double" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="int" />
          <LocalVariable Name="sysml_conditional_2" Type="int" />
          <LocalVariable Name="sysml_conditional_3" Type="int" />
          <LocalVariable Name="sysml_conditional_4" Type="int" />
          <LocalVariable Name="sysml_conditional_5" Type="double" />
          <Expression Expression="sysml_lazy_0 = io_1" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_previousButtonPressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_showMaxActive = true" />
            <Expression Expression="sysml_state_showMaxRemainingMs = 3000" />
          </If>
          <If Condition="sysml_state_showMaxActive">
            <If Condition="sysml_state_showMaxRemainingMs &lt;= 0">
              <Expression Expression="sysml_conditional_1 = 0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_1 = sysml_state_showMaxRemainingMs" />
            </Else>
            <Expression Expression="sysml_state_showMaxRemainingMs = sysml_conditional_1" />
            <If Condition="(sysml_state_showMaxRemainingMs &lt;= 0)">
              <Expression Expression="sysml_state_showMaxActive = false" />
            </If>
          </If>
          <Expression Expression="sysml_state_previousButtonPressed = io_1" />
          <If Condition="(io_0 &gt; sysml_state_maxTempDegC)">
            <Expression Expression="sysml_state_maxTempDegC = io_0" />
          </If>
          <LocalVariable Name="sysml_value_0" Type="int" />
          <If Condition="sysml_state_showMaxActive">
            <If Condition="sysml_state_maxTempDegC &lt; ((double) ((int) sysml_state_maxTempDegC))">
              <Expression Expression="sysml_conditional_3 = 1" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_3 = 0" />
            </Else>
            <Expression Expression="sysml_conditional_2 = ((int) sysml_state_maxTempDegC) - sysml_conditional_3" />
          </If>
          <Else>
            <If Condition="io_0 &lt; ((double) ((int) io_0))">
              <Expression Expression="sysml_conditional_4 = 1" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_4 = 0" />
            </Else>
            <Expression Expression="sysml_conditional_2 = ((int) io_0) - sysml_conditional_4" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_2" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <Expression Expression="sysml_value_1 = true" />
          <LocalVariable Name="sysml_value_2" Type="double" />
          <If Condition="sysml_state_showMaxActive">
            <Expression Expression="sysml_conditional_5 = io_0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_5 = io_0" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_5" />
          <LocalVariable Name="sysml_value_3" Type="double" />
          <Expression Expression="sysml_value_3 = sysml_state_maxTempDegC" />
          <Expression Expression="*io_2 = sysml_value_0" />
          <Expression Expression="*serial_0_trigger = sysml_value_1" />
          <Expression Expression="*serial_0_value_0 = sysml_value_2" />
          <Expression Expression="*serial_0_value_1 = sysml_value_3" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>