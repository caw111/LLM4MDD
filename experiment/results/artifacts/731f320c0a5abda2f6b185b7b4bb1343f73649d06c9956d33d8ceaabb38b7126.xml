<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_mode = 0" />
          <Expression Expression="sysml_state_servo1Angle = 0.0" />
          <Expression Expression="sysml_state_servo2Angle = 0.0" />
          <Expression Expression="sysml_state_ledOn = false" />
          <Expression Expression="sysml_state_previousBtn1 = false" />
          <Expression Expression="sysml_state_previousBtn2 = false" />
          <Expression Expression="sysml_state_btn1Latch = false" />
          <Expression Expression="sysml_state_btn2Latch = false" />
          <Expression Expression="sysml_state_maintainUntilMs = 0" />
          <Expression Expression="sysml_state_flashAccumulatedMs = 0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_mode" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_servo1Angle" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_servo2Angle" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_ledOn" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_previousBtn1" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_previousBtn2" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_btn1Latch" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_btn2Latch" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_maintainUntilMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_flashAccumulatedMs" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_3" Type="bool" />
      <Input Name="io_4" Type="bool" />
      <Input Name="io_5" Type="int" />
      <Output Name="io_0" Type="double" />
      <Output Name="io_1" Type="double" />
      <Output Name="io_2" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_3" Type="bool" Source="io_3" />
          <Input Name="io_4" Type="bool" Source="io_4" />
          <Input Name="io_5" Type="int" Source="io_5" />
          <Output Name="io_0" Type="double" />
          <Output Name="io_1" Type="double" />
          <Output Name="io_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_lazy_4" Type="bool" />
          <LocalVariable Name="sysml_conditional_5" Type="int" />
          <LocalVariable Name="sysml_lazy_6" Type="bool" />
          <LocalVariable Name="sysml_lazy_7" Type="bool" />
          <LocalVariable Name="sysml_conditional_8" Type="bool" />
          <LocalVariable Name="sysml_lazy_9" Type="bool" />
          <LocalVariable Name="sysml_lazy_10" Type="bool" />
          <LocalVariable Name="sysml_lazy_11" Type="bool" />
          <LocalVariable Name="sysml_lazy_12" Type="bool" />
          <LocalVariable Name="sysml_lazy_13" Type="bool" />
          <Expression Expression="sysml_lazy_0 = sysml_state_btn1Latch" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_btn2Latch" />
          </If>
          <Expression Expression="sysml_lazy_1 = sysml_lazy_0" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_2 = sysml_state_btn2Latch" />
            <If Condition="sysml_lazy_2">
              <Expression Expression="sysml_lazy_2 = !sysml_state_btn1Latch" />
            </If>
            <Expression Expression="sysml_lazy_1 = !sysml_lazy_2" />
          </If>
          <If Condition="sysml_lazy_1">
            <If Condition="(sysml_state_maintainUntilMs &lt;= 0)">
              <Expression Expression="sysml_state_mode = 1" />
              <Expression Expression="sysml_state_servo1Angle = 90.0" />
              <Expression Expression="sysml_state_servo2Angle = 0.0" />
              <Expression Expression="sysml_state_ledOn = true" />
            </If>
          </If>
          <Expression Expression="sysml_lazy_3 = sysml_state_btn2Latch" />
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_lazy_3 = !sysml_state_btn1Latch" />
          </If>
          <If Condition="sysml_lazy_3">
            <If Condition="(sysml_state_maintainUntilMs &lt;= 0)">
              <Expression Expression="sysml_state_mode = 1" />
              <Expression Expression="sysml_state_servo1Angle = 0.0" />
              <Expression Expression="sysml_state_servo2Angle = 180.0" />
              <Expression Expression="sysml_state_ledOn = false" />
            </If>
          </If>
          <Expression Expression="sysml_lazy_4 = sysml_state_btn1Latch" />
          <If Condition="sysml_lazy_4">
            <Expression Expression="sysml_lazy_4 = sysml_state_btn2Latch" />
          </If>
          <If Condition="sysml_lazy_4">
            <If Condition="(sysml_state_maintainUntilMs &lt;= 0)">
              <Expression Expression="sysml_state_mode = 2" />
              <Expression Expression="sysml_state_servo1Angle = 0.0" />
              <Expression Expression="sysml_state_servo2Angle = 0.0" />
            </If>
          </If>
          <If Condition="sysml_state_maintainUntilMs &gt; 0">
            <Expression Expression="sysml_conditional_5 = sysml_state_maintainUntilMs - io_5" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_5 = 0" />
          </Else>
          <Expression Expression="sysml_state_maintainUntilMs = sysml_conditional_5" />
          <If Condition="(sysml_state_mode == 0)">
            <Expression Expression="sysml_state_servo1Angle = 0.0" />
            <Expression Expression="sysml_state_servo2Angle = 0.0" />
            <Expression Expression="sysml_state_ledOn = false" />
            <Expression Expression="sysml_state_flashAccumulatedMs = 0" />
          </If>
          <If Condition="(sysml_state_mode == 1)">
            <Expression Expression="sysml_lazy_6 = sysml_state_btn1Latch" />
            <If Condition="sysml_lazy_6">
              <Expression Expression="sysml_lazy_6 = !sysml_state_btn2Latch" />
            </If>
            <If Condition="sysml_lazy_6">
              <Expression Expression="sysml_state_servo1Angle = 90.0" />
              <Expression Expression="sysml_state_servo2Angle = 0.0" />
              <Expression Expression="sysml_state_ledOn = true" />
            </If>
            <Else>
              <Expression Expression="sysml_lazy_7 = sysml_state_btn2Latch" />
              <If Condition="sysml_lazy_7">
                <Expression Expression="sysml_lazy_7 = !sysml_state_btn1Latch" />
              </If>
              <If Condition="sysml_lazy_7">
                <Expression Expression="sysml_state_servo1Angle = 0.0" />
                <Expression Expression="sysml_state_servo2Angle = 180.0" />
                <Expression Expression="sysml_state_ledOn = false" />
              </If>
              <Else>
                <Expression Expression="sysml_state_servo1Angle = 0.0" />
                <Expression Expression="sysml_state_servo2Angle = 0.0" />
                <Expression Expression="sysml_state_ledOn = false" />
              </Else>
            </Else>
          </If>
          <If Condition="(sysml_state_mode == 2)">
            <Expression Expression="sysml_state_servo1Angle = 0.0" />
            <Expression Expression="sysml_state_servo2Angle = 0.0" />
            <Expression Expression="sysml_state_flashAccumulatedMs = (sysml_state_flashAccumulatedMs + io_5)" />
            <If Condition="(sysml_state_flashAccumulatedMs &gt;= 4000)">
              <Expression Expression="sysml_state_flashAccumulatedMs = (sysml_state_flashAccumulatedMs - 4000)" />
            </If>
            <If Condition="sysml_state_flashAccumulatedMs &lt; 2000">
              <Expression Expression="sysml_conditional_8 = true" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_8 = false" />
            </Else>
            <Expression Expression="sysml_state_ledOn = sysml_conditional_8" />
          </If>
          <Expression Expression="sysml_lazy_9 = io_3" />
          <If Condition="sysml_lazy_9">
            <Expression Expression="sysml_lazy_9 = !sysml_state_previousBtn1" />
          </If>
          <If Condition="sysml_lazy_9">
            <If Condition="io_4">
              <Expression Expression="sysml_state_btn1Latch = true" />
              <Expression Expression="sysml_state_btn2Latch = true" />
              <Expression Expression="sysml_state_mode = 2" />
              <Expression Expression="sysml_state_servo1Angle = 0.0" />
              <Expression Expression="sysml_state_servo2Angle = 0.0" />
              <Expression Expression="sysml_state_ledOn = true" />
              <Expression Expression="sysml_state_flashAccumulatedMs = 0" />
              <Expression Expression="sysml_state_maintainUntilMs = 2000" />
            </If>
            <Else>
              <Expression Expression="sysml_state_btn1Latch = true" />
              <Expression Expression="sysml_state_mode = 1" />
              <Expression Expression="sysml_state_servo1Angle = 90.0" />
              <Expression Expression="sysml_state_servo2Angle = 0.0" />
              <Expression Expression="sysml_state_ledOn = true" />
              <Expression Expression="sysml_state_flashAccumulatedMs = 0" />
              <Expression Expression="sysml_state_maintainUntilMs = 2000" />
            </Else>
          </If>
          <Expression Expression="sysml_lazy_10 = io_4" />
          <If Condition="sysml_lazy_10">
            <Expression Expression="sysml_lazy_10 = !sysml_state_previousBtn2" />
          </If>
          <If Condition="sysml_lazy_10">
            <If Condition="io_3">
              <Expression Expression="sysml_state_btn1Latch = true" />
              <Expression Expression="sysml_state_btn2Latch = true" />
              <Expression Expression="sysml_state_mode = 2" />
              <Expression Expression="sysml_state_servo1Angle = 0.0" />
              <Expression Expression="sysml_state_servo2Angle = 0.0" />
              <Expression Expression="sysml_state_ledOn = true" />
              <Expression Expression="sysml_state_flashAccumulatedMs = 0" />
              <Expression Expression="sysml_state_maintainUntilMs = 2000" />
            </If>
            <Else>
              <Expression Expression="sysml_state_btn2Latch = true" />
              <Expression Expression="sysml_state_mode = 1" />
              <Expression Expression="sysml_state_servo1Angle = 0.0" />
              <Expression Expression="sysml_state_servo2Angle = 180.0" />
              <Expression Expression="sysml_state_ledOn = false" />
              <Expression Expression="sysml_state_flashAccumulatedMs = 0" />
              <Expression Expression="sysml_state_maintainUntilMs = 2000" />
            </Else>
          </If>
          <If Condition="(sysml_state_maintainUntilMs &lt;= 0)">
            <Expression Expression="sysml_lazy_11 = sysml_state_btn1Latch" />
            <If Condition="sysml_lazy_11">
              <Expression Expression="sysml_lazy_11 = sysml_state_btn2Latch" />
            </If>
            <If Condition="sysml_lazy_11">
              <Expression Expression="sysml_state_mode = 2" />
              <Expression Expression="sysml_state_servo1Angle = 0.0" />
              <Expression Expression="sysml_state_servo2Angle = 0.0" />
            </If>
            <Else>
              <Expression Expression="sysml_lazy_12 = sysml_state_btn1Latch" />
              <If Condition="sysml_lazy_12">
                <Expression Expression="sysml_lazy_12 = !sysml_state_btn2Latch" />
              </If>
              <If Condition="sysml_lazy_12">
                <Expression Expression="sysml_state_mode = 1" />
                <Expression Expression="sysml_state_servo1Angle = 90.0" />
                <Expression Expression="sysml_state_servo2Angle = 0.0" />
                <Expression Expression="sysml_state_ledOn = true" />
              </If>
              <Else>
                <Expression Expression="sysml_lazy_13 = sysml_state_btn2Latch" />
                <If Condition="sysml_lazy_13">
                  <Expression Expression="sysml_lazy_13 = !sysml_state_btn1Latch" />
                </If>
                <If Condition="sysml_lazy_13">
                  <Expression Expression="sysml_state_mode = 1" />
                  <Expression Expression="sysml_state_servo1Angle = 0.0" />
                  <Expression Expression="sysml_state_servo2Angle = 180.0" />
                  <Expression Expression="sysml_state_ledOn = false" />
                </If>
                <Else>
                  <Expression Expression="sysml_state_mode = 0" />
                  <Expression Expression="sysml_state_servo1Angle = 0.0" />
                  <Expression Expression="sysml_state_servo2Angle = 0.0" />
                  <Expression Expression="sysml_state_ledOn = false" />
                  <Expression Expression="sysml_state_flashAccumulatedMs = 0" />
                </Else>
              </Else>
            </Else>
          </If>
          <Expression Expression="sysml_state_previousBtn1 = io_3" />
          <Expression Expression="sysml_state_previousBtn2 = io_4" />
          <LocalVariable Name="sysml_value_0" Type="double" />
          <Expression Expression="sysml_value_0 = sysml_state_servo1Angle" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <Expression Expression="sysml_value_1 = sysml_state_servo2Angle" />
          <LocalVariable Name="sysml_value_2" Type="bool" />
          <Expression Expression="sysml_value_2 = sysml_state_ledOn" />
          <Expression Expression="*io_0 = sysml_value_0" />
          <Expression Expression="*io_1 = sysml_value_1" />
          <Expression Expression="*io_2 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>