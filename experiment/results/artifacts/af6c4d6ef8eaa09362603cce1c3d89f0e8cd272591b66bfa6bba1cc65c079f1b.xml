<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_previousPressed = false" />
          <Expression Expression="sysml_state_mode = 0" />
          <Expression Expression="sysml_state_yellowRemainingMs = 0" />
          <Expression Expression="sysml_state_redRemainingMs = 0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_previousPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_mode" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_yellowRemainingMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_redRemainingMs" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Output Name="io_1" Type="bool" />
      <Output Name="io_2" Type="bool" />
      <Output Name="io_3" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Output Name="io_1" Type="bool" />
          <Output Name="io_2" Type="bool" />
          <Output Name="io_3" Type="bool" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_conditional_3" Type="bool" />
          <LocalVariable Name="sysml_conditional_4" Type="bool" />
          <LocalVariable Name="sysml_lazy_5" Type="bool" />
          <LocalVariable Name="sysml_conditional_6" Type="bool" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_previousPressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_mode = 1" />
            <Expression Expression="sysml_state_yellowRemainingMs = 1000" />
            <Expression Expression="sysml_state_redRemainingMs = 2000" />
          </If>
          <Expression Expression="sysml_lazy_1 = sysml_state_mode == 1" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = sysml_state_yellowRemainingMs &gt; 0" />
          </If>
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_state_yellowRemainingMs = 0" />
            <Expression Expression="sysml_state_mode = 2" />
            <Expression Expression="sysml_state_redRemainingMs = 2000" />
          </If>
          <Expression Expression="sysml_lazy_2 = sysml_state_mode == 2" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = sysml_state_redRemainingMs &gt; 0" />
          </If>
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_state_redRemainingMs = 0" />
            <Expression Expression="sysml_state_mode = 3" />
          </If>
          <If Condition="(sysml_state_mode == 3)">
            <Expression Expression="sysml_state_mode = 0" />
          </If>
          <Expression Expression="sysml_state_previousPressed = io_0" />
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <If Condition="sysml_state_mode == 2">
            <Expression Expression="sysml_conditional_3 = true" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_3 = false" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_3" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <If Condition="sysml_state_mode == 1">
            <Expression Expression="sysml_conditional_4 = true" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_4 = false" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_4" />
          <LocalVariable Name="sysml_value_2" Type="bool" />
          <Expression Expression="sysml_lazy_5 = sysml_state_mode == 1" />
          <If Condition="!sysml_lazy_5">
            <Expression Expression="sysml_lazy_5 = sysml_state_mode == 2" />
          </If>
          <If Condition="!sysml_lazy_5">
            <Expression Expression="sysml_conditional_6 = true" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_6 = false" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_6" />
          <Expression Expression="*io_1 = sysml_value_0" />
          <Expression Expression="*io_2 = sysml_value_1" />
          <Expression Expression="*io_3 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>