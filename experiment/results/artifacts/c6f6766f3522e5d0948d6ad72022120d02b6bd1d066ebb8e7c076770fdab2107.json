      "meaning": "HC-SR04 distance < 20cm -> buzzer alarm (tone active)",
      "sample_period_ms": 5,
      "device": "tone_output",
      "hardware": "{\"invalid_policy\": \"silence\", \"kind\": \"tone_output\", \"pin\": \"D6\"}",
      "binding": {
        "kind": "tone_output",
        "invalid_policy": "silence",
        "pin": "D6"
      }
    },
