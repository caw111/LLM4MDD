{
  "version": 1,
  "board": "arduino:avr:uno",
  "control_period_ms": 5,
  "planning_notes": [
    "Arduino Uno; pins preserved as wired: Trig=D8, Echo=D9; LED=D13; buzzer/tone=D6. No serial requirements were provided.",
    "HC-SR04 distance threshold behavior (< 20cm LED ON, buzzer alarm; otherwise both OFF) is handled in the SysML model using ultrasonic_distance/ultrasonic_valid.",
    "Ultrasonic sample period must be at least 60ms and rounded up to a control-period multiple; chosen 60ms since control_period_ms=5ms.",
    "timeout_us set to 25000 to satisfy supported range; invalid/out-of-range retains previous distance and sets validity false (model decides how to behave when invalid).",
    "tone_output uses initial 0 to keep buzzer silent until SysML enables an alarm tone via updated control logic; exact tone frequency/duration are model responsibilities and not encoded in the device request."
  ],
  "interfaces": [
    {
      "name": "io_0",
      "direction": "output",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "HC-SR04 distance < 20cm -> LED ON",
      "sample_period_ms": 5,
      "device": "digital_output",
      "hardware": "{\"active_high\": true, \"kind\": \"digital_output\", \"pin\": \"D13\"}",
      "binding": {
        "kind": "digital_output",
        "active_high": true,
        "pin": "D13"
      },
      "model_semantics": {
        "kind": "digital_boolean",
        "true_level": "HIGH",
        "false_level": "LOW"
      }
    },
    {
      "name": "io_1",
