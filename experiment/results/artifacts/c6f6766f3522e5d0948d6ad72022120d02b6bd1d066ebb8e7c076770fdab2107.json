      "binding": {
        "kind": "ultrasonic_distance",
        "sensor": "HC-SR04",
        "timeout_us": 25000,
        "invalid_policy": "hold_last_valid",
        "echo_pin": "D9",
        "trigger_pin": "D8"
      }
    },
    {
      "name": "io_3",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "Validity of HC-SR04 distance reading",
      "sample_period_ms": 60,
      "device": "ultrasonic_valid",
      "hardware": "{\"echo_pin\": \"D9\", \"invalid_policy\": \"hold_last_valid\", \"kind\": \"ultrasonic_valid\", \"sensor\": \"HC-SR04\", \"timeout_us\": 25000, \"trigger_pin\": \"D8\"}",
      "binding": {
        "kind": "ultrasonic_valid",
        "sensor": "HC-SR04",
        "timeout_us": 25000,
        "invalid_policy": "hold_last_valid",
        "echo_pin": "D9",
        "trigger_pin": "D8"
      }
    }
