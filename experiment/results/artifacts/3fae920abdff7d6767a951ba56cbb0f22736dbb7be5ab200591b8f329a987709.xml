          <Expression Expression="sysml_state_cycleAccumMs = (sysml_state_cycleAccumMs + io_0)" />
          <Expression Expression="sysml_lazy_0 = sysml_state_cycleAccumMs &gt;= 2000" />
          <If Condition="!sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = sysml_state_elapsedAccumMs &gt;= 2000" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_cycleAccumMs = (sysml_state_cycleAccumMs - 2000)" />
          </If>
          <Expression Expression="sysml_lazy_1 = sysml_state_cycleAccumMs &lt; 200" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = sysml_state_cycleAccumMs &gt;= 0" />
          </If>
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_state_previousBecameActive = true" />
          </If>
          <Else>
            <Expression Expression="sysml_state_previousBecameActive = false" />
          </Else>
          <LocalVariable Name="sysml_value_0" Type="int" />
          <Expression Expression="sysml_lazy_2 = sysml_state_cycleAccumMs &lt; 200" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = sysml_state_cycleAccumMs &gt;= 0" />
          </If>
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_conditional_3 = 31" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_3 = 0" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_3" />
          <Expression Expression="*io_1 = sysml_value_0" />
        </Calculate>
