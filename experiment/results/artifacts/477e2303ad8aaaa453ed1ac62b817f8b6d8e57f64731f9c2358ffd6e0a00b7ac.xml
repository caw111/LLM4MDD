              </If>
              <Else>
                <Expression Expression="sysml_conditional_1 = 0" />
              </Else>
              <Expression Expression="sysml_conditional_0 = ((int) io_1) - sysml_conditional_1" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_0 = 0" />
            </Else>
            <Expression Expression="sysml_state_displayedDistanceIntCm = sysml_conditional_0" />
          </If>
          <Else>
            <Expression Expression="sysml_state_displayedDistanceIntCm = 0" />
          </Else>
