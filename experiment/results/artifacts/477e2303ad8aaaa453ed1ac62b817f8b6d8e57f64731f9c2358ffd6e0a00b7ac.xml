          </If>
          <Expression Expression="sysml_value_0 = sysml_lazy_2" />
          <LocalVariable Name="sysml_value_1" Type="int" />
          <If Condition="io_2">
            <Expression Expression="sysml_conditional_3 = sysml_state_displayedDistanceIntCm" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_3 = 0" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_3" />
          <Expression Expression="*io_0 = sysml_value_0" />
          <Expression Expression="*io_3 = sysml_value_1" />
