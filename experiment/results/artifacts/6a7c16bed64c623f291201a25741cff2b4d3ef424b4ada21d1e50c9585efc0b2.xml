<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_alarmActive = false" />
          <Expression Expression="sysml_state_ledState = false" />
          <Expression Expression="sysml_state_beepState = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_alarmActive" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_ledState" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_beepState" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="double" />
      <Input Name="io_1" Type="double" />
      <Input Name="io_2" Type="bool" />
      <Output Name="io_3" Type="bool" />
      <Output Name="io_4" Type="int" />
      <Output Name="serial_0_trigger" Type="bool" />
      <Output Name="serial_0_value_0" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="double" Source="io_0" />
          <Input Name="io_1" Type="double" Source="io_1" />
          <Input Name="io_2" Type="bool" Source="io_2" />
          <Output Name="io_3" Type="bool" />
          <Output Name="io_4" Type="int" />
          <Output Name="serial_0_trigger" Type="bool" />
          <Output Name="serial_0_value_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_conditional_4" Type="int" />
          <Expression Expression="sysml_lazy_0 = io_0 &lt;= 300.0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_1 = io_2" />
            <If Condition="sysml_lazy_1">
              <Expression Expression="sysml_lazy_1 = io_1 &lt;= 20.0" />
            </If>
            <Expression Expression="sysml_lazy_0 = sysml_lazy_1" />
          </If>
          <Expression Expression="sysml_state_alarmActive = sysml_lazy_0" />
          <If Condition="sysml_state_alarmActive">
            <Expression Expression="sysml_state_ledState = (!sysml_state_ledState)" />
            <Expression Expression="sysml_state_beepState = (!sysml_state_beepState)" />
          </If>
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <Expression Expression="sysml_lazy_2 = sysml_state_ledState" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = sysml_state_alarmActive" />
          </If>
          <Expression Expression="sysml_value_0 = sysml_lazy_2" />
          <LocalVariable Name="sysml_value_1" Type="int" />
          <Expression Expression="sysml_lazy_3 = sysml_state_alarmActive" />
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_lazy_3 = sysml_state_beepState" />
          </If>
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_conditional_4 = 2000" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_4 = 0" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_4" />
          <LocalVariable Name="sysml_value_2" Type="bool" />
          <Expression Expression="sysml_value_2 = sysml_state_alarmActive" />
          <LocalVariable Name="sysml_value_3" Type="bool" />
          <Expression Expression="sysml_value_3 = sysml_state_alarmActive" />
          <Expression Expression="*io_3 = sysml_value_0" />
          <Expression Expression="*io_4 = sysml_value_1" />
          <Expression Expression="*serial_0_trigger = sysml_value_2" />
          <Expression Expression="*serial_0_value_0 = sysml_value_3" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>