<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_running = false" />
          <Expression Expression="sysml_state_paused = false" />
          <Expression Expression="sysml_state_seconds = 0" />
          <Expression Expression="sysml_state_previousStartPausePressed = false" />
          <Expression Expression="sysml_state_previousResetPressed = false" />
          <Expression Expression="sysml_state_buzzerOn = false" />
          <Expression Expression="sysml_state_buzzerRemainingMs = 0" />
          <Expression Expression="sysml_state_toneHz = 0" />
          <Expression Expression="sysml_state_displayValue = 0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_running" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_paused" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_seconds" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_previousStartPausePressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_previousResetPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_buzzerOn" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_buzzerRemainingMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_toneHz" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_displayValue" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_1" Type="bool" />
      <Output Name="io_2" Type="int" />
      <Output Name="io_3" Type="int" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Output Name="io_2" Type="int" />
          <Output Name="io_3" Type="int" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_lazy_4" Type="bool" />
          <LocalVariable Name="sysml_lazy_5" Type="bool" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_previousStartPausePressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_paused = (!sysml_state_paused)" />
          </If>
          <Expression Expression="sysml_lazy_1 = io_1" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = !sysml_state_previousResetPressed" />
          </If>
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_state_running = false" />
            <Expression Expression="sysml_state_paused = false" />
            <Expression Expression="sysml_state_seconds = 0" />
            <Expression Expression="sysml_state_buzzerOn = false" />
            <Expression Expression="sysml_state_buzzerRemainingMs = 0" />
            <Expression Expression="sysml_state_toneHz = 0" />
            <Expression Expression="sysml_state_displayValue = 0" />
          </If>
          <If Condition="(sysml_state_buzzerRemainingMs &lt;= 0)">
            <Expression Expression="sysml_state_buzzerOn = false" />
            <Expression Expression="sysml_state_toneHz = 0" />
          </If>
          <Expression Expression="sysml_lazy_2 = !sysml_state_paused" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = sysml_state_buzzerOn" />
          </If>
          <Expression Expression="sysml_lazy_3 = sysml_lazy_2" />
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_lazy_3 = sysml_state_buzzerRemainingMs &gt; 0" />
          </If>
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_state_buzzerRemainingMs = sysml_state_buzzerRemainingMs" />
            <Expression Expression="sysml_state_toneHz = sysml_state_toneHz" />
          </If>
          <Expression Expression="sysml_lazy_4 = sysml_state_buzzerOn" />
          <If Condition="sysml_lazy_4">
            <Expression Expression="sysml_lazy_4 = sysml_state_buzzerRemainingMs &lt;= 0" />
          </If>
          <If Condition="sysml_lazy_4">
            <Expression Expression="sysml_state_buzzerOn = false" />
            <Expression Expression="sysml_state_toneHz = 0" />
          </If>
          <Expression Expression="sysml_lazy_5 = sysml_state_seconds &gt;= 60" />
          <If Condition="sysml_lazy_5">
            <Expression Expression="sysml_lazy_5 = !sysml_state_buzzerOn" />
          </If>
          <If Condition="sysml_lazy_5">
            <Expression Expression="sysml_state_buzzerOn = true" />
            <Expression Expression="sysml_state_buzzerRemainingMs = 1000" />
            <Expression Expression="sysml_state_toneHz = 1000" />
          </If>
          <If Condition="(!sysml_state_paused)">
            <Expression Expression="sysml_state_seconds = sysml_state_seconds" />
            <Expression Expression="sysml_state_displayValue = sysml_state_seconds" />
          </If>
          <Else>
            <Expression Expression="sysml_state_displayValue = sysml_state_seconds" />
          </Else>
          <Expression Expression="sysml_state_previousStartPausePressed = io_0" />
          <Expression Expression="sysml_state_previousResetPressed = io_1" />
          <LocalVariable Name="sysml_value_0" Type="int" />
          <Expression Expression="sysml_value_0 = sysml_state_toneHz" />
          <LocalVariable Name="sysml_value_1" Type="int" />
          <Expression Expression="sysml_value_1 = sysml_state_displayValue" />
          <Expression Expression="*io_2 = sysml_value_0" />
          <Expression Expression="*io_3 = sysml_value_1" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>