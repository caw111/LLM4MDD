<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_previousPressed = false" />
          <Expression Expression="sysml_state_releasedDelayRemainingMs = 0" />
          <Expression Expression="sysml_state_toneOn = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_previousPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_releasedDelayRemainingMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_toneOn" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_2" Type="int" />
      <Output Name="io_1" Type="int" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_2" Type="int" Source="io_2" />
          <Output Name="io_1" Type="int" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_conditional_3" Type="int" />
          <LocalVariable Name="sysml_lazy_4" Type="bool" />
          <LocalVariable Name="sysml_conditional_5" Type="int" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_previousPressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_releasedDelayRemainingMs = 0" />
            <Expression Expression="sysml_state_toneOn = true" />
          </If>
          <Expression Expression="sysml_lazy_1 = !io_0" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = sysml_state_previousPressed" />
          </If>
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_state_releasedDelayRemainingMs = 1000" />
          </If>
          <Expression Expression="sysml_lazy_2 = !io_0" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = sysml_state_releasedDelayRemainingMs &gt; 0" />
          </If>
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_conditional_3 = sysml_state_releasedDelayRemainingMs - io_2" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_3 = sysml_state_releasedDelayRemainingMs" />
          </Else>
          <Expression Expression="sysml_state_releasedDelayRemainingMs = sysml_conditional_3" />
          <Expression Expression="sysml_lazy_4 = !io_0" />
          <If Condition="sysml_lazy_4">
            <Expression Expression="sysml_lazy_4 = sysml_state_releasedDelayRemainingMs &lt;= 0" />
          </If>
          <If Condition="sysml_lazy_4">
            <Expression Expression="sysml_state_toneOn = false" />
            <Expression Expression="sysml_state_releasedDelayRemainingMs = 0" />
          </If>
          <Expression Expression="sysml_state_previousPressed = io_0" />
          <If Condition="io_0">
            <Expression Expression="sysml_state_toneOn = true" />
          </If>
          <LocalVariable Name="sysml_value_0" Type="int" />
          <If Condition="sysml_state_toneOn">
            <Expression Expression="sysml_conditional_5 = 440" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_5 = 0" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_5" />
          <Expression Expression="*io_1 = sysml_value_0" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>