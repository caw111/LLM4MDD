<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_pollTimerMs = 0" />
          <Expression Expression="sysml_state_distanceBelowCount = 0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_pollTimerMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_distanceBelowCount" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_1" Type="double" />
      <Input Name="io_2" Type="double" />
      <Input Name="io_3" Type="bool" />
      <Input Name="io_4" Type="double" />
      <Input Name="io_5" Type="bool" />
      <Input Name="io_6" Type="int" />
      <Output Name="io_0" Type="bool" />
      <Output Name="serial_0_trigger" Type="bool" />
      <Output Name="serial_0_value_0" Type="double" />
      <Output Name="serial_0_value_1" Type="double" />
      <Output Name="serial_1_trigger" Type="bool" />
      <Output Name="serial_1_value_0" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_1" Type="double" Source="io_1" />
          <Input Name="io_2" Type="double" Source="io_2" />
          <Input Name="io_3" Type="bool" Source="io_3" />
          <Input Name="io_4" Type="double" Source="io_4" />
          <Input Name="io_5" Type="bool" Source="io_5" />
          <Input Name="io_6" Type="int" Source="io_6" />
          <Output Name="io_0" Type="bool" />
          <Output Name="serial_0_trigger" Type="bool" />
          <Output Name="serial_0_value_0" Type="double" />
          <Output Name="serial_0_value_1" Type="double" />
          <Output Name="serial_1_trigger" Type="bool" />
          <Output Name="serial_1_value_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <Expression Expression="sysml_state_pollTimerMs = (sysml_state_pollTimerMs + io_6)" />
          <If Condition="(sysml_state_pollTimerMs &gt;= 3000)">
            <Expression Expression="sysml_state_pollTimerMs = (sysml_state_pollTimerMs - 3000)" />
            <If Condition="io_5">
              <If Condition="(io_4 &lt; 20.0)">
                <Expression Expression="sysml_state_distanceBelowCount = (sysml_state_distanceBelowCount + 1)" />
              </If>
              <Else>
                <Expression Expression="sysml_state_distanceBelowCount = 0" />
              </Else>
            </If>
            <Else>
              <Expression Expression="sysml_state_distanceBelowCount = 0" />
            </Else>
          </If>
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <Expression Expression="sysml_value_0 = (sysml_state_distanceBelowCount &gt;= 3)" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <Expression Expression="sysml_value_1 = (sysml_state_pollTimerMs &gt;= 3000)" />
          <LocalVariable Name="sysml_value_2" Type="double" />
          <Expression Expression="sysml_value_2 = io_1" />
          <LocalVariable Name="sysml_value_3" Type="double" />
          <Expression Expression="sysml_value_3 = io_4" />
          <LocalVariable Name="sysml_value_4" Type="bool" />
          <Expression Expression="sysml_lazy_0 = sysml_state_pollTimerMs &gt;= 3000" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = sysml_state_distanceBelowCount &gt;= 3" />
          </If>
          <Expression Expression="sysml_value_4 = sysml_lazy_0" />
          <LocalVariable Name="sysml_value_5" Type="bool" />
          <Expression Expression="sysml_value_5 = (sysml_state_distanceBelowCount &gt;= 3)" />
          <Expression Expression="*io_0 = sysml_value_0" />
          <Expression Expression="*serial_0_trigger = sysml_value_1" />
          <Expression Expression="*serial_0_value_0 = sysml_value_2" />
          <Expression Expression="*serial_0_value_1 = sysml_value_3" />
          <Expression Expression="*serial_1_trigger = sysml_value_4" />
          <Expression Expression="*serial_1_value_0 = sysml_value_5" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>