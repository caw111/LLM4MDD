<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_activePot = 0" />
          <Expression Expression="sysml_state_prevBtn1 = false" />
          <Expression Expression="sysml_state_prevBtn2 = false" />
          <Expression Expression="sysml_state_prevBtn3 = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_activePot" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_prevBtn1" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_prevBtn2" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_prevBtn3" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_1" Type="bool" />
      <Input Name="io_2" Type="bool" />
      <Input Name="io_3" Type="double" />
      <Input Name="io_4" Type="double" />
      <Input Name="io_5" Type="double" />
      <Output Name="io_6" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Input Name="io_2" Type="bool" Source="io_2" />
          <Input Name="io_3" Type="double" Source="io_3" />
          <Input Name="io_4" Type="double" Source="io_4" />
          <Input Name="io_5" Type="double" Source="io_5" />
          <Output Name="io_6" Type="double" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_conditional_3" Type="double" />
          <LocalVariable Name="sysml_conditional_4" Type="double" />
          <LocalVariable Name="sysml_conditional_5" Type="double" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_prevBtn1" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_activePot = 1" />
          </If>
          <Expression Expression="sysml_lazy_1 = io_1" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = !sysml_state_prevBtn2" />
          </If>
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_state_activePot = 2" />
          </If>
          <Expression Expression="sysml_lazy_2 = io_2" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = !sysml_state_prevBtn3" />
          </If>
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_state_activePot = 3" />
          </If>
          <Expression Expression="sysml_state_prevBtn1 = io_0" />
          <Expression Expression="sysml_state_prevBtn2 = io_1" />
          <Expression Expression="sysml_state_prevBtn3 = io_2" />
          <LocalVariable Name="sysml_value_0" Type="double" />
          <If Condition="sysml_state_activePot == 1">
            <Expression Expression="sysml_conditional_3 = ((double) (io_3 * 180.0)) / 1023.0" />
          </If>
          <Else>
            <If Condition="sysml_state_activePot == 2">
              <Expression Expression="sysml_conditional_4 = ((double) (io_4 * 180.0)) / 1023.0" />
            </If>
            <Else>
              <If Condition="sysml_state_activePot == 3">
                <Expression Expression="sysml_conditional_5 = ((double) (io_5 * 180.0)) / 1023.0" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_5 = 0.0" />
              </Else>
              <Expression Expression="sysml_conditional_4 = sysml_conditional_5" />
            </Else>
            <Expression Expression="sysml_conditional_3 = sysml_conditional_4" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_3" />
          <Expression Expression="*io_6 = sysml_value_0" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>