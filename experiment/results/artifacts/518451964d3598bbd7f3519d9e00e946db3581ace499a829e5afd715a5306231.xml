    <GlobalVariable Name="sysml_state_modeConflict" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_ledGate" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_previousBtn1" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_previousBtn2" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_ledPulseAccumMs" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_3" Type="bool" />
      <Input Name="io_4" Type="bool" />
      <Input Name="io_5" Type="int" />
      <Output Name="io_0" Type="double" />
      <Output Name="io_1" Type="double" />
      <Output Name="io_2" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_3" Type="bool" Source="io_3" />
          <Input Name="io_4" Type="bool" Source="io_4" />
          <Input Name="io_5" Type="int" Source="io_5" />
          <Output Name="io_0" Type="double" />
          <Output Name="io_1" Type="double" />
          <Output Name="io_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_lazy_4" Type="bool" />
          <LocalVariable Name="sysml_lazy_5" Type="bool" />
          <LocalVariable Name="sysml_lazy_6" Type="bool" />
          <LocalVariable Name="sysml_lazy_7" Type="bool" />
          <LocalVariable Name="sysml_conditional_8" Type="double" />
          <LocalVariable Name="sysml_conditional_9" Type="double" />
          <LocalVariable Name="sysml_conditional_10" Type="double" />
          <LocalVariable Name="sysml_conditional_11" Type="double" />
          <Expression Expression="sysml_lazy_0 = io_3" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = io_4" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_modeConflict = true" />
          </If>
          <If Condition="(!sysml_state_modeConflict)">
            <Expression Expression="sysml_lazy_1 = io_3" />
            <If Condition="sysml_lazy_1">
              <Expression Expression="sysml_lazy_1 = !sysml_state_previousBtn1" />
            </If>
            <Expression Expression="sysml_lazy_2 = sysml_lazy_1" />
            <If Condition="sysml_lazy_2">
              <Expression Expression="sysml_lazy_2 = io_4" />
            </If>
            <If Condition="sysml_lazy_2">
              <Expression Expression="sysml_state_modeConflict = true" />
            </If>
            <Expression Expression="sysml_lazy_3 = io_4" />
            <If Condition="sysml_lazy_3">
              <Expression Expression="sysml_lazy_3 = !sysml_state_previousBtn2" />
            </If>
            <Expression Expression="sysml_lazy_4 = sysml_lazy_3" />
            <If Condition="sysml_lazy_4">
              <Expression Expression="sysml_lazy_4 = io_3" />
            </If>
            <If Condition="sysml_lazy_4">
              <Expression Expression="sysml_state_modeConflict = true" />
            </If>
          </If>
          <Else>
            <Expression Expression="sysml_lazy_5 = io_3" />
            <If Condition="sysml_lazy_5">
              <Expression Expression="sysml_lazy_5 = !io_4" />
            </If>
            <Expression Expression="sysml_lazy_6 = sysml_lazy_5" />
            <If Condition="!sysml_lazy_6">
              <Expression Expression="sysml_lazy_7 = io_4" />
              <If Condition="sysml_lazy_7">
                <Expression Expression="sysml_lazy_7 = !io_3" />
              </If>
              <Expression Expression="sysml_lazy_6 = sysml_lazy_7" />
            </If>
            <If Condition="sysml_lazy_6">
              <Expression Expression="sysml_state_modeConflict = false" />
              <Expression Expression="sysml_state_ledPulseAccumMs = 0" />
              <Expression Expression="sysml_state_ledGate = false" />
            </If>
          </Else>
          <If Condition="sysml_state_modeConflict">
            <Expression Expression="sysml_state_ledPulseAccumMs = (sysml_state_ledPulseAccumMs + io_5)" />
            <If Condition="(sysml_state_ledPulseAccumMs &gt;= 4000)">
              <Expression Expression="sysml_state_ledPulseAccumMs = (sysml_state_ledPulseAccumMs - 4000)" />
            </If>
            <Expression Expression="sysml_state_ledGate = (sysml_state_ledPulseAccumMs &lt; 2000)" />
          </If>
          <Else>
            <Expression Expression="sysml_state_ledGate = false" />
            <Expression Expression="sysml_state_ledPulseAccumMs = 0" />
          </Else>
          <Expression Expression="sysml_state_previousBtn1 = io_3" />
          <Expression Expression="sysml_state_previousBtn2 = io_4" />
          <LocalVariable Name="sysml_value_0" Type="double" />
          <If Condition="sysml_state_modeConflict">
            <Expression Expression="sysml_conditional_8 = 0.0" />
          </If>
          <Else>
            <If Condition="io_3">
              <Expression Expression="sysml_conditional_9 = 90.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_9 = 0.0" />
            </Else>
            <Expression Expression="sysml_conditional_8 = sysml_conditional_9" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_8" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <If Condition="sysml_state_modeConflict">
            <Expression Expression="sysml_conditional_10 = 0.0" />
          </If>
          <Else>
            <If Condition="io_4">
              <Expression Expression="sysml_conditional_11 = 180.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_11 = 0.0" />
            </Else>
            <Expression Expression="sysml_conditional_10 = sysml_conditional_11" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_10" />
          <LocalVariable Name="sysml_value_2" Type="bool" />
          <Expression Expression="sysml_value_2 = sysml_state_ledGate" />
          <Expression Expression="*io_0 = sysml_value_0" />
          <Expression Expression="*io_1 = sysml_value_1" />
          <Expression Expression="*io_2 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>