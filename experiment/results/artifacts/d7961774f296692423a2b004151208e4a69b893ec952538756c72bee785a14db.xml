<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_thresholdC = 30.0" />
          <Expression Expression="sysml_state_fanMinPwm = 0.0" />
          <Expression Expression="sysml_state_autoMode = false" />
          <Expression Expression="sysml_state_prevOverheatCond = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_thresholdC" Type="double" DefaultValue="30.0" />
    <GlobalVariable Name="sysml_state_fanMinPwm" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_autoMode" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_prevOverheatCond" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="double" />
      <Input Name="io_3" Type="int" />
      <Input Name="io_3_valid" Type="bool" />
      <Output Name="io_1" Type="double" />
      <Output Name="io_2" Type="bool" />
      <Output Name="serial_0_trigger" Type="bool" />
      <Output Name="serial_0_value_0" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="double" Source="io_0" />
          <Input Name="io_3" Type="int" Source="io_3" />
          <Input Name="io_3_valid" Type="bool" Source="io_3_valid" />
          <Output Name="io_1" Type="double" />
          <Output Name="io_2" Type="bool" />
          <Output Name="serial_0_trigger" Type="bool" />
          <Output Name="serial_0_value_0" Type="double" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_lazy_4" Type="bool" />
          <LocalVariable Name="sysml_conditional_5" Type="bool" />
          <LocalVariable Name="sysml_conditional_6" Type="double" />
          <LocalVariable Name="sysml_conditional_7" Type="double" />
          <LocalVariable Name="sysml_conditional_8" Type="double" />
          <LocalVariable Name="sysml_lazy_9" Type="bool" />
          <LocalVariable Name="sysml_conditional_10" Type="bool" />
          <LocalVariable Name="sysml_lazy_11" Type="bool" />
          <LocalVariable Name="sysml_lazy_12" Type="bool" />
          <LocalVariable Name="sysml_conditional_13" Type="bool" />
          <Expression Expression="sysml_lazy_0 = io_3_valid" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = io_3 == 10" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_thresholdC = 30.0" />
            <Expression Expression="sysml_state_fanMinPwm = 0.0" />
            <Expression Expression="sysml_state_autoMode = false" />
            <Expression Expression="sysml_state_prevOverheatCond = false" />
          </If>
          <Expression Expression="sysml_lazy_1 = io_3_valid" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = io_3 == 7" />
          </If>
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_state_thresholdC = 0.0" />
          </If>
          <Expression Expression="sysml_lazy_2 = io_3_valid" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = io_3 == 8" />
          </If>
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_state_fanMinPwm = 0.0" />
          </If>
          <Expression Expression="sysml_lazy_3 = io_3_valid" />
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_lazy_3 = io_3 == 11" />
          </If>
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_state_autoMode = true" />
          </If>
          <Expression Expression="sysml_lazy_4 = io_3_valid" />
          <If Condition="sysml_lazy_4">
            <Expression Expression="sysml_lazy_4 = io_3 == 12" />
          </If>
          <If Condition="sysml_lazy_4">
            <Expression Expression="sysml_state_autoMode = false" />
          </If>
          <If Condition="io_0 &gt;= (sysml_state_thresholdC + 5.0)">
            <Expression Expression="sysml_conditional_5 = true" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_5 = false" />
          </Else>
          <Expression Expression="sysml_state_prevOverheatCond = sysml_conditional_5" />
          <LocalVariable Name="sysml_value_0" Type="double" />
          <If Condition="sysml_state_autoMode">
            <If Condition="io_0 &gt;= sysml_state_thresholdC">
              <If Condition="io_0 &gt;= (sysml_state_thresholdC + 5.0)">
                <Expression Expression="sysml_conditional_8 = sysml_state_fanMinPwm" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_8 = sysml_state_fanMinPwm" />
              </Else>
              <Expression Expression="sysml_conditional_7 = sysml_conditional_8" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_7 = 0.0" />
            </Else>
            <Expression Expression="sysml_conditional_6 = sysml_conditional_7" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_6 = 0.0" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_6" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <Expression Expression="sysml_lazy_9 = sysml_state_autoMode" />
          <If Condition="sysml_lazy_9">
            <Expression Expression="sysml_lazy_9 = io_0 &gt;= (sysml_state_thresholdC + 5.0)" />
          </If>
          <If Condition="sysml_lazy_9">
            <Expression Expression="sysml_conditional_10 = true" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_10 = false" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_10" />
          <LocalVariable Name="sysml_value_2" Type="bool" />
          <Expression Expression="sysml_lazy_11 = sysml_state_autoMode" />
          <If Condition="sysml_lazy_11">
            <Expression Expression="sysml_lazy_11 = io_0 &gt;= (sysml_state_thresholdC + 5.0)" />
          </If>
          <Expression Expression="sysml_lazy_12 = sysml_lazy_11" />
          <If Condition="sysml_lazy_12">
            <Expression Expression="sysml_lazy_12 = !sysml_state_prevOverheatCond" />
          </If>
          <If Condition="sysml_lazy_12">
            <Expression Expression="sysml_conditional_13 = true" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_13 = false" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_13" />
          <LocalVariable Name="sysml_value_3" Type="double" />
          <Expression Expression="sysml_value_3 = io_0" />
          <Expression Expression="*io_1 = sysml_value_0" />
          <Expression Expression="*io_2 = sysml_value_1" />
          <Expression Expression="*serial_0_trigger = sysml_value_2" />
          <Expression Expression="*serial_0_value_0 = sysml_value_3" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>