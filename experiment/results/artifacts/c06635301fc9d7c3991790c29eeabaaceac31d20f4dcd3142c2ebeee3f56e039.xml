<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_servo1Angle = 0.0" />
          <Expression Expression="sysml_state_servo2Angle = 0.0" />
          <Expression Expression="sysml_state_previousBtn1 = false" />
          <Expression Expression="sysml_state_previousBtn2 = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_servo1Angle" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_servo2Angle" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_previousBtn1" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_previousBtn2" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_1" Type="bool" />
      <Input Name="io_2" Type="double" />
      <Input Name="io_3" Type="double" />
      <Output Name="io_4" Type="double" />
      <Output Name="io_5" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Input Name="io_2" Type="double" Source="io_2" />
          <Input Name="io_3" Type="double" Source="io_3" />
          <Output Name="io_4" Type="double" />
          <Output Name="io_5" Type="double" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="double" />
          <LocalVariable Name="sysml_conditional_2" Type="double" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_conditional_4" Type="double" />
          <LocalVariable Name="sysml_conditional_5" Type="double" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_previousBtn1" />
          </If>
          <If Condition="sysml_lazy_0">
            <If Condition="io_2 &gt;= 1023.0">
              <Expression Expression="sysml_conditional_1 = 180.0" />
            </If>
            <Else>
              <If Condition="io_2 &lt;= 0.0">
                <Expression Expression="sysml_conditional_2 = 0.0" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_2 = ((double) (io_2 * 180.0)) / 1023.0" />
              </Else>
              <Expression Expression="sysml_conditional_1 = sysml_conditional_2" />
            </Else>
            <Expression Expression="sysml_state_servo1Angle = sysml_conditional_1" />
          </If>
          <Expression Expression="sysml_lazy_3 = io_1" />
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_lazy_3 = !sysml_state_previousBtn2" />
          </If>
          <If Condition="sysml_lazy_3">
            <If Condition="io_3 &gt;= 1023.0">
              <Expression Expression="sysml_conditional_4 = 180.0" />
            </If>
            <Else>
              <If Condition="io_3 &lt;= 0.0">
                <Expression Expression="sysml_conditional_5 = 0.0" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_5 = ((double) (io_3 * 180.0)) / 1023.0" />
              </Else>
              <Expression Expression="sysml_conditional_4 = sysml_conditional_5" />
            </Else>
            <Expression Expression="sysml_state_servo2Angle = sysml_conditional_4" />
          </If>
          <Expression Expression="sysml_state_previousBtn1 = io_0" />
          <Expression Expression="sysml_state_previousBtn2 = io_1" />
          <LocalVariable Name="sysml_value_0" Type="double" />
          <Expression Expression="sysml_value_0 = sysml_state_servo1Angle" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <Expression Expression="sysml_value_1 = sysml_state_servo2Angle" />
          <Expression Expression="*io_4 = sysml_value_0" />
          <Expression Expression="*io_5 = sysml_value_1" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>