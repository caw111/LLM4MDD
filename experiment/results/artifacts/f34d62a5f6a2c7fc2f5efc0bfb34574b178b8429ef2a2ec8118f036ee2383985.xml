<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_activeAngleDeg = 0.0" />
          <Expression Expression="sysml_state_activeLedLevel = 0" />
          <Expression Expression="sysml_state_holdElapsedMs = 0" />
          <Expression Expression="sysml_state_btn1PrevPressed = false" />
          <Expression Expression="sysml_state_btn2PrevPressed = false" />
          <Expression Expression="sysml_state_btn3PrevPressed = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_activeAngleDeg" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_activeLedLevel" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_holdElapsedMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_btn1PrevPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_btn2PrevPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_btn3PrevPressed" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_1" Type="bool" />
      <Input Name="io_2" Type="bool" />
      <Output Name="io_3_segment_0" Type="bool" />
      <Output Name="io_3_segment_1" Type="bool" />
      <Output Name="io_3_segment_2" Type="bool" />
      <Output Name="io_3_segment_3" Type="bool" />
      <Output Name="io_3_segment_4" Type="bool" />
      <Output Name="io_3_segment_5" Type="bool" />
      <Output Name="io_3_segment_6" Type="bool" />
      <Output Name="io_3_segment_7" Type="bool" />
      <Output Name="io_3_segment_8" Type="bool" />
      <Output Name="io_3_segment_9" Type="bool" />
      <Output Name="io_4" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Input Name="io_2" Type="bool" Source="io_2" />
          <Output Name="io_3_segment_0" Type="bool" />
          <Output Name="io_3_segment_1" Type="bool" />
          <Output Name="io_3_segment_2" Type="bool" />
          <Output Name="io_3_segment_3" Type="bool" />
          <Output Name="io_3_segment_4" Type="bool" />
          <Output Name="io_3_segment_5" Type="bool" />
          <Output Name="io_3_segment_6" Type="bool" />
          <Output Name="io_3_segment_7" Type="bool" />
          <Output Name="io_3_segment_8" Type="bool" />
          <Output Name="io_3_segment_9" Type="bool" />
          <Output Name="io_4" Type="double" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_btn1PrevPressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_activeAngleDeg = 30.0" />
            <Expression Expression="sysml_state_activeLedLevel = 3" />
            <Expression Expression="sysml_state_holdElapsedMs = 0" />
          </If>
          <Expression Expression="sysml_lazy_1 = io_1" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = !sysml_state_btn2PrevPressed" />
          </If>
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_state_activeAngleDeg = 60.0" />
            <Expression Expression="sysml_state_activeLedLevel = 6" />
            <Expression Expression="sysml_state_holdElapsedMs = 0" />
          </If>
          <Expression Expression="sysml_lazy_2 = io_2" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = !sysml_state_btn3PrevPressed" />
          </If>
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_state_activeAngleDeg = 90.0" />
            <Expression Expression="sysml_state_activeLedLevel = 10" />
            <Expression Expression="sysml_state_holdElapsedMs = 0" />
          </If>
          <If Condition="(sysml_state_holdElapsedMs &lt; 2000)">
            <Expression Expression="sysml_state_holdElapsedMs = sysml_state_holdElapsedMs" />
          </If>
          <Expression Expression="sysml_state_btn1PrevPressed = io_0" />
          <Expression Expression="sysml_state_btn2PrevPressed = io_1" />
          <Expression Expression="sysml_state_btn3PrevPressed = io_2" />
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <Expression Expression="sysml_value_0 = (sysml_state_activeLedLevel &gt;= 1)" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <Expression Expression="sysml_value_1 = (sysml_state_activeLedLevel &gt;= 2)" />
          <LocalVariable Name="sysml_value_2" Type="bool" />
          <Expression Expression="sysml_value_2 = (sysml_state_activeLedLevel &gt;= 3)" />
          <LocalVariable Name="sysml_value_3" Type="bool" />
          <Expression Expression="sysml_value_3 = (sysml_state_activeLedLevel &gt;= 4)" />
          <LocalVariable Name="sysml_value_4" Type="bool" />
          <Expression Expression="sysml_value_4 = (sysml_state_activeLedLevel &gt;= 5)" />
          <LocalVariable Name="sysml_value_5" Type="bool" />
          <Expression Expression="sysml_value_5 = (sysml_state_activeLedLevel &gt;= 6)" />
          <LocalVariable Name="sysml_value_6" Type="bool" />
          <Expression Expression="sysml_value_6 = (sysml_state_activeLedLevel &gt;= 7)" />
          <LocalVariable Name="sysml_value_7" Type="bool" />
          <Expression Expression="sysml_value_7 = (sysml_state_activeLedLevel &gt;= 8)" />
          <LocalVariable Name="sysml_value_8" Type="bool" />
          <Expression Expression="sysml_value_8 = (sysml_state_activeLedLevel &gt;= 9)" />
          <LocalVariable Name="sysml_value_9" Type="bool" />
          <Expression Expression="sysml_value_9 = (sysml_state_activeLedLevel &gt;= 10)" />
          <LocalVariable Name="sysml_value_10" Type="double" />
          <Expression Expression="sysml_value_10 = sysml_state_activeAngleDeg" />
          <Expression Expression="*io_3_segment_0 = sysml_value_0" />
          <Expression Expression="*io_3_segment_1 = sysml_value_1" />
          <Expression Expression="*io_3_segment_2 = sysml_value_2" />
          <Expression Expression="*io_3_segment_3 = sysml_value_3" />
          <Expression Expression="*io_3_segment_4 = sysml_value_4" />
          <Expression Expression="*io_3_segment_5 = sysml_value_5" />
          <Expression Expression="*io_3_segment_6 = sysml_value_6" />
          <Expression Expression="*io_3_segment_7 = sysml_value_7" />
          <Expression Expression="*io_3_segment_8 = sysml_value_8" />
          <Expression Expression="*io_3_segment_9 = sysml_value_9" />
          <Expression Expression="*io_4 = sysml_value_10" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>