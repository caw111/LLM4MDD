<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_counter = 0" />
          <Expression Expression="sysml_state_prevIncPressed = false" />
          <Expression Expression="sysml_state_prevDecPressed = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_counter" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_prevIncPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_prevDecPressed" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_1" Type="bool" />
      <Output Name="io_2" Type="int" />
      <Output Name="io_3" Type="int" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Output Name="io_2" Type="int" />
          <Output Name="io_3" Type="int" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_conditional_3" Type="int" />
          <LocalVariable Name="sysml_lazy_4" Type="bool" />
          <LocalVariable Name="sysml_conditional_5" Type="int" />
          <Expression Expression="sysml_state_prevIncPressed = io_0" />
          <Expression Expression="sysml_state_prevDecPressed = io_1" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_prevIncPressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <If Condition="(sysml_state_counter == 20)">
              <Expression Expression="sysml_state_counter = 20" />
            </If>
            <Else>
              <Expression Expression="sysml_state_counter = (sysml_state_counter + 1)" />
            </Else>
          </If>
          <Expression Expression="sysml_lazy_1 = io_1" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = !sysml_state_prevDecPressed" />
          </If>
          <If Condition="sysml_lazy_1">
            <If Condition="(sysml_state_counter == 0)">
              <Expression Expression="sysml_state_counter = 0" />
            </If>
            <Else>
              <Expression Expression="sysml_state_counter = (sysml_state_counter - 1)" />
            </Else>
          </If>
          <LocalVariable Name="sysml_value_0" Type="int" />
          <Expression Expression="sysml_lazy_2 = sysml_state_counter == 20" />
          <If Condition="!sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = sysml_state_counter == 0" />
          </If>
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_conditional_3 = 1000" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_3 = 0" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_3" />
          <LocalVariable Name="sysml_value_1" Type="int" />
          <Expression Expression="sysml_lazy_4 = sysml_state_counter &lt; 0" />
          <If Condition="!sysml_lazy_4">
            <Expression Expression="sysml_lazy_4 = sysml_state_counter &gt; 20" />
          </If>
          <If Condition="sysml_lazy_4">
            <Expression Expression="sysml_conditional_5 = 0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_5 = sysml_state_counter" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_5" />
          <Expression Expression="*io_2 = sysml_value_0" />
          <Expression Expression="*io_3 = sysml_value_1" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>