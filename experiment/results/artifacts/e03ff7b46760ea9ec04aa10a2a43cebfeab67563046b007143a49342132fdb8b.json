      "meaning": "人体接近距离（cm），用于自动点亮判定",
      "sample_period_ms": 60,
      "device": "ultrasonic_distance",
      "hardware": "{\"echo_pin\": \"D3\", \"invalid_policy\": \"hold_last_valid\", \"kind\": \"ultrasonic_distance\", \"sensor\": \"HC-SR04\", \"timeout_us\": 30000, \"trigger_pin\": \"D8\"}",
      "binding": {
        "kind": "ultrasonic_distance",
        "sensor": "HC-SR04",
        "timeout_us": 30000,
        "invalid_policy": "hold_last_valid",
        "echo_pin": "D3",
        "trigger_pin": "D8"
      }
    },
    {
      "name": "io_2",
      "direction": "input",
