        "scale": 1,
        "offset": 0,
        "pin": "D9"
      }
    },
    {
      "name": "io_4",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "按钮输入：用于强制常亮模式与自动模式切换",
      "sample_period_ms": 10,
      "device": "digital_input",
      "hardware": "{\"active_high\": true, \"kind\": \"digital_input\", \"pin\": \"D2\", \"pullup\": false}",
      "binding": {
