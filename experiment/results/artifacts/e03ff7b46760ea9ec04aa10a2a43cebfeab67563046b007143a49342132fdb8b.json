      "device": "ultrasonic_valid",
      "hardware": "{\"echo_pin\": \"D3\", \"invalid_policy\": \"hold_last_valid\", \"kind\": \"ultrasonic_valid\", \"sensor\": \"HC-SR04\", \"timeout_us\": 30000, \"trigger_pin\": \"D8\"}",
      "binding": {
        "kind": "ultrasonic_valid",
        "sensor": "HC-SR04",
        "timeout_us": 30000,
        "invalid_policy": "hold_last_valid",
        "echo_pin": "D3",
        "trigger_pin": "D8"
      }
    },
    {
      "name": "io_3",
      "direction": "output",
      "type": "f64",
