<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_countdownSeconds = 0" />
          <Expression Expression="sysml_state_started = false" />
          <Expression Expression="sysml_state_prevAddPressed = false" />
          <Expression Expression="sysml_state_prevStartPressed = false" />
          <Expression Expression="sysml_state_beepActive = false" />
          <Expression Expression="sysml_state_beepCounterMs = 0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_countdownSeconds" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_started" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_prevAddPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_prevStartPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_beepActive" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_beepCounterMs" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_1" Type="bool" />
      <Output Name="io_2" Type="int" />
      <Output Name="io_3" Type="int" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Output Name="io_2" Type="int" />
          <Output Name="io_3" Type="int" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="int" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_conditional_3" Type="int" />
          <LocalVariable Name="sysml_lazy_4" Type="bool" />
          <LocalVariable Name="sysml_conditional_5" Type="int" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_prevAddPressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <If Condition="sysml_state_started">
              <Expression Expression="sysml_conditional_1 = sysml_state_countdownSeconds + 10" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_1 = sysml_state_countdownSeconds" />
            </Else>
            <Expression Expression="sysml_state_countdownSeconds = sysml_conditional_1" />
          </If>
          <Expression Expression="sysml_lazy_2 = io_1" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = !sysml_state_prevStartPressed" />
          </If>
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_state_started = true" />
            <If Condition="sysml_state_countdownSeconds == 0">
              <Expression Expression="sysml_conditional_3 = 10" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_3 = sysml_state_countdownSeconds" />
            </Else>
            <Expression Expression="sysml_state_countdownSeconds = sysml_conditional_3" />
            <Expression Expression="sysml_state_beepActive = false" />
            <Expression Expression="sysml_state_beepCounterMs = 0" />
          </If>
          <If Condition="sysml_state_started">
            <If Condition="(sysml_state_countdownSeconds &gt; 0)">
              <Expression Expression="sysml_state_countdownSeconds = (sysml_state_countdownSeconds - 1)" />
            </If>
            <Expression Expression="sysml_lazy_4 = sysml_state_countdownSeconds == 0" />
            <If Condition="sysml_lazy_4">
              <Expression Expression="sysml_lazy_4 = !sysml_state_beepActive" />
            </If>
            <If Condition="sysml_lazy_4">
              <Expression Expression="sysml_state_beepActive = true" />
              <Expression Expression="sysml_state_beepCounterMs = 2000" />
            </If>
          </If>
          <If Condition="sysml_state_beepActive">
            <Expression Expression="sysml_state_beepCounterMs = (sysml_state_beepCounterMs - 5)" />
            <If Condition="(sysml_state_beepCounterMs &lt;= 0)">
              <Expression Expression="sysml_state_beepActive = false" />
              <Expression Expression="sysml_state_beepCounterMs = 0" />
            </If>
          </If>
          <Expression Expression="sysml_state_prevAddPressed = io_0" />
          <Expression Expression="sysml_state_prevStartPressed = io_1" />
          <LocalVariable Name="sysml_value_0" Type="int" />
          <If Condition="sysml_state_beepActive">
            <Expression Expression="sysml_conditional_5 = 1000" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_5 = 0" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_5" />
          <LocalVariable Name="sysml_value_1" Type="int" />
          <Expression Expression="sysml_value_1 = sysml_state_countdownSeconds" />
          <Expression Expression="*io_2 = sysml_value_0" />
          <Expression Expression="*io_3 = sysml_value_1" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>