      "meaning": "当前 LED 状态（与 D13 同步的模型值）",
      "sample_period_ms": 10,
      "device": "Serial value",
      "hardware": "{\"baud\": 9600, \"kind\": \"serial_value\", \"label\": \"LED_STATE\", \"trigger\": \"serial_0_trigger\"}",
      "binding": {
        "kind": "serial_value",
        "trigger": "serial_0_trigger",
        "baud": 9600,
        "label": "LED_STATE"
      }
    },
