      "unit": "1",
      "initial": false,
      "meaning": "按钮按下时上报当前 LED 状态与 PWM 数值（STATUS 报文语义）",
      "sample_period_ms": 10,
      "device": "Serial report control",
      "hardware": "{\"kind\": \"report_trigger\"}",
      "binding": {
        "kind": "report_trigger"
      }
    },
