      "sample_period_ms": 10,
      "device": "Serial value",
      "hardware": "{\"baud\": 9600, \"kind\": \"serial_value\", \"label\": \"PWM_VALUE\", \"trigger\": \"serial_0_trigger\"}",
      "binding": {
        "kind": "serial_value",
        "trigger": "serial_0_trigger",
        "baud": 9600,
        "label": "PWM_VALUE"
      }
    }
