      "unit": "pwm_count",
      "initial": 0,
      "meaning": "PWM LED 输出（由串口 PWM:<数值> 驱动）",
      "sample_period_ms": 10,
      "device": "pwm_output",
      "hardware": "{\"kind\": \"pwm_output\", \"offset\": 0, \"pin\": \"D9\", \"scale\": 1}",
      "binding": {
        "kind": "pwm_output",
        "scale": 1,
        "offset": 0,
        "pin": "D9"
      }
    },
    {
      "name": "io_2",
      "direction": "output",
      "type": "i32",
      "unit": "Hz",
      "initial": 0,
      "meaning": "蜂鸣器频率/响声控制（由串口 BUZZ 驱动；STATUS 影响静默/维持）",
      "sample_period_ms": 10,
      "device": "tone_output",
      "hardware": "{\"invalid_policy\": \"silence\", \"kind\": \"tone_output\", \"pin\": \"D6\"}",
      "binding": {
        "kind": "tone_output",
        "invalid_policy": "silence",
        "pin": "D6"
      }
    },
    {
      "name": "io_3",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "按钮按下输入（按下触发串口输出当前 LED 状态与 PWM 值）",
      "sample_period_ms": 10,
      "device": "digital_input",
      "hardware": "{\"active_high\": true, \"kind\": \"digital_input\", \"pin\": \"D2\", \"pullup\": false}",
      "binding": {
        "kind": "digital_input",
        "active_high": true,
        "pullup": false,
        "pin": "D2"
      },
      "model_semantics": {
        "kind": "digital_boolean",
        "true_level": "HIGH",
        "false_level": "LOW"
      }
    },
