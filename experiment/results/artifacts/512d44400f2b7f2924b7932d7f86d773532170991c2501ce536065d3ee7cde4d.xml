<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_displayCount = 0" />
          <Expression Expression="sysml_state_elapsedAccMs = 0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_displayCount" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_elapsedAccMs" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_4" Type="int" />
      <Output Name="io_0" Type="int" />
      <Output Name="io_1" Type="double" />
      <Output Name="io_2" Type="double" />
      <Output Name="io_3" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_4" Type="int" Source="io_4" />
          <Output Name="io_0" Type="int" />
          <Output Name="io_1" Type="double" />
          <Output Name="io_2" Type="double" />
          <Output Name="io_3" Type="double" />
          <LocalVariable Name="sysml_conditional_0" Type="int" />
          <LocalVariable Name="sysml_conditional_1" Type="int" />
          <LocalVariable Name="sysml_conditional_2" Type="double" />
          <LocalVariable Name="sysml_conditional_3" Type="double" />
          <LocalVariable Name="sysml_conditional_4" Type="double" />
          <Expression Expression="sysml_state_elapsedAccMs = (sysml_state_elapsedAccMs + io_4)" />
          <If Condition="(sysml_state_elapsedAccMs &gt;= 2000)">
            <Expression Expression="sysml_state_elapsedAccMs = (sysml_state_elapsedAccMs - 2000)" />
            <If Condition="sysml_state_displayCount &gt;= 99">
              <Expression Expression="sysml_conditional_0 = 0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_0 = sysml_state_displayCount + 1" />
            </Else>
            <Expression Expression="sysml_state_displayCount = sysml_conditional_0" />
          </If>
          <LocalVariable Name="sysml_value_0" Type="int" />
          <If Condition="sysml_state_displayCount &gt;= 0">
            <Expression Expression="sysml_conditional_1 = sysml_state_displayCount" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_1 = 0" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_1" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <If Condition="true">
            <Expression Expression="sysml_conditional_2 = sysml_state_displayCount * 1.8" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_2 = 0.0" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_2" />
          <LocalVariable Name="sysml_value_2" Type="double" />
          <If Condition="true">
            <Expression Expression="sysml_conditional_3 = sysml_state_displayCount * 1.2" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_3 = 0.0" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_3" />
          <LocalVariable Name="sysml_value_3" Type="double" />
          <If Condition="true">
            <Expression Expression="sysml_conditional_4 = sysml_state_displayCount * 0.6" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_4 = 0.0" />
          </Else>
          <Expression Expression="sysml_value_3 = sysml_conditional_4" />
          <Expression Expression="*io_0 = sysml_value_0" />
          <Expression Expression="*io_1 = sysml_value_1" />
          <Expression Expression="*io_2 = sysml_value_2" />
          <Expression Expression="*io_3 = sysml_value_3" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>