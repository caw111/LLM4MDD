<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_thresholdDegC = 0.0" />
          <Expression Expression="sysml_state_prevTempValid = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_thresholdDegC" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_prevTempValid" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="double" />
      <Input Name="io_3" Type="double" />
      <Input Name="io_4" Type="double" />
      <Input Name="io_5" Type="bool" />
      <Output Name="io_1" Type="bool" />
      <Output Name="io_2" Type="int" />
      <Output Name="io_6" Type="int" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="double" Source="io_0" />
          <Input Name="io_3" Type="double" Source="io_3" />
          <Input Name="io_4" Type="double" Source="io_4" />
          <Input Name="io_5" Type="bool" Source="io_5" />
          <Output Name="io_1" Type="bool" />
          <Output Name="io_2" Type="int" />
          <Output Name="io_6" Type="int" />
          <LocalVariable Name="sysml_conditional_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="int" />
          <LocalVariable Name="sysml_conditional_2" Type="int" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_conditional_4" Type="int" />
          <Expression Expression="sysml_state_thresholdDegC = io_0" />
          <If Condition="io_5">
            <Expression Expression="sysml_state_prevTempValid = true" />
          </If>
          <Else>
            <Expression Expression="sysml_state_prevTempValid = false" />
          </Else>
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <If Condition="io_5">
            <Expression Expression="sysml_conditional_0 = io_3 &gt; sysml_state_thresholdDegC" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_0 = false" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_0" />
          <LocalVariable Name="sysml_value_1" Type="int" />
          <If Condition="io_5">
            <If Condition="io_3 &gt; sysml_state_thresholdDegC">
              <Expression Expression="sysml_conditional_2 = 1000" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_2 = 0" />
            </Else>
            <Expression Expression="sysml_conditional_1 = sysml_conditional_2" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_1 = 0" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_1" />
          <LocalVariable Name="sysml_value_2" Type="int" />
          <Expression Expression="sysml_lazy_3 = io_5" />
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_lazy_3 = io_3 &gt; sysml_state_thresholdDegC" />
          </If>
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_conditional_4 = 1" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_4 = 0" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_4" />
          <Expression Expression="*io_1 = sysml_value_0" />
          <Expression Expression="*io_2 = sysml_value_1" />
          <Expression Expression="*io_6 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>