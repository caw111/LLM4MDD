<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_ledState = false" />
          <Expression Expression="sysml_state_pwmValue = 0" />
          <Expression Expression="sysml_state_buzzerHz = 0" />
          <Expression Expression="sysml_state_prevPressed = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_ledState" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_pwmValue" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_buzzerHz" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_prevPressed" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_3" Type="bool" />
      <Output Name="io_0" Type="bool" />
      <Output Name="io_1" Type="double" />
      <Output Name="io_2" Type="int" />
      <Output Name="serial_0_trigger" Type="bool" />
      <Output Name="serial_0_value_0" Type="bool" />
      <Output Name="serial_0_value_1" Type="int" />
      <Output Name="serial_0_value_2" Type="int" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_3" Type="bool" Source="io_3" />
          <Output Name="io_0" Type="bool" />
          <Output Name="io_1" Type="double" />
          <Output Name="io_2" Type="int" />
          <Output Name="serial_0_trigger" Type="bool" />
          <Output Name="serial_0_value_0" Type="bool" />
          <Output Name="serial_0_value_1" Type="int" />
          <Output Name="serial_0_value_2" Type="int" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <Expression Expression="sysml_lazy_0 = io_3" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_prevPressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_prevPressed = true" />
          </If>
          <Else>
            <Expression Expression="sysml_state_prevPressed = false" />
          </Else>
          <Expression Expression="sysml_lazy_1 = io_3" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = !sysml_state_prevPressed" />
          </If>
          <If Condition="!sysml_lazy_1" />
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <Expression Expression="sysml_value_0 = sysml_state_ledState" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <Expression Expression="sysml_value_1 = (sysml_state_pwmValue * 1.0)" />
          <LocalVariable Name="sysml_value_2" Type="int" />
          <Expression Expression="sysml_value_2 = sysml_state_buzzerHz" />
          <LocalVariable Name="sysml_value_3" Type="bool" />
          <Expression Expression="sysml_lazy_2 = io_3" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = !sysml_state_prevPressed" />
          </If>
          <Expression Expression="sysml_value_3 = sysml_lazy_2" />
          <LocalVariable Name="sysml_value_4" Type="bool" />
          <Expression Expression="sysml_value_4 = sysml_state_ledState" />
          <LocalVariable Name="sysml_value_5" Type="int" />
          <Expression Expression="sysml_value_5 = sysml_state_pwmValue" />
          <LocalVariable Name="sysml_value_6" Type="int" />
          <Expression Expression="sysml_value_6 = sysml_state_buzzerHz" />
          <Expression Expression="*io_0 = sysml_value_0" />
          <Expression Expression="*io_1 = sysml_value_1" />
          <Expression Expression="*io_2 = sysml_value_2" />
          <Expression Expression="*serial_0_trigger = sysml_value_3" />
          <Expression Expression="*serial_0_value_0 = sysml_value_4" />
          <Expression Expression="*serial_0_value_1 = sysml_value_5" />
          <Expression Expression="*serial_0_value_2 = sysml_value_6" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>