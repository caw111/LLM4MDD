<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_previousPressed = false" />
          <Expression Expression="sysml_state_muted = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_previousPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_muted" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_3" Type="double" />
      <Input Name="io_4" Type="bool" />
      <Output Name="io_1" Type="bool" />
      <Output Name="io_2" Type="int" />
      <Output Name="serial_0_trigger" Type="bool" />
      <Output Name="serial_0_value_0" Type="double" />
      <Output Name="serial_0_value_1" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_3" Type="double" Source="io_3" />
          <Input Name="io_4" Type="bool" Source="io_4" />
          <Output Name="io_1" Type="bool" />
          <Output Name="io_2" Type="int" />
          <Output Name="serial_0_trigger" Type="bool" />
          <Output Name="serial_0_value_0" Type="double" />
          <Output Name="serial_0_value_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="bool" />
          <LocalVariable Name="sysml_conditional_2" Type="int" />
          <LocalVariable Name="sysml_conditional_3" Type="int" />
          <LocalVariable Name="sysml_conditional_4" Type="int" />
          <LocalVariable Name="sysml_conditional_5" Type="int" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_previousPressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_muted = (!sysml_state_muted)" />
          </If>
          <Expression Expression="sysml_state_previousPressed = io_0" />
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <If Condition="sysml_state_muted">
            <Expression Expression="sysml_conditional_1 = true" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_1 = false" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_1" />
          <LocalVariable Name="sysml_value_1" Type="int" />
          <If Condition="sysml_state_muted">
            <Expression Expression="sysml_conditional_2 = 0" />
          </If>
          <Else>
            <If Condition="io_3 &lt; 10.0">
              <Expression Expression="sysml_conditional_3 = 2000" />
            </If>
            <Else>
              <If Condition="io_3 &lt; 20.0">
                <Expression Expression="sysml_conditional_4 = 1500" />
              </If>
              <Else>
                <If Condition="io_3 &lt; 30.0">
                  <Expression Expression="sysml_conditional_5 = 1000" />
                </If>
                <Else>
                  <Expression Expression="sysml_conditional_5 = 500" />
                </Else>
                <Expression Expression="sysml_conditional_4 = sysml_conditional_5" />
              </Else>
              <Expression Expression="sysml_conditional_3 = sysml_conditional_4" />
            </Else>
            <Expression Expression="sysml_conditional_2 = sysml_conditional_3" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_2" />
          <LocalVariable Name="sysml_value_2" Type="bool" />
          <Expression Expression="sysml_value_2 = io_4" />
          <LocalVariable Name="sysml_value_3" Type="double" />
          <Expression Expression="sysml_value_3 = io_3" />
          <LocalVariable Name="sysml_value_4" Type="bool" />
          <Expression Expression="sysml_value_4 = io_4" />
          <Expression Expression="*io_1 = sysml_value_0" />
          <Expression Expression="*io_2 = sysml_value_1" />
          <Expression Expression="*serial_0_trigger = sysml_value_2" />
          <Expression Expression="*serial_0_value_0 = sysml_value_3" />
          <Expression Expression="*serial_0_value_1 = sysml_value_4" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>