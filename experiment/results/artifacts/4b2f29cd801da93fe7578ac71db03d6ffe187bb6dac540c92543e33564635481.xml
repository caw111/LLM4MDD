<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_previousPressed = false" />
          <Expression Expression="sysml_state_autoMode = true" />
          <Expression Expression="sysml_state_calibratedOffset = 0.0" />
          <Expression Expression="sysml_state_targetAngle = 90.0" />
          <Expression Expression="sysml_state_chargingLowActive = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_previousPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_autoMode" Type="bool" DefaultValue="true" />
    <GlobalVariable Name="sysml_state_calibratedOffset" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_targetAngle" Type="double" DefaultValue="90.0" />
    <GlobalVariable Name="sysml_state_chargingLowActive" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="double" />
      <Input Name="io_1" Type="double" />
      <Input Name="io_2" Type="double" />
      <Input Name="io_3" Type="bool" />
      <Output Name="io_4" Type="double" />
      <Output Name="io_5" Type="int" />
      <Output Name="io_6" Type="int" />
      <Output Name="serial_0_trigger" Type="bool" />
      <Output Name="serial_0_value_0" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="double" Source="io_0" />
          <Input Name="io_1" Type="double" Source="io_1" />
          <Input Name="io_2" Type="double" Source="io_2" />
          <Input Name="io_3" Type="bool" Source="io_3" />
          <Output Name="io_4" Type="double" />
          <Output Name="io_5" Type="int" />
          <Output Name="io_6" Type="int" />
          <Output Name="serial_0_trigger" Type="bool" />
          <Output Name="serial_0_value_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="double" />
          <LocalVariable Name="sysml_conditional_2" Type="double" />
          <LocalVariable Name="sysml_conditional_3" Type="double" />
          <LocalVariable Name="sysml_conditional_4" Type="int" />
          <LocalVariable Name="sysml_conditional_5" Type="int" />
          <Expression Expression="sysml_lazy_0 = io_3" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_previousPressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_autoMode = (!sysml_state_autoMode)" />
          </If>
          <If Condition="io_0 &gt; io_1">
            <Expression Expression="sysml_conditional_1 = 45.0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_1 = 135.0" />
          </Else>
          <Expression Expression="sysml_state_targetAngle = sysml_conditional_1" />
          <If Condition="sysml_state_autoMode">
            <Expression Expression="sysml_conditional_2 = 0.0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_2 = 15.0" />
          </Else>
          <Expression Expression="sysml_state_calibratedOffset = sysml_conditional_2" />
          <Expression Expression="sysml_state_chargingLowActive = (io_2 &lt; 500.0)" />
          <Expression Expression="sysml_state_previousPressed = io_3" />
          <LocalVariable Name="sysml_value_0" Type="double" />
          <If Condition="sysml_state_autoMode">
            <Expression Expression="sysml_conditional_3 = sysml_state_targetAngle" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_3 = sysml_state_targetAngle + sysml_state_calibratedOffset" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_3" />
          <LocalVariable Name="sysml_value_1" Type="int" />
          <If Condition="sysml_state_autoMode">
            <Expression Expression="sysml_conditional_4 = 0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_4 = 1" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_4" />
          <LocalVariable Name="sysml_value_2" Type="int" />
          <If Condition="sysml_state_chargingLowActive">
            <Expression Expression="sysml_conditional_5 = 1000" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_5 = 0" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_5" />
          <LocalVariable Name="sysml_value_3" Type="bool" />
          <Expression Expression="sysml_value_3 = sysml_state_chargingLowActive" />
          <LocalVariable Name="sysml_value_4" Type="bool" />
          <Expression Expression="sysml_value_4 = true" />
          <Expression Expression="*io_4 = sysml_value_0" />
          <Expression Expression="*io_5 = sysml_value_1" />
          <Expression Expression="*io_6 = sysml_value_2" />
          <Expression Expression="*serial_0_trigger = sysml_value_3" />
          <Expression Expression="*serial_0_value_0 = sysml_value_4" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>