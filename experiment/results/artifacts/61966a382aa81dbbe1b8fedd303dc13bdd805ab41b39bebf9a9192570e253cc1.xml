<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_phaseIndex = 0" />
          <Expression Expression="sysml_state_phaseElapsedMs = 0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_phaseIndex" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_phaseElapsedMs" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_3" Type="int" />
      <Output Name="io_0" Type="double" />
      <Output Name="io_1" Type="double" />
      <Output Name="io_2" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_3" Type="int" Source="io_3" />
          <Output Name="io_0" Type="double" />
          <Output Name="io_1" Type="double" />
          <Output Name="io_2" Type="double" />
          <LocalVariable Name="sysml_conditional_0" Type="double" />
          <LocalVariable Name="sysml_conditional_1" Type="double" />
          <LocalVariable Name="sysml_conditional_2" Type="double" />
          <LocalVariable Name="sysml_conditional_3" Type="double" />
          <LocalVariable Name="sysml_conditional_4" Type="double" />
          <LocalVariable Name="sysml_conditional_5" Type="double" />
          <LocalVariable Name="sysml_conditional_6" Type="double" />
          <LocalVariable Name="sysml_conditional_7" Type="double" />
          <LocalVariable Name="sysml_conditional_8" Type="double" />
          <LocalVariable Name="sysml_conditional_9" Type="double" />
          <LocalVariable Name="sysml_conditional_10" Type="double" />
          <LocalVariable Name="sysml_conditional_11" Type="double" />
          <LocalVariable Name="sysml_conditional_12" Type="double" />
          <LocalVariable Name="sysml_conditional_13" Type="double" />
          <LocalVariable Name="sysml_conditional_14" Type="double" />
          <Expression Expression="sysml_state_phaseElapsedMs = (sysml_state_phaseElapsedMs + io_3)" />
          <If Condition="(sysml_state_phaseElapsedMs &gt;= 2000)">
            <Expression Expression="sysml_state_phaseElapsedMs = (sysml_state_phaseElapsedMs - 2000)" />
            <Expression Expression="sysml_state_phaseIndex = (sysml_state_phaseIndex + 1)" />
            <If Condition="(sysml_state_phaseIndex &gt;= 6)">
              <Expression Expression="sysml_state_phaseIndex = 0" />
            </If>
          </If>
          <LocalVariable Name="sysml_value_0" Type="double" />
          <If Condition="sysml_state_phaseIndex == 0">
            <Expression Expression="sysml_conditional_0 = 0.0" />
          </If>
          <Else>
            <If Condition="sysml_state_phaseIndex == 1">
              <Expression Expression="sysml_conditional_1 = 45.0" />
            </If>
            <Else>
              <If Condition="sysml_state_phaseIndex == 2">
                <Expression Expression="sysml_conditional_2 = 90.0" />
              </If>
              <Else>
                <If Condition="sysml_state_phaseIndex == 3">
                  <Expression Expression="sysml_conditional_3 = 135.0" />
                </If>
                <Else>
                  <If Condition="sysml_state_phaseIndex == 4">
                    <Expression Expression="sysml_conditional_4 = 180.0" />
                  </If>
                  <Else>
                    <Expression Expression="sysml_conditional_4 = 0.0" />
                  </Else>
                  <Expression Expression="sysml_conditional_3 = sysml_conditional_4" />
                </Else>
                <Expression Expression="sysml_conditional_2 = sysml_conditional_3" />
              </Else>
              <Expression Expression="sysml_conditional_1 = sysml_conditional_2" />
            </Else>
            <Expression Expression="sysml_conditional_0 = sysml_conditional_1" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_0" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <If Condition="sysml_state_phaseIndex == 0">
            <Expression Expression="sysml_conditional_5 = 0.0" />
          </If>
          <Else>
            <If Condition="sysml_state_phaseIndex == 1">
              <Expression Expression="sysml_conditional_6 = 45.0" />
            </If>
            <Else>
              <If Condition="sysml_state_phaseIndex == 2">
                <Expression Expression="sysml_conditional_7 = 90.0" />
              </If>
              <Else>
                <If Condition="sysml_state_phaseIndex == 3">
                  <Expression Expression="sysml_conditional_8 = 135.0" />
                </If>
                <Else>
                  <If Condition="sysml_state_phaseIndex == 4">
                    <Expression Expression="sysml_conditional_9 = 180.0" />
                  </If>
                  <Else>
                    <Expression Expression="sysml_conditional_9 = 0.0" />
                  </Else>
                  <Expression Expression="sysml_conditional_8 = sysml_conditional_9" />
                </Else>
                <Expression Expression="sysml_conditional_7 = sysml_conditional_8" />
              </Else>
              <Expression Expression="sysml_conditional_6 = sysml_conditional_7" />
            </Else>
            <Expression Expression="sysml_conditional_5 = sysml_conditional_6" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_5" />
          <LocalVariable Name="sysml_value_2" Type="double" />
          <If Condition="sysml_state_phaseIndex == 0">
            <Expression Expression="sysml_conditional_10 = 0.0" />
          </If>
          <Else>
            <If Condition="sysml_state_phaseIndex == 1">
              <Expression Expression="sysml_conditional_11 = 90.0" />
            </If>
            <Else>
              <If Condition="sysml_state_phaseIndex == 2">
                <Expression Expression="sysml_conditional_12 = 135.0" />
              </If>
              <Else>
                <If Condition="sysml_state_phaseIndex == 3">
                  <Expression Expression="sysml_conditional_13 = 180.0" />
                </If>
                <Else>
                  <If Condition="sysml_state_phaseIndex == 4">
                    <Expression Expression="sysml_conditional_14 = 0.0" />
                  </If>
                  <Else>
                    <Expression Expression="sysml_conditional_14 = 45.0" />
                  </Else>
                  <Expression Expression="sysml_conditional_13 = sysml_conditional_14" />
                </Else>
                <Expression Expression="sysml_conditional_12 = sysml_conditional_13" />
              </Else>
              <Expression Expression="sysml_conditional_11 = sysml_conditional_12" />
            </Else>
            <Expression Expression="sysml_conditional_10 = sysml_conditional_11" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_10" />
          <Expression Expression="*io_0 = sysml_value_0" />
          <Expression Expression="*io_1 = sysml_value_1" />
          <Expression Expression="*io_2 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>