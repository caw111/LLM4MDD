/* Update function of CompositeActor named "ProgramPage1" */
void ProgramPage1(bool io_0, double* io_1, double* io_2, double* io_3) {
    static unsigned index=0;
    static bool previous=false,pending=false,started=false;
    static unsigned long began=0;
    if(io_0&&!previous) pending=true;
    if(pending && (!started || (unsigned long)(millis()-began)>=2000)) {index=(index+1)%5;pending=false;started=true;began=millis();}
