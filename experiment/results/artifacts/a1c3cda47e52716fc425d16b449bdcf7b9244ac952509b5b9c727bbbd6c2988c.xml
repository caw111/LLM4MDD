<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_manualMode = false" />
          <Expression Expression="sysml_state_previousPressed = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_manualMode" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_previousPressed" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="double" />
      <Input Name="io_1" Type="double" />
      <Input Name="io_2" Type="bool" />
      <Input Name="io_4" Type="bool" />
      <Output Name="io_3" Type="double" />
      <Output Name="io_5" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="double" Source="io_0" />
          <Input Name="io_1" Type="double" Source="io_1" />
          <Input Name="io_2" Type="bool" Source="io_2" />
          <Input Name="io_4" Type="bool" Source="io_4" />
          <Output Name="io_3" Type="double" />
          <Output Name="io_5" Type="bool" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="double" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_conditional_4" Type="double" />
          <Expression Expression="sysml_lazy_0 = io_4" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_previousPressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_manualMode = (!sysml_state_manualMode)" />
          </If>
          <Expression Expression="sysml_state_previousPressed = io_4" />
          <LocalVariable Name="sysml_value_0" Type="double" />
          <If Condition="sysml_state_manualMode">
            <Expression Expression="sysml_conditional_1 = 1023.0" />
          </If>
          <Else>
            <Expression Expression="sysml_lazy_2 = io_0 &lt; 512.0" />
            <If Condition="sysml_lazy_2">
              <Expression Expression="sysml_lazy_2 = io_2" />
            </If>
            <Expression Expression="sysml_lazy_3 = sysml_lazy_2" />
            <If Condition="sysml_lazy_3">
              <Expression Expression="sysml_lazy_3 = true == true" />
            </If>
            <If Condition="sysml_lazy_3">
              <Expression Expression="sysml_conditional_4 = 1023.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_4 = 0.0" />
            </Else>
            <Expression Expression="sysml_conditional_1 = sysml_conditional_4" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_1" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <Expression Expression="sysml_value_1 = sysml_state_manualMode" />
          <Expression Expression="*io_3 = sysml_value_0" />
          <Expression Expression="*io_5 = sysml_value_1" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>