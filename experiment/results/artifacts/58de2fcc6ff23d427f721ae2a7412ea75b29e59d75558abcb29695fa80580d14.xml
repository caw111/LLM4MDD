<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_prevMinDeg = 0.0" />
          <Expression Expression="sysml_state_prevMaxDeg = 0.0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_prevMinDeg" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_prevMaxDeg" Type="double" DefaultValue="0.0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="double" />
      <Input Name="io_1" Type="double" />
      <Input Name="io_2" Type="double" />
      <Output Name="io_3" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="double" Source="io_0" />
          <Input Name="io_1" Type="double" Source="io_1" />
          <Input Name="io_2" Type="double" Source="io_2" />
          <Output Name="io_3" Type="double" />
          <LocalVariable Name="sysml_conditional_0" Type="double" />
          <LocalVariable Name="sysml_conditional_1" Type="double" />
          <LocalVariable Name="sysml_conditional_2" Type="double" />
          <LocalVariable Name="sysml_arithmetic_3" Type="double" />
          <If Condition="io_0 &gt; 0.0">
            <Expression Expression="sysml_conditional_0 = ((double) (io_0 * 90.0)) / 1023.0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_0 = 0.0" />
          </Else>
          <Expression Expression="sysml_state_prevMinDeg = sysml_conditional_0" />
          <If Condition="io_1 &gt; 0.0">
            <Expression Expression="sysml_conditional_1 = 90.0 + (((double) (io_1 * 90.0)) / 1023.0)" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_1 = 90.0" />
          </Else>
          <Expression Expression="sysml_state_prevMaxDeg = sysml_conditional_1" />
          <If Condition="(sysml_state_prevMinDeg &gt; sysml_state_prevMaxDeg)">
            <Expression Expression="sysml_state_prevMinDeg = sysml_state_prevMaxDeg" />
            <Expression Expression="sysml_state_prevMaxDeg = sysml_state_prevMinDeg" />
          </If>
          <LocalVariable Name="sysml_value_0" Type="double" />
          <If Condition="sysml_state_prevMaxDeg &gt; sysml_state_prevMinDeg">
            <Expression Expression="sysml_arithmetic_3 = sysml_state_prevMaxDeg - sysml_state_prevMinDeg" />
            <Expression Expression="sysml_conditional_2 = sysml_state_prevMinDeg + (((double) (io_2 * sysml_arithmetic_3)) / 1023.0)" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_2 = sysml_state_prevMinDeg" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_2" />
          <Expression Expression="*io_3 = sysml_value_0" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>