<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_accumulatedMs = 0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_accumulatedMs" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_1" Type="int" />
      <Output Name="io_0" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_1" Type="int" Source="io_1" />
          <Output Name="io_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="bool" />
          <LocalVariable Name="sysml_conditional_2" Type="bool" />
          <Expression Expression="sysml_state_accumulatedMs = (sysml_state_accumulatedMs + io_1)" />
          <If Condition="(sysml_state_accumulatedMs &gt;= 9000)">
            <Expression Expression="sysml_state_accumulatedMs = (sysml_state_accumulatedMs - 9000)" />
          </If>
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <If Condition="sysml_state_accumulatedMs &lt; 1000">
            <Expression Expression="sysml_conditional_0 = true" />
          </If>
          <Else>
            <If Condition="sysml_state_accumulatedMs &lt; 3000">
              <Expression Expression="sysml_conditional_1 = false" />
            </If>
            <Else>
              <If Condition="sysml_state_accumulatedMs &lt; 6000">
                <Expression Expression="sysml_conditional_2 = true" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_2 = false" />
              </Else>
              <Expression Expression="sysml_conditional_1 = sysml_conditional_2" />
            </Else>
            <Expression Expression="sysml_conditional_0 = sysml_conditional_1" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_0" />
          <Expression Expression="*io_0 = sysml_value_0" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>