{
  "version": 1,
  "board": "arduino:avr:uno",
  "control_period_ms": 5,
  "planning_notes": [
    "板端为 Arduino Uno；HC-SR04 硬件接线按要求使用 Trig=D8、Echo=D9。D13 控制 LED，D6 输出蜂鸣器告警（通过 tone_output）。",
    "未提供蜂鸣器报警的具体音频频率/持续时间/是否连续鸣叫；这些均属于 SysML 业务逻辑，当前仅注册 tone 输出端口，并在距离条件满足时由模型驱动 tone 输出的频率与是否置为静默。",
    "阈值“距离 < 20cm 点亮/报警，否则关闭”的比较与执行时序属于 SysML 逻辑，不在本接口提案中表达。",
    "控制周期选择为 5ms（调度粒度），超声采样周期与响应预算（包括脉冲测量时间）由应用在 SysML 中按 catalog 约束与响应预算自动处理；本提案仅声明采集与有效性保持策略。"
  ],
  "interfaces": [
    {
      "name": "io_0",
      "direction": "output",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "HC-SR04 distance < 20cm LED on (报警指示灯)",
      "sample_period_ms": 5,
      "device": "digital_output",
      "hardware": "{\"active_high\": true, \"kind\": \"digital_output\", \"pin\": \"D13\"}",
      "binding": {
        "kind": "digital_output",
        "active_high": true,
        "pin": "D13"
      },
      "model_semantics": {
        "kind": "digital_boolean",
        "true_level": "HIGH",
        "false_level": "LOW"
      }
    },
    {
      "name": "io_1",
      "direction": "output",
      "type": "i32",
      "unit": "Hz",
      "initial": 0,
      "meaning": "HC-SR04 distance < 20cm buzzer alarm (报警蜂鸣器)",
      "sample_period_ms": 5,
      "device": "tone_output",
      "hardware": "{\"invalid_policy\": \"silence\", \"kind\": \"tone_output\", \"pin\": \"D6\"}",
      "binding": {
        "kind": "tone_output",
        "invalid_policy": "silence",
        "pin": "D6"
      }
    },
    {
      "name": "io_2",
      "direction": "input",
      "type": "f64",
      "unit": "cm",
      "initial": 0,
      "meaning": "Measured distance from HC-SR04 (cm)",
      "sample_period_ms": 60,
      "device": "ultrasonic_distance",
      "hardware": "{\"echo_pin\": \"D9\", \"invalid_policy\": \"hold_last_valid\", \"kind\": \"ultrasonic_distance\", \"sensor\": \"HC-SR04\", \"timeout_us\": 25000, \"trigger_pin\": \"D8\"}",
      "binding": {
        "kind": "ultrasonic_distance",
        "sensor": "HC-SR04",
        "timeout_us": 25000,
        "invalid_policy": "hold_last_valid",
        "echo_pin": "D9",
        "trigger_pin": "D8"
      }
    },
    {
      "name": "io_3",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "HC-SR04 measurement validity",
      "sample_period_ms": 60,
      "device": "ultrasonic_valid",
      "hardware": "{\"echo_pin\": \"D9\", \"invalid_policy\": \"hold_last_valid\", \"kind\": \"ultrasonic_valid\", \"sensor\": \"HC-SR04\", \"timeout_us\": 25000, \"trigger_pin\": \"D8\"}",
      "binding": {
        "kind": "ultrasonic_valid",
        "sensor": "HC-SR04",
        "timeout_us": 25000,
        "invalid_policy": "hold_last_valid",
        "echo_pin": "D9",
        "trigger_pin": "D8"
      }
    }
  ],
