{
  "version": 1,
  "board": "arduino:avr:uno",
  "control_period_ms": 10,
  "planning_notes": [
    "Board is arduino:avr:uno as required.",
    "D8/D9 are configured together for one HC-SR04 ranging acquisition (distance + validity) with a bounded timeout; the model decides alarm actions using validity.",
    "TM1637 displays the current alarm threshold value; numeric selection and any clamping/wrap belong in the SysML model.",
    "Button (D2) is modeled as pressed->true; the SysML model handles mode switching debouncing logic and edge detection.",
    "Potentiometer (A0) is sampled as a raw analog input; conversion from ADC to centimeters (manual threshold) belongs in the SysML model."
  ],
  "interfaces": [
    {
      "name": "io_0",
      "direction": "input",
      "type": "f64",
      "unit": "adc_count",
      "initial": 0,
      "meaning": "Manual alarm threshold potentiometer ADC",
      "sample_period_ms": 10,
      "device": "analog_input",
      "hardware": "{\"kind\": \"analog_input\", \"offset\": 0.0, \"pin\": \"A0\", \"scale\": 1.0}",
      "binding": {
        "kind": "analog_input",
        "scale": 1.0,
        "offset": 0.0,
        "pin": "A0"
      }
    },
