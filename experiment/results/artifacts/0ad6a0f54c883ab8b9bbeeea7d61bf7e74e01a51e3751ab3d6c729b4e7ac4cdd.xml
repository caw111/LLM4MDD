<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_accum3sMs = 0" />
          <Expression Expression="sysml_state_consecCloseCount = 0" />
          <Expression Expression="sysml_state_prevDhtTemp = 0.0" />
          <Expression Expression="sysml_state_prevDhtHum = 0.0" />
          <Expression Expression="sysml_state_prevDistCm = 0.0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_accum3sMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_consecCloseCount" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_prevDhtTemp" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_prevDhtHum" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_prevDistCm" Type="double" DefaultValue="0.0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_1" Type="double" />
      <Input Name="io_2" Type="double" />
      <Input Name="io_3" Type="bool" />
      <Input Name="io_4" Type="double" />
      <Input Name="io_5" Type="bool" />
      <Input Name="io_6" Type="int" />
      <Input Name="io_7" Type="int" />
      <Input Name="io_7_valid" Type="bool" />
      <Output Name="io_0" Type="bool" />
      <Output Name="io_8" Type="bool" />
      <Output Name="serial_0_trigger" Type="bool" />
      <Output Name="serial_0_value_0" Type="double" />
      <Output Name="serial_0_value_1" Type="double" />
      <Output Name="serial_0_value_2" Type="double" />
      <Output Name="serial_0_value_3" Type="bool" />
      <Output Name="serial_0_value_4" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_1" Type="double" Source="io_1" />
          <Input Name="io_2" Type="double" Source="io_2" />
          <Input Name="io_3" Type="bool" Source="io_3" />
          <Input Name="io_4" Type="double" Source="io_4" />
          <Input Name="io_5" Type="bool" Source="io_5" />
          <Input Name="io_6" Type="int" Source="io_6" />
          <Input Name="io_7" Type="int" Source="io_7" />
          <Input Name="io_7_valid" Type="bool" Source="io_7_valid" />
          <Output Name="io_0" Type="bool" />
          <Output Name="io_8" Type="bool" />
          <Output Name="serial_0_trigger" Type="bool" />
          <Output Name="serial_0_value_0" Type="double" />
          <Output Name="serial_0_value_1" Type="double" />
          <Output Name="serial_0_value_2" Type="double" />
          <Output Name="serial_0_value_3" Type="bool" />
          <Output Name="serial_0_value_4" Type="bool" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_lazy_4" Type="bool" />
          <LocalVariable Name="sysml_conditional_5" Type="double" />
          <LocalVariable Name="sysml_conditional_6" Type="double" />
          <LocalVariable Name="sysml_conditional_7" Type="double" />
          <Expression Expression="sysml_state_accum3sMs = (sysml_state_accum3sMs + io_6)" />
          <If Condition="(sysml_state_accum3sMs &gt;= 3000)">
            <Expression Expression="sysml_state_accum3sMs = (sysml_state_accum3sMs - 3000)" />
          </If>
          <If Condition="io_5">
            <If Condition="(io_4 &lt; 20.0)">
              <Expression Expression="sysml_state_consecCloseCount = (sysml_state_consecCloseCount + 1)" />
            </If>
            <Else>
              <Expression Expression="sysml_state_consecCloseCount = 0" />
            </Else>
          </If>
          <Else>
            <Expression Expression="sysml_state_consecCloseCount = 0" />
          </Else>
          <If Condition="io_3">
            <Expression Expression="sysml_state_prevDhtTemp = io_1" />
            <Expression Expression="sysml_state_prevDhtHum = io_2" />
          </If>
          <If Condition="io_5">
            <Expression Expression="sysml_state_prevDistCm = io_4" />
          </If>
          <If Condition="(sysml_state_consecCloseCount &gt; 3)">
            <Expression Expression="sysml_state_consecCloseCount = 3" />
          </If>
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <Expression Expression="sysml_lazy_0 = sysml_state_consecCloseCount &gt;= 3" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = io_5" />
          </If>
          <Expression Expression="sysml_value_0 = sysml_lazy_0" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <Expression Expression="sysml_lazy_1 = sysml_state_consecCloseCount &gt;= 3" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = io_5" />
          </If>
          <Expression Expression="sysml_lazy_2 = sysml_lazy_1" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = sysml_state_accum3sMs &gt;= 0" />
          </If>
          <Expression Expression="sysml_value_1 = sysml_lazy_2" />
          <LocalVariable Name="sysml_value_2" Type="bool" />
          <Expression Expression="sysml_lazy_3 = sysml_state_consecCloseCount &gt;= 0" />
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_lazy_4 = sysml_state_accum3sMs &gt;= 3000" />
            <If Condition="!sysml_lazy_4">
              <Expression Expression="sysml_lazy_4 = (sysml_state_accum3sMs + io_6) &gt;= 3000" />
            </If>
            <Expression Expression="sysml_lazy_3 = sysml_lazy_4" />
          </If>
          <Expression Expression="sysml_value_2 = sysml_lazy_3" />
          <LocalVariable Name="sysml_value_3" Type="double" />
          <If Condition="io_3">
            <Expression Expression="sysml_conditional_5 = io_1" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_5 = sysml_state_prevDhtTemp" />
          </Else>
          <Expression Expression="sysml_value_3 = sysml_conditional_5" />
          <LocalVariable Name="sysml_value_4" Type="double" />
          <If Condition="io_3">
            <Expression Expression="sysml_conditional_6 = io_2" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_6 = sysml_state_prevDhtHum" />
          </Else>
          <Expression Expression="sysml_value_4 = sysml_conditional_6" />
          <LocalVariable Name="sysml_value_5" Type="double" />
          <If Condition="io_5">
            <Expression Expression="sysml_conditional_7 = io_4" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_7 = sysml_state_prevDistCm" />
          </Else>
          <Expression Expression="sysml_value_5 = sysml_conditional_7" />
          <LocalVariable Name="sysml_value_6" Type="bool" />
          <Expression Expression="sysml_value_6 = io_5" />
          <LocalVariable Name="sysml_value_7" Type="bool" />
          <Expression Expression="sysml_value_7 = io_3" />
          <Expression Expression="*io_0 = sysml_value_0" />
          <Expression Expression="*io_8 = sysml_value_1" />
          <Expression Expression="*serial_0_trigger = sysml_value_2" />
          <Expression Expression="*serial_0_value_0 = sysml_value_3" />
          <Expression Expression="*serial_0_value_1 = sysml_value_4" />
          <Expression Expression="*serial_0_value_2 = sysml_value_5" />
          <Expression Expression="*serial_0_value_3 = sysml_value_6" />
          <Expression Expression="*serial_0_value_4 = sysml_value_7" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>