      "binding": {
        "kind": "ultrasonic_distance",
        "sensor": "HC-SR04",
        "timeout_us": 30000,
        "invalid_policy": "hold_last_valid",
        "echo_pin": "D9",
        "trigger_pin": "D8"
      }
    },
