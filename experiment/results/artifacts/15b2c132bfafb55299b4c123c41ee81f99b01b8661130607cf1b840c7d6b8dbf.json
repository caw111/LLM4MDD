{
  "version": 1,
  "board": "arduino:avr:uno",
  "control_period_ms": 10,
  "planning_notes": [
    "Board is arduino:avr:uno. Wiring uses Trig=D8, Echo=D9, buzzer tone output on D6, mute button on D2, LED on D13 as provided.",
    "No additional PWM/servo/display/resource allocations are requested; tone_output on D6 avoids Uno PWM conflicts noted for other pins.",
    "Ultrasonic sample_period_ms is set to 60ms (>=60ms and a control-period multiple of 10ms) with timeout_us=30000 within 25000..60000; validity uses hold_last_valid and out-of-range/timeout makes validity false while retaining previous distance.",
    "Serial uses baud 9600 with framing line_or_idle and idle_timeout_ms=20 as specified; report cadence and mute behavior are modeled in SysML and only represented here by a Boolean report gate trigger.",
    "Button model value is true when pressed; LED is intended to be constant ON during mute, otherwise behavior is handled in SysML (this request only provides the physical output).",
    "Control scheduling granularity is 10ms to support buzzer frequency updates and serial gating without fabricating business timers in the device requests."
  ],
  "interfaces": [
    {
      "name": "io_0",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "Mute/Unmute button (model true when pressed)",
      "sample_period_ms": 10,
      "device": "digital_input",
      "hardware": "{\"active_high\": true, \"kind\": \"digital_input\", \"pin\": \"D2\", \"pullup\": false}",
      "binding": {
        "kind": "digital_input",
        "active_high": true,
        "pullup": false,
        "pin": "D2"
