<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_servoAngleDeg = 0.0" />
          <Expression Expression="sysml_state_directionUp = true" />
          <Expression Expression="sysml_state_started = false" />
          <Expression Expression="sysml_state_reportPending = true" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_servoAngleDeg" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_directionUp" Type="bool" DefaultValue="true" />
    <GlobalVariable Name="sysml_state_started" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_reportPending" Type="bool" DefaultValue="true" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Output Name="io_0" Type="double" />
      <Output Name="serial_0_trigger" Type="bool" />
      <Output Name="serial_0_value_0" Type="int" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Output Name="io_0" Type="double" />
          <Output Name="serial_0_trigger" Type="bool" />
          <Output Name="serial_0_value_0" Type="int" />
          <LocalVariable Name="sysml_conditional_0" Type="double" />
          <LocalVariable Name="sysml_conditional_1" Type="double" />
          <LocalVariable Name="sysml_conditional_2" Type="int" />
          <If Condition="(!sysml_state_started)">
            <Expression Expression="sysml_state_started = true" />
            <Expression Expression="sysml_state_directionUp = true" />
            <Expression Expression="sysml_state_servoAngleDeg = 0.0" />
            <Expression Expression="sysml_state_reportPending = true" />
          </If>
          <If Condition="sysml_state_directionUp">
            <If Condition="sysml_state_servoAngleDeg &gt;= 180.0">
              <Expression Expression="sysml_conditional_0 = 180.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_0 = sysml_state_servoAngleDeg + 1.0" />
            </Else>
            <Expression Expression="sysml_state_servoAngleDeg = sysml_conditional_0" />
            <If Condition="(sysml_state_servoAngleDeg &gt;= 179.0)">
              <Expression Expression="sysml_state_directionUp = false" />
              <Expression Expression="sysml_state_reportPending = true" />
            </If>
            <Else>
              <Expression Expression="sysml_state_reportPending = false" />
            </Else>
          </If>
          <Else>
            <If Condition="sysml_state_servoAngleDeg &lt;= 0.0">
              <Expression Expression="sysml_conditional_1 = 0.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_1 = sysml_state_servoAngleDeg - 1.0" />
            </Else>
            <Expression Expression="sysml_state_servoAngleDeg = sysml_conditional_1" />
            <If Condition="(sysml_state_servoAngleDeg &lt;= 1.0)">
              <Expression Expression="sysml_state_directionUp = true" />
              <Expression Expression="sysml_state_reportPending = true" />
            </If>
            <Else>
              <Expression Expression="sysml_state_reportPending = false" />
            </Else>
          </Else>
          <LocalVariable Name="sysml_value_0" Type="double" />
          <Expression Expression="sysml_value_0 = sysml_state_servoAngleDeg" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <Expression Expression="sysml_value_1 = sysml_state_reportPending" />
          <LocalVariable Name="sysml_value_2" Type="int" />
          <If Condition="sysml_state_servoAngleDeg &lt; ((double) ((int) sysml_state_servoAngleDeg))">
            <Expression Expression="sysml_conditional_2 = 1" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_2 = 0" />
          </Else>
          <Expression Expression="sysml_value_2 = ((int) sysml_state_servoAngleDeg) - sysml_conditional_2" />
          <Expression Expression="*io_0 = sysml_value_0" />
          <Expression Expression="*serial_0_trigger = sysml_value_1" />
          <Expression Expression="*serial_0_value_0 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>