{
  "version": 1,
  "board": "arduino:avr:uno",
  "control_period_ms": 5,
  "planning_notes": [
    "Use UNO wiring as provided: DHT11 data D7, fan PWM D5, TM1637 CLK D4 and DIO D3, mode button D2. No other pins are assumed wired.",
    "Declare both temperature and humidity on the same D7 DHT11 pin as a coherent acquisition frame; when reads are invalid, retain last valid values and set validity false via model handling using dht_valid.",
    "D2 button model initial is set to false (model true when pressed). If the physical button wiring is active-low, the SysML model must handle that inversion; no active_high/pullup override is available because no wiring override pins were supplied.",
    "PWM output on D5 is compatible with UNO and avoids Timer conflicts versus D3/D11.",
    "Control_period_ms is a scheduling granularity (5ms). Business timing (button edge detection, display switching, and fan speed update mapping based on temperature threshold) belongs in the SysML model using elapsed_ms."
  ],
  "interfaces": [
    {
      "name": "io_0",
      "direction": "input",
      "type": "f64",
      "unit": "degC",
      "initial": 0,
      "meaning": "DHT11 temperature reading",
      "sample_period_ms": 2000,
      "device": "dht_temperature",
      "hardware": "{\"invalid_policy\": \"hold_last_valid\", \"kind\": \"dht_temperature\", \"pin\": \"D7\", \"sensor\": \"DHT11\"}",
      "binding": {
        "kind": "dht_temperature",
        "invalid_policy": "hold_last_valid",
        "sensor": "DHT11",
        "pin": "D7"
      }
    },
    {
      "name": "io_1",
      "direction": "input",
      "type": "f64",
      "unit": "%RH",
      "initial": 0,
      "meaning": "DHT11 humidity reading",
      "sample_period_ms": 2000,
      "device": "dht_humidity",
      "hardware": "{\"invalid_policy\": \"hold_last_valid\", \"kind\": \"dht_humidity\", \"pin\": \"D7\", \"sensor\": \"DHT11\"}",
      "binding": {
        "kind": "dht_humidity",
        "invalid_policy": "hold_last_valid",
        "sensor": "DHT11",
        "pin": "D7"
      }
    },
    {
      "name": "io_2",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "DHT11 validity for temperature/humidity frame",
      "sample_period_ms": 2000,
      "device": "dht_valid",
      "hardware": "{\"invalid_policy\": \"hold_last_valid\", \"kind\": \"dht_valid\", \"pin\": \"D7\", \"sensor\": \"DHT11\"}",
      "binding": {
        "kind": "dht_valid",
        "invalid_policy": "hold_last_valid",
        "sensor": "DHT11",
        "pin": "D7"
      }
    },
    {
      "name": "io_3",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "Display mode toggle button (press to switch temperature/humidity)",
      "sample_period_ms": 5,
      "device": "digital_input",
      "hardware": "{\"active_high\": true, \"kind\": \"digital_input\", \"pin\": \"D2\", \"pullup\": false}",
      "binding": {
        "kind": "digital_input",
        "active_high": true,
        "pullup": false,
        "pin": "D2"
      },
      "model_semantics": {
        "kind": "digital_boolean",
        "true_level": "HIGH",
        "false_level": "LOW"
      }
    },
    {
      "name": "io_4",
      "direction": "output",
      "type": "f64",
      "unit": "pwm_count",
      "initial": 0,
      "meaning": "Fan PWM speed output controlled by temperature",
      "sample_period_ms": 5,
      "device": "pwm_output",
      "hardware": "{\"kind\": \"pwm_output\", \"offset\": 0.0, \"pin\": \"D5\", \"scale\": 1.0}",
      "binding": {
        "kind": "pwm_output",
        "scale": 1.0,
        "offset": 0.0,
        "pin": "D5"
      }
    },
    {
      "name": "io_5",
      "direction": "output",
      "type": "i32",
      "unit": "1",
      "initial": 0,
      "meaning": "TM1637 display number (default show temperature, toggle to humidity)",
      "sample_period_ms": 5,
      "device": "tm1637_number",
      "hardware": "{\"brightness\": 7, \"clk_pin\": \"D4\", \"dio_pin\": \"D3\", \"invalid_policy\": \"blank\", \"kind\": \"tm1637_number\", \"leading_zero\": false}",
      "binding": {
        "kind": "tm1637_number",
        "brightness": 7,
        "leading_zero": false,
        "invalid_policy": "blank",
        "clk_pin": "D4",
        "dio_pin": "D3"
      }
    }
  ],
