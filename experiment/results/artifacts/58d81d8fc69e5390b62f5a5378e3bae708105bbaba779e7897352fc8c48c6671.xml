<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_previousPressed = false" />
          <Expression Expression="sysml_state_pressedStartStep = 0" />
          <Expression Expression="sysml_state_accumulatedPressedMs = 0" />
          <Expression Expression="sysml_state_reportPending = false" />
          <Expression Expression="sysml_state_reportedDurationSeconds = 0.0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_previousPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_pressedStartStep" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_accumulatedPressedMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_reportPending" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_reportedDurationSeconds" Type="double" DefaultValue="0.0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_1" Type="int" />
      <Input Name="io_1_valid" Type="bool" />
      <Output Name="serial_0_trigger" Type="bool" />
      <Output Name="serial_0_value_0" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_1" Type="int" Source="io_1" />
          <Input Name="io_1_valid" Type="bool" Source="io_1_valid" />
          <Output Name="serial_0_trigger" Type="bool" />
          <Output Name="serial_0_value_0" Type="double" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_previousPressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_pressedStartStep = 0" />
            <Expression Expression="sysml_state_accumulatedPressedMs = 0" />
            <Expression Expression="sysml_state_reportPending = false" />
          </If>
          <If Condition="io_0">
            <Expression Expression="sysml_state_accumulatedPressedMs = (sysml_state_accumulatedPressedMs + 5)" />
          </If>
          <Expression Expression="sysml_lazy_1 = !io_0" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = sysml_state_previousPressed" />
          </If>
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_state_reportedDurationSeconds = ((double)(sysml_state_accumulatedPressedMs) / 1000.0)" />
            <Expression Expression="sysml_state_reportPending = true" />
            <Expression Expression="sysml_state_accumulatedPressedMs = 0" />
          </If>
          <If Condition="sysml_state_reportPending">
            <Expression Expression="sysml_state_reportPending = false" />
          </If>
          <Expression Expression="sysml_state_previousPressed = io_0" />
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <Expression Expression="sysml_value_0 = sysml_state_reportPending" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <Expression Expression="sysml_value_1 = sysml_state_reportedDurationSeconds" />
          <Expression Expression="*serial_0_trigger = sysml_value_0" />
          <Expression Expression="*serial_0_value_0 = sysml_value_1" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>