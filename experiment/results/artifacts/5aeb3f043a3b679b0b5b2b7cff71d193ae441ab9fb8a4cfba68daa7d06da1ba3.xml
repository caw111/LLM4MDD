<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_led1Brightness = 0.0" />
          <Expression Expression="sysml_state_led2Brightness = 0.0" />
          <Expression Expression="sysml_state_led3Brightness = 0.0" />
          <Expression Expression="sysml_state_btn1StableUntil = 0" />
          <Expression Expression="sysml_state_btn2StableUntil = 0" />
          <Expression Expression="sysml_state_btn3StableUntil = 0" />
          <Expression Expression="sysml_state_stableTimer = 0" />
          <Expression Expression="sysml_state_previousBtn1Pressed = false" />
          <Expression Expression="sysml_state_previousBtn2Pressed = false" />
          <Expression Expression="sysml_state_previousBtn3Pressed = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_led1Brightness" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_led2Brightness" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_led3Brightness" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_btn1StableUntil" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_btn2StableUntil" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_btn3StableUntil" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_stableTimer" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_previousBtn1Pressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_previousBtn2Pressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_previousBtn3Pressed" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_3" Type="bool" />
      <Input Name="io_4" Type="bool" />
      <Input Name="io_5" Type="bool" />
      <Input Name="io_6" Type="double" />
      <Input Name="io_7" Type="double" />
      <Input Name="io_8" Type="double" />
      <Output Name="io_0" Type="double" />
      <Output Name="io_1" Type="double" />
      <Output Name="io_2" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_3" Type="bool" Source="io_3" />
          <Input Name="io_4" Type="bool" Source="io_4" />
          <Input Name="io_5" Type="bool" Source="io_5" />
          <Input Name="io_6" Type="double" Source="io_6" />
          <Input Name="io_7" Type="double" Source="io_7" />
          <Input Name="io_8" Type="double" Source="io_8" />
          <Output Name="io_0" Type="double" />
          <Output Name="io_1" Type="double" />
          <Output Name="io_2" Type="double" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_lazy_4" Type="bool" />
          <LocalVariable Name="sysml_lazy_5" Type="bool" />
          <LocalVariable Name="sysml_lazy_6" Type="bool" />
          <LocalVariable Name="sysml_lazy_7" Type="bool" />
          <LocalVariable Name="sysml_lazy_8" Type="bool" />
          <If Condition="(sysml_state_stableTimer == 0)">
            <Expression Expression="sysml_state_led1Brightness = 0.0" />
            <Expression Expression="sysml_state_led2Brightness = 0.0" />
            <Expression Expression="sysml_state_led3Brightness = 0.0" />
            <Expression Expression="sysml_state_btn1StableUntil = 0" />
            <Expression Expression="sysml_state_btn2StableUntil = 0" />
            <Expression Expression="sysml_state_btn3StableUntil = 0" />
          </If>
          <Expression Expression="sysml_state_stableTimer = (sysml_state_stableTimer + 1)" />
          <Expression Expression="sysml_lazy_0 = io_3" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_previousBtn1Pressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_led1Brightness = ((double)((io_6 * 255.0)) / 1023.0)" />
            <Expression Expression="sysml_state_btn1StableUntil = (sysml_state_stableTimer + 200)" />
          </If>
          <Expression Expression="sysml_lazy_1 = io_4" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = !sysml_state_previousBtn2Pressed" />
          </If>
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_state_led2Brightness = ((double)((io_7 * 255.0)) / 1023.0)" />
            <Expression Expression="sysml_state_btn2StableUntil = (sysml_state_stableTimer + 200)" />
          </If>
          <Expression Expression="sysml_lazy_2 = io_5" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = !sysml_state_previousBtn3Pressed" />
          </If>
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_state_led3Brightness = ((double)((io_8 * 255.0)) / 1023.0)" />
            <Expression Expression="sysml_state_btn3StableUntil = (sysml_state_stableTimer + 200)" />
          </If>
          <Expression Expression="sysml_lazy_3 = io_3" />
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_lazy_4 = sysml_state_stableTimer &gt;= sysml_state_btn1StableUntil" />
            <If Condition="sysml_lazy_4">
              <Expression Expression="sysml_lazy_4 = true" />
            </If>
            <Expression Expression="sysml_lazy_3 = !sysml_lazy_4" />
          </If>
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_state_led1Brightness = sysml_state_led1Brightness" />
          </If>
          <Expression Expression="sysml_lazy_5 = io_4" />
          <If Condition="sysml_lazy_5">
            <Expression Expression="sysml_lazy_6 = sysml_state_stableTimer &gt;= sysml_state_btn2StableUntil" />
            <If Condition="sysml_lazy_6">
              <Expression Expression="sysml_lazy_6 = true" />
            </If>
            <Expression Expression="sysml_lazy_5 = !sysml_lazy_6" />
          </If>
          <If Condition="sysml_lazy_5">
            <Expression Expression="sysml_state_led2Brightness = sysml_state_led2Brightness" />
          </If>
          <Expression Expression="sysml_lazy_7 = io_5" />
          <If Condition="sysml_lazy_7">
            <Expression Expression="sysml_lazy_8 = sysml_state_stableTimer &gt;= sysml_state_btn3StableUntil" />
            <If Condition="sysml_lazy_8">
              <Expression Expression="sysml_lazy_8 = true" />
            </If>
            <Expression Expression="sysml_lazy_7 = !sysml_lazy_8" />
          </If>
          <If Condition="sysml_lazy_7">
            <Expression Expression="sysml_state_led3Brightness = sysml_state_led3Brightness" />
          </If>
          <Expression Expression="sysml_state_previousBtn1Pressed = io_3" />
          <Expression Expression="sysml_state_previousBtn2Pressed = io_4" />
          <Expression Expression="sysml_state_previousBtn3Pressed = io_5" />
          <LocalVariable Name="sysml_value_0" Type="double" />
          <Expression Expression="sysml_value_0 = sysml_state_led1Brightness" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <Expression Expression="sysml_value_1 = sysml_state_led2Brightness" />
          <LocalVariable Name="sysml_value_2" Type="double" />
          <Expression Expression="sysml_value_2 = sysml_state_led3Brightness" />
          <Expression Expression="*io_0 = sysml_value_0" />
          <Expression Expression="*io_1 = sysml_value_1" />
          <Expression Expression="*io_2 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>