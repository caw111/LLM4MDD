{
  "version": 2,
  "name": "Controller",
  "page": "ProgramPage1",
  "inputs": [
    {
      "name": "io_1",
      "type": "i32"
    }
  ],
  "outputs": [
    {
      "name": "io_0",
      "type": "bool"
    }
  ],
  "nodes": [
    {
      "id": "compute_io_0",
      "type": "Expression",
      "inports": [
        {
          "name": "arg0",
          "type": "i32"
        }
      ],
      "outports": [
        {
          "name": "result",
          "type": "bool"
        }
      ],
      "params": {
        "Expression": "((arg0 < 1000) ? true : ((arg0 < 3000) ? false : ((arg0 < 6000) ? true : false)))"
      }
    }
  ],
  "edges": [
    {
      "src": {
        "kind": "state",
        "name": "accumulatedMs"
      },
      "dst": {
        "kind": "node",
        "id": "compute_io_0",
        "port": "arg0"
      }
    },
    {
      "src": {
        "kind": "node",
        "id": "compute_io_0",
        "port": "result"
      },
      "dst": {
        "kind": "output",
        "name": "io_0"
      }
    }
  ],
  "states": [
    {
      "name": "accumulatedMs",
      "type": "i32",
      "initial": "0"
    }
  ],
  "updates": [
    {
      "kind": "sequence",
      "steps": [
        {
          "kind": "assign",
          "state": "accumulatedMs",
          "expression": "(arg0 + arg1)",
          "sources": [
            {
              "kind": "state",
              "name": "accumulatedMs"
            },
            {
              "kind": "input",
              "name": "io_1"
            }
          ]
        },
        {
          "kind": "if",
          "condition": "(arg0 >= 9000)",
          "sources": [
            {
              "kind": "state",
              "name": "accumulatedMs"
            }
          ],
          "then": {
            "kind": "sequence",
            "steps": [
              {
                "kind": "assign",
                "state": "accumulatedMs",
                "expression": "(arg0 - 9000)",
                "sources": [
                  {
                    "kind": "state",
                    "name": "accumulatedMs"
                  }
                ]
              }
            ]
          },
          "else": null
        }
      ]
    }
  ],
  "execution": "step-actions-then-outputs"
}