<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_targetTempC = 25.0" />
          <Expression Expression="sysml_state_minFanPwm = 30" />
          <Expression Expression="sysml_state_serialSampleTempC = 0.0" />
          <Expression Expression="sysml_state_ledOverheatLatched = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_targetTempC" Type="double" DefaultValue="25.0" />
    <GlobalVariable Name="sysml_state_minFanPwm" Type="int" DefaultValue="30" />
    <GlobalVariable Name="sysml_state_serialSampleTempC" Type="double" DefaultValue="0.0" />
    <GlobalVariable Name="sysml_state_ledOverheatLatched" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="double" />
      <Input Name="io_3" Type="int" />
      <Input Name="io_3_valid" Type="bool" />
      <Output Name="io_1" Type="double" />
      <Output Name="io_2" Type="bool" />
      <Output Name="serial_0_trigger" Type="bool" />
      <Output Name="serial_0_value_0" Type="double" />
      <Output Name="serial_0_value_1" Type="double" />
      <Output Name="serial_0_value_2" Type="int" />
      <Output Name="serial_0_value_3" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="double" Source="io_0" />
          <Input Name="io_3" Type="int" Source="io_3" />
          <Input Name="io_3_valid" Type="bool" Source="io_3_valid" />
          <Output Name="io_1" Type="double" />
          <Output Name="io_2" Type="bool" />
          <Output Name="serial_0_trigger" Type="bool" />
          <Output Name="serial_0_value_0" Type="double" />
          <Output Name="serial_0_value_1" Type="double" />
          <Output Name="serial_0_value_2" Type="int" />
          <Output Name="serial_0_value_3" Type="bool" />
          <LocalVariable Name="sysml_conditional_0" Type="double" />
          <LocalVariable Name="sysml_conditional_1" Type="double" />
          <LocalVariable Name="sysml_conditional_2" Type="double" />
          <LocalVariable Name="sysml_conditional_3" Type="int" />
          <LocalVariable Name="sysml_conditional_4" Type="int" />
          <LocalVariable Name="sysml_conditional_5" Type="double" />
          <LocalVariable Name="sysml_conditional_6" Type="int" />
          <If Condition="io_3_valid">
            <Expression Expression="sysml_state_serialSampleTempC = io_0" />
            <If Condition="(io_3 == 1)">
              <Expression Expression="sysml_state_targetTempC = (sysml_state_targetTempC + 1.0)" />
            </If>
            <If Condition="(io_3 == 2)">
              <Expression Expression="sysml_state_targetTempC = (sysml_state_targetTempC + 2.0)" />
            </If>
            <If Condition="(io_3 == 3)">
              <Expression Expression="sysml_state_targetTempC = (sysml_state_targetTempC + 3.0)" />
            </If>
            <If Condition="(io_3 == 4)">
              <Expression Expression="sysml_state_targetTempC = (sysml_state_targetTempC + 4.0)" />
            </If>
            <If Condition="(io_3 == 5)">
              <Expression Expression="sysml_state_targetTempC = (sysml_state_targetTempC + 5.0)" />
            </If>
            <If Condition="(io_3 == 21)">
              <Expression Expression="sysml_state_targetTempC = (sysml_state_targetTempC - 1.0)" />
            </If>
            <If Condition="(io_3 == 22)">
              <Expression Expression="sysml_state_targetTempC = (sysml_state_targetTempC - 2.0)" />
            </If>
            <If Condition="(io_3 == 23)">
              <Expression Expression="sysml_state_targetTempC = (sysml_state_targetTempC - 3.0)" />
            </If>
            <If Condition="(io_3 == 24)">
              <Expression Expression="sysml_state_targetTempC = (sysml_state_targetTempC - 4.0)" />
            </If>
            <If Condition="(io_3 == 25)">
              <Expression Expression="sysml_state_targetTempC = (sysml_state_targetTempC - 5.0)" />
            </If>
            <If Condition="(io_3 == 26)">
              <Expression Expression="sysml_state_minFanPwm = (sysml_state_minFanPwm + 1)" />
            </If>
            <If Condition="(io_3 == 27)">
              <Expression Expression="sysml_state_minFanPwm = (sysml_state_minFanPwm + 2)" />
            </If>
            <If Condition="(io_3 == 28)">
              <Expression Expression="sysml_state_minFanPwm = (sysml_state_minFanPwm + 3)" />
            </If>
            <If Condition="(io_3 == 29)">
              <Expression Expression="sysml_state_minFanPwm = (sysml_state_minFanPwm + 4)" />
            </If>
            <If Condition="(io_3 == 30)">
              <Expression Expression="sysml_state_minFanPwm = (sysml_state_minFanPwm + 5)" />
            </If>
            <If Condition="(io_3 == 31)">
              <Expression Expression="sysml_state_targetTempC = 25.0" />
              <Expression Expression="sysml_state_minFanPwm = 30" />
            </If>
          </If>
          <If Condition="(sysml_state_serialSampleTempC &gt;= (sysml_state_targetTempC + 5.0))">
            <Expression Expression="sysml_state_ledOverheatLatched = true" />
          </If>
          <Else>
            <Expression Expression="sysml_state_ledOverheatLatched = false" />
          </Else>
          <LocalVariable Name="sysml_value_0" Type="double" />
          <If Condition="sysml_state_serialSampleTempC &gt;= sysml_state_targetTempC">
            <If Condition="sysml_state_serialSampleTempC &gt;= (sysml_state_targetTempC + 5.0)">
              <Expression Expression="sysml_conditional_1 = 255.0" />
            </If>
            <Else>
              <If Condition="sysml_state_minFanPwm &gt;= 255">
                <Expression Expression="sysml_conditional_2 = 255.0" />
              </If>
              <Else>
                <If Condition="sysml_state_minFanPwm != 0">
                  <If Condition="((sysml_state_serialSampleTempC - sysml_state_targetTempC) * 10.0) &lt; ((double) ((int) ((sysml_state_serialSampleTempC - sysml_state_targetTempC) * 10.0)))">
                    <Expression Expression="sysml_conditional_4 = 1" />
                  </If>
                  <Else>
                    <Expression Expression="sysml_conditional_4 = 0" />
                  </Else>
                  <Expression Expression="sysml_conditional_3 = ((int) ((sysml_state_serialSampleTempC - sysml_state_targetTempC) * 10.0)) - sysml_conditional_4" />
                </If>
                <Else>
                  <Expression Expression="sysml_conditional_3 = 0" />
                </Else>
                <Expression Expression="sysml_conditional_2 = sysml_state_minFanPwm + sysml_conditional_3" />
              </Else>
              <Expression Expression="sysml_conditional_1 = sysml_conditional_2" />
            </Else>
            <Expression Expression="sysml_conditional_0 = sysml_conditional_1" />
          </If>
          <Else>
            <If Condition="sysml_state_minFanPwm &gt;= 0">
              <If Condition="sysml_state_minFanPwm &lt; ((double) ((int) sysml_state_minFanPwm))">
                <Expression Expression="sysml_conditional_6 = 1" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_6 = 0" />
              </Else>
              <Expression Expression="sysml_conditional_5 = ((int) sysml_state_minFanPwm) - sysml_conditional_6" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_5 = 0.0" />
            </Else>
            <Expression Expression="sysml_conditional_0 = sysml_conditional_5" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_0" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <Expression Expression="sysml_value_1 = sysml_state_ledOverheatLatched" />
          <LocalVariable Name="sysml_value_2" Type="bool" />
          <Expression Expression="sysml_value_2 = io_3_valid" />
          <LocalVariable Name="sysml_value_3" Type="double" />
          <Expression Expression="sysml_value_3 = sysml_state_serialSampleTempC" />
          <LocalVariable Name="sysml_value_4" Type="double" />
          <Expression Expression="sysml_value_4 = sysml_state_targetTempC" />
          <LocalVariable Name="sysml_value_5" Type="int" />
          <Expression Expression="sysml_value_5 = sysml_state_minFanPwm" />
          <LocalVariable Name="sysml_value_6" Type="bool" />
          <Expression Expression="sysml_value_6 = sysml_state_ledOverheatLatched" />
          <Expression Expression="*io_1 = sysml_value_0" />
          <Expression Expression="*io_2 = sysml_value_1" />
          <Expression Expression="*serial_0_trigger = sysml_value_2" />
          <Expression Expression="*serial_0_value_0 = sysml_value_3" />
          <Expression Expression="*serial_0_value_1 = sysml_value_4" />
          <Expression Expression="*serial_0_value_2 = sysml_value_5" />
          <Expression Expression="*serial_0_value_3 = sysml_value_6" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>