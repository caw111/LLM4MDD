            <Else>
              <Expression Expression="sysml_conditional_1 = true" />
            </Else>
            <Expression Expression="sysml_state_autoMode = sysml_conditional_1" />
          </If>
          <Expression Expression="sysml_lazy_2 = !sysml_state_autoMode" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = io_3" />
          </If>
          <Expression Expression="sysml_lazy_3 = sysml_lazy_2" />
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_lazy_3 = !sysml_state_prevIo3" />
          </If>
          <If Condition="sysml_lazy_3">
            <If Condition="sysml_state_curAnglePct &gt;= 100">
              <Expression Expression="sysml_conditional_4 = 0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_4 = sysml_state_curAnglePct + 10" />
