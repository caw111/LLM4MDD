    <GlobalVariable Name="sysml_state_prevIo3" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_curAnglePct" Type="int" DefaultValue="50" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="double" />
      <Input Name="io_1" Type="double" />
      <Input Name="io_2" Type="bool" />
      <Input Name="io_3" Type="bool" />
      <Output Name="io_4" Type="bool" />
      <Output Name="io_5" Type="double" />
      <Output Name="io_6" Type="int" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="double" Source="io_0" />
          <Input Name="io_1" Type="double" Source="io_1" />
          <Input Name="io_2" Type="bool" Source="io_2" />
          <Input Name="io_3" Type="bool" Source="io_3" />
          <Output Name="io_4" Type="bool" />
          <Output Name="io_5" Type="double" />
          <Output Name="io_6" Type="int" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_conditional_4" Type="int" />
          <LocalVariable Name="sysml_lazy_5" Type="bool" />
          <LocalVariable Name="sysml_lazy_6" Type="bool" />
          <LocalVariable Name="sysml_conditional_7" Type="int" />
          <LocalVariable Name="sysml_conditional_8" Type="int" />
          <LocalVariable Name="sysml_conditional_9" Type="int" />
          <LocalVariable Name="sysml_conditional_10" Type="bool" />
          <LocalVariable Name="sysml_lazy_11" Type="bool" />
          <LocalVariable Name="sysml_conditional_12" Type="int" />
          <Expression Expression="sysml_lazy_0 = io_2" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_prevIo2" />
          </If>
          <If Condition="sysml_lazy_0">
