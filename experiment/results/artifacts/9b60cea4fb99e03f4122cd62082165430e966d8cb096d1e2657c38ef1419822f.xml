              <If Condition="sysml_lazy_6">
                <Expression Expression="sysml_lazy_6 = true" />
              </If>
              <Expression Expression="sysml_lazy_5 = sysml_lazy_6" />
            </If>
            <If Condition="sysml_lazy_5">
              <Expression Expression="sysml_conditional_7 = 0" />
            </If>
            <Else>
              <If Condition="io_1 &gt; 30.0">
                <Expression Expression="sysml_conditional_8 = 0" />
              </If>
              <Else>
                <If Condition="io_0 &lt;= 300.0">
                  <Expression Expression="sysml_conditional_9 = 100" />
                </If>
                <Else>
                  <Expression Expression="sysml_conditional_9 = 0" />
                </Else>
                <Expression Expression="sysml_conditional_8 = sysml_conditional_9" />
