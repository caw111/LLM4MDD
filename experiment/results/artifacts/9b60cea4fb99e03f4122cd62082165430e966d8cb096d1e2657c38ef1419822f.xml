            </If>
            <Expression Expression="sysml_conditional_10 = sysml_lazy_11" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_10 = false" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_10" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <If Condition="(sysml_state_curAnglePct * 1.0) &lt; ((double) ((int) (sysml_state_curAnglePct * 1.0)))">
            <Expression Expression="sysml_conditional_12 = 1" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_12 = 0" />
          </Else>
          <Expression Expression="sysml_value_1 = ((int) (sysml_state_curAnglePct * 1.0)) - sysml_conditional_12" />
          <LocalVariable Name="sysml_value_2" Type="int" />
          <Expression Expression="sysml_value_2 = sysml_state_curAnglePct" />
          <Expression Expression="*io_4 = sysml_value_0" />
          <Expression Expression="*io_5 = sysml_value_1" />
          <Expression Expression="*io_6 = sysml_value_2" />
        </Calculate>
      </Schedule>
