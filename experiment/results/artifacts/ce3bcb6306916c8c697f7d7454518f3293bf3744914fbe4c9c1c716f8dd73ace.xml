<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_previousPressed = false" />
          <Expression Expression="sysml_state_debouncedPressed = false" />
          <Expression Expression="sysml_state_debounceCounter = 0" />
          <Expression Expression="sysml_state_servo1Angle = 0" />
          <Expression Expression="sysml_state_servo2Angle = 0" />
          <Expression Expression="sysml_state_toggleState = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_previousPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_debouncedPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_debounceCounter" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_servo1Angle" Type="double" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_servo2Angle" Type="double" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_toggleState" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Output Name="io_1" Type="double" />
      <Output Name="io_2" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Output Name="io_1" Type="double" />
          <Output Name="io_2" Type="double" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_conditional_2" Type="double" />
          <LocalVariable Name="sysml_conditional_3" Type="double" />
          <If Condition="sysml_state_debouncedPressed">
            <If Condition="(!io_0)">
              <Expression Expression="sysml_state_debouncedPressed = false" />
            </If>
          </If>
          <Expression Expression="sysml_lazy_0 = !sysml_state_debouncedPressed" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = io_0" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_debounceCounter = (sysml_state_debounceCounter + 1)" />
          </If>
          <Else>
            <If Condition="(!io_0)">
              <Expression Expression="sysml_state_debounceCounter = 0" />
            </If>
          </Else>
          <If Condition="(sysml_state_debounceCounter &gt;= 3)">
            <Expression Expression="sysml_state_debouncedPressed = true" />
          </If>
          <Expression Expression="sysml_lazy_1 = sysml_state_debouncedPressed" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = !sysml_state_previousPressed" />
          </If>
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_state_toggleState = (!sysml_state_toggleState)" />
            <If Condition="sysml_state_toggleState">
              <Expression Expression="sysml_conditional_2 = 0.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_2 = 180.0" />
            </Else>
            <Expression Expression="sysml_state_servo1Angle = sysml_conditional_2" />
            <If Condition="sysml_state_toggleState">
              <Expression Expression="sysml_conditional_3 = 180.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_3 = 0.0" />
            </Else>
            <Expression Expression="sysml_state_servo2Angle = sysml_conditional_3" />
          </If>
          <Expression Expression="sysml_state_previousPressed = sysml_state_debouncedPressed" />
          <LocalVariable Name="sysml_value_0" Type="double" />
          <Expression Expression="sysml_value_0 = sysml_state_servo1Angle" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <Expression Expression="sysml_value_1 = sysml_state_servo2Angle" />
          <Expression Expression="*io_1 = sysml_value_0" />
          <Expression Expression="*io_2 = sysml_value_1" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>