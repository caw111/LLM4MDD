<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_servoAngle = 90.0" />
          <Expression Expression="sysml_state_previousBtn1 = false" />
          <Expression Expression="sysml_state_previousBtn2 = false" />
          <Expression Expression="sysml_state_movingLed = false" />
          <Expression Expression="sysml_state_movingUntilAngle = 90.0" />
          <Expression Expression="sysml_state_movingHoldActive = false" />
          <Expression Expression="sysml_state_movingHoldMsRemaining = 0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_servoAngle" Type="double" DefaultValue="90.0" />
    <GlobalVariable Name="sysml_state_previousBtn1" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_previousBtn2" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_movingLed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_movingUntilAngle" Type="double" DefaultValue="90.0" />
    <GlobalVariable Name="sysml_state_movingHoldActive" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_movingHoldMsRemaining" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_1" Type="bool" />
      <Input Name="io_2" Type="bool" />
      <Output Name="io_0" Type="bool" />
      <Output Name="io_3" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Input Name="io_2" Type="bool" Source="io_2" />
          <Output Name="io_0" Type="bool" />
          <Output Name="io_3" Type="double" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="double" />
          <LocalVariable Name="sysml_conditional_2" Type="double" />
          <LocalVariable Name="sysml_conditional_3" Type="bool" />
          <LocalVariable Name="sysml_conditional_4" Type="int" />
          <LocalVariable Name="sysml_lazy_5" Type="bool" />
          <LocalVariable Name="sysml_conditional_6" Type="double" />
          <LocalVariable Name="sysml_conditional_7" Type="double" />
          <LocalVariable Name="sysml_conditional_8" Type="bool" />
          <LocalVariable Name="sysml_conditional_9" Type="int" />
          <LocalVariable Name="sysml_lazy_10" Type="bool" />
          <Expression Expression="sysml_state_previousBtn1 = io_1" />
          <Expression Expression="sysml_state_previousBtn2 = io_2" />
          <Expression Expression="sysml_state_movingLed = false" />
          <Expression Expression="sysml_state_movingHoldActive = sysml_state_movingHoldActive" />
          <Expression Expression="sysml_lazy_0 = io_1" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_previousBtn1" />
          </If>
          <If Condition="sysml_lazy_0">
            <If Condition="sysml_state_servoAngle &lt;= 150.0">
              <Expression Expression="sysml_conditional_1 = sysml_state_servoAngle + 30.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_1 = sysml_state_servoAngle" />
            </Else>
            <Expression Expression="sysml_state_servoAngle = sysml_conditional_1" />
            <If Condition="sysml_state_servoAngle &lt;= 150.0">
              <Expression Expression="sysml_conditional_2 = sysml_state_servoAngle + 30.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_2 = sysml_state_servoAngle" />
            </Else>
            <Expression Expression="sysml_state_movingUntilAngle = sysml_conditional_2" />
            <If Condition="sysml_state_servoAngle &lt;= 150.0">
              <Expression Expression="sysml_conditional_3 = true" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_3 = false" />
            </Else>
            <Expression Expression="sysml_state_movingHoldActive = sysml_conditional_3" />
            <If Condition="sysml_state_servoAngle &lt;= 150.0">
              <Expression Expression="sysml_conditional_4 = 2000" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_4 = 0" />
            </Else>
            <Expression Expression="sysml_state_movingHoldMsRemaining = sysml_conditional_4" />
          </If>
          <Expression Expression="sysml_lazy_5 = io_2" />
          <If Condition="sysml_lazy_5">
            <Expression Expression="sysml_lazy_5 = !sysml_state_previousBtn2" />
          </If>
          <If Condition="sysml_lazy_5">
            <If Condition="sysml_state_servoAngle &gt;= 30.0">
              <Expression Expression="sysml_conditional_6 = sysml_state_servoAngle - 30.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_6 = sysml_state_servoAngle" />
            </Else>
            <Expression Expression="sysml_state_servoAngle = sysml_conditional_6" />
            <If Condition="sysml_state_servoAngle &gt;= 30.0">
              <Expression Expression="sysml_conditional_7 = sysml_state_servoAngle - 30.0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_7 = sysml_state_servoAngle" />
            </Else>
            <Expression Expression="sysml_state_movingUntilAngle = sysml_conditional_7" />
            <If Condition="sysml_state_servoAngle &gt;= 30.0">
              <Expression Expression="sysml_conditional_8 = true" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_8 = false" />
            </Else>
            <Expression Expression="sysml_state_movingHoldActive = sysml_conditional_8" />
            <If Condition="sysml_state_servoAngle &gt;= 30.0">
              <Expression Expression="sysml_conditional_9 = 2000" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_9 = 0" />
            </Else>
            <Expression Expression="sysml_state_movingHoldMsRemaining = sysml_conditional_9" />
          </If>
          <If Condition="sysml_state_movingHoldActive">
            <Expression Expression="sysml_state_movingLed = true" />
          </If>
          <Expression Expression="sysml_lazy_10 = sysml_state_movingHoldActive" />
          <If Condition="sysml_lazy_10">
            <Expression Expression="sysml_lazy_10 = sysml_state_servoAngle == sysml_state_movingUntilAngle" />
          </If>
          <If Condition="sysml_lazy_10">
            <Expression Expression="sysml_state_movingLed = false" />
            <Expression Expression="sysml_state_movingHoldActive = false" />
            <Expression Expression="sysml_state_movingHoldMsRemaining = 0" />
          </If>
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <Expression Expression="sysml_value_0 = sysml_state_movingLed" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <Expression Expression="sysml_value_1 = sysml_state_servoAngle" />
          <Expression Expression="*io_0 = sysml_value_0" />
          <Expression Expression="*io_3 = sysml_value_1" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>