          <If Condition="!sysml_lazy_8">
            <Expression Expression="sysml_lazy_8 = sysml_state_isAlarmLatched" />
          </If>
          <Expression Expression="sysml_value_3 = sysml_lazy_8" />
          <LocalVariable Name="sysml_value_4" Type="double" />
          <If Condition="io_6_valid">
            <Expression Expression="sysml_conditional_9 = io_0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_9 = io_0" />
          </Else>
          <Expression Expression="sysml_value_4 = sysml_conditional_9" />
          <LocalVariable Name="sysml_value_5" Type="int" />
          <Expression Expression="sysml_value_5 = sysml_state_abnormalCount" />
          <LocalVariable Name="sysml_value_6" Type="int" />
          <If Condition="io_6_valid">
            <Expression Expression="sysml_conditional_10 = 0 + 0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_10 = 0" />
          </Else>
          <Expression Expression="sysml_value_6 = sysml_conditional_10" />
          <LocalVariable Name="sysml_value_7" Type="int" />
          <If Condition="io_6_valid">
            <Expression Expression="sysml_conditional_11 = 0 + 0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_11 = 0" />
          </Else>
          <Expression Expression="sysml_value_7 = sysml_conditional_11" />
          <LocalVariable Name="sysml_value_8" Type="bool" />
          <Expression Expression="sysml_lazy_12 = !sysml_state_isAlarmLatched" />
          <If Condition="sysml_lazy_12">
            <Expression Expression="sysml_lazy_12 = io_6_valid" />
          </If>
          <Expression Expression="sysml_value_8 = sysml_lazy_12" />
          <LocalVariable Name="sysml_value_9" Type="double" />
          <Expression Expression="sysml_value_9 = io_0" />
          <LocalVariable Name="sysml_value_10" Type="int" />
          <Expression Expression="sysml_value_10 = sysml_state_abnormalCount" />
          <Expression Expression="*io_3 = sysml_value_0" />
          <Expression Expression="*io_4 = sysml_value_1" />
          <Expression Expression="*io_5 = sysml_value_2" />
          <Expression Expression="*serial_0_trigger = sysml_value_3" />
          <Expression Expression="*serial_0_value_0 = sysml_value_4" />
          <Expression Expression="*serial_0_value_1 = sysml_value_5" />
          <Expression Expression="*serial_0_value_2 = sysml_value_6" />
          <Expression Expression="*serial_0_value_3 = sysml_value_7" />
          <Expression Expression="*serial_1_trigger = sysml_value_8" />
          <Expression Expression="*serial_1_value_0 = sysml_value_9" />
          <Expression Expression="*serial_1_value_1 = sysml_value_10" />
