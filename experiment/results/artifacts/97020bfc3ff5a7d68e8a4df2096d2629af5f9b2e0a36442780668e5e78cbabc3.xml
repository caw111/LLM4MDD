      <Output Name="serial_0_value_0" Type="double" />
      <Output Name="serial_0_value_1" Type="int" />
      <Output Name="serial_0_value_2" Type="int" />
      <Output Name="serial_0_value_3" Type="int" />
      <Output Name="serial_1_trigger" Type="bool" />
      <Output Name="serial_1_value_0" Type="double" />
      <Output Name="serial_1_value_1" Type="int" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="double" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Input Name="io_2" Type="bool" Source="io_2" />
          <Input Name="io_6" Type="int" Source="io_6" />
          <Input Name="io_6_valid" Type="bool" Source="io_6_valid" />
          <Output Name="io_3" Type="bool" />
          <Output Name="io_4" Type="int" />
          <Output Name="io_5" Type="int" />
          <Output Name="serial_0_trigger" Type="bool" />
          <Output Name="serial_0_value_0" Type="double" />
          <Output Name="serial_0_value_1" Type="int" />
          <Output Name="serial_0_value_2" Type="int" />
          <Output Name="serial_0_value_3" Type="int" />
          <Output Name="serial_1_trigger" Type="bool" />
          <Output Name="serial_1_value_0" Type="double" />
          <Output Name="serial_1_value_1" Type="int" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_conditional_2" Type="int" />
          <LocalVariable Name="sysml_conditional_3" Type="int" />
          <LocalVariable Name="sysml_lazy_4" Type="bool" />
          <LocalVariable Name="sysml_lazy_5" Type="bool" />
          <LocalVariable Name="sysml_lazy_6" Type="bool" />
          <LocalVariable Name="sysml_lazy_7" Type="bool" />
          <LocalVariable Name="sysml_lazy_8" Type="bool" />
