          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_2" />
          <LocalVariable Name="sysml_value_2" Type="int" />
          <If Condition="io_0 &gt;= 30.0">
            <Expression Expression="sysml_conditional_3 = sysml_state_abnormalCount" />
