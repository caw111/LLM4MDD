          <Else>
            <Expression Expression="sysml_conditional_3 = 0" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_3" />
          <LocalVariable Name="sysml_value_3" Type="bool" />
          <Expression Expression="sysml_lazy_4 = io_0 &gt;= 30.0" />
          <If Condition="!sysml_lazy_4">
            <Expression Expression="sysml_lazy_5 = io_2" />
            <If Condition="sysml_lazy_5">
              <Expression Expression="sysml_lazy_5 = !sysml_state_previousDoor" />
