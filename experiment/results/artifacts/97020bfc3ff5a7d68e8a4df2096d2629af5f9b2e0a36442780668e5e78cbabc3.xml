            <If Condition="(io_6 == 0)">
              <Expression Expression="sysml_state_isAlarmLatched = false" />
            </If>
          </If>
          <If Condition="(io_0 &gt;= 30.0)">
            <Expression Expression="sysml_state_abnormalCount = (sysml_state_abnormalCount + 1)" />
            <Expression Expression="sysml_state_isAlarmLatched = true" />
          </If>
          <Expression Expression="sysml_lazy_0 = io_2" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_previousDoor" />
