      "sample_period_ms": 2000,
      "device": "dht_humidity",
      "hardware": "{\"invalid_policy\": \"hold_last_valid\", \"kind\": \"dht_humidity\", \"pin\": \"D7\", \"sensor\": \"DHT11\"}",
      "binding": {
        "kind": "dht_humidity",
        "invalid_policy": "hold_last_valid",
        "pin": "D7",
        "sensor": "DHT11"
      }
    },
    {
      "name": "io_2",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "DHT 数据有效性（温湿度读取一致帧发布，失效时有效性为 false）",
      "sample_period_ms": 2000,
      "device": "dht_valid",
      "hardware": "{\"invalid_policy\": \"hold_last_valid\", \"kind\": \"dht_valid\", \"pin\": \"D7\", \"sensor\": \"DHT11\"}",
      "binding": {
        "kind": "dht_valid",
        "invalid_policy": "hold_last_valid",
        "pin": "D7",
        "sensor": "DHT11"
      }
    },
    {
      "name": "io_3",
      "direction": "output",
      "type": "f64",
      "unit": "pwm_count",
      "initial": 0,
      "meaning": "风扇 PWM 调速输出（温度>30℃时开启并随温度升高提升转速）",
      "sample_period_ms": 10,
      "device": "pwm_output",
      "hardware": "{\"kind\": \"pwm_output\", \"offset\": 0, \"pin\": \"D5\", \"scale\": 1}",
      "binding": {
        "kind": "pwm_output",
        "scale": 1,
        "offset": 0,
        "pin": "D5"
      }
    },
    {
      "name": "io_4",
      "direction": "output",
      "type": "i32",
      "unit": "1",
      "initial": 0,
      "meaning": "TM1637 数码管显示数值（默认显示温度；按钮切换显示湿度）",
      "sample_period_ms": 10,
      "device": "tm1637_number",
      "hardware": "{\"brightness\": 7, \"clk_pin\": \"D4\", \"dio_pin\": \"D3\", \"invalid_policy\": \"blank\", \"kind\": \"tm1637_number\", \"leading_zero\": false}",
      "binding": {
        "kind": "tm1637_number",
        "brightness": 7,
        "leading_zero": false,
        "invalid_policy": "blank",
        "dio_pin": "D3",
        "clk_pin": "D4"
      }
    },
    {
      "name": "io_5",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "meaning": "按键输入：每按一次切换显示温度/湿度模式",
      "sample_period_ms": 10,
      "device": "digital_input",
      "hardware": "{\"active_high\": false, \"kind\": \"digital_input\", \"pin\": \"D2\", \"pullup\": true}",
      "binding": {
        "kind": "digital_input",
        "active_high": false,
        "pullup": true,
        "pin": "D2"
      },
      "model_semantics": {
        "kind": "digital_boolean",
        "true_level": "LOW",
        "false_level": "HIGH"
      }
    }
