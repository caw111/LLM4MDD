<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_prevBed1 = false" />
          <Expression Expression="sysml_state_prevBed2 = false" />
          <Expression Expression="sysml_state_prevBed3 = false" />
          <Expression Expression="sysml_state_prevAck = false" />
          <Expression Expression="sysml_state_pending = false" />
          <Expression Expression="sysml_state_activeBed = 0" />
          <Expression Expression="sysml_state_queueSeq = 0" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_prevBed1" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_prevBed2" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_prevBed3" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_prevAck" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_pending" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_activeBed" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_queueSeq" Type="int" DefaultValue="0" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_1" Type="bool" />
      <Input Name="io_2" Type="bool" />
      <Input Name="io_3" Type="bool" />
      <Output Name="io_4" Type="bool" />
      <Output Name="io_5" Type="int" />
      <Output Name="io_6" Type="int" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Input Name="io_2" Type="bool" Source="io_2" />
          <Input Name="io_3" Type="bool" Source="io_3" />
          <Output Name="io_4" Type="bool" />
          <Output Name="io_5" Type="int" />
          <Output Name="io_6" Type="int" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_lazy_1" Type="bool" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_lazy_3" Type="bool" />
          <LocalVariable Name="sysml_conditional_4" Type="int" />
          <LocalVariable Name="sysml_conditional_5" Type="int" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_prevBed1" />
          </If>
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_state_pending = true" />
            <Expression Expression="sysml_state_activeBed = 1" />
            <Expression Expression="sysml_state_queueSeq = (sysml_state_queueSeq + 1)" />
          </If>
          <Expression Expression="sysml_lazy_1 = io_1" />
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_lazy_1 = !sysml_state_prevBed2" />
          </If>
          <If Condition="sysml_lazy_1">
            <Expression Expression="sysml_state_pending = true" />
            <Expression Expression="sysml_state_activeBed = 2" />
            <Expression Expression="sysml_state_queueSeq = (sysml_state_queueSeq + 1)" />
          </If>
          <Expression Expression="sysml_lazy_2 = io_2" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = !sysml_state_prevBed3" />
          </If>
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_state_pending = true" />
            <Expression Expression="sysml_state_activeBed = 3" />
            <Expression Expression="sysml_state_queueSeq = (sysml_state_queueSeq + 1)" />
          </If>
          <Expression Expression="sysml_lazy_3 = io_3" />
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_lazy_3 = !sysml_state_prevAck" />
          </If>
          <If Condition="sysml_lazy_3">
            <Expression Expression="sysml_state_pending = false" />
            <Expression Expression="sysml_state_activeBed = 0" />
          </If>
          <Expression Expression="sysml_state_prevBed1 = io_0" />
          <Expression Expression="sysml_state_prevBed2 = io_1" />
          <Expression Expression="sysml_state_prevBed3 = io_2" />
          <Expression Expression="sysml_state_prevAck = io_3" />
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <Expression Expression="sysml_value_0 = sysml_state_pending" />
          <LocalVariable Name="sysml_value_1" Type="int" />
          <If Condition="sysml_state_pending">
            <Expression Expression="sysml_conditional_4 = 1000" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_4 = 0" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_4" />
          <LocalVariable Name="sysml_value_2" Type="int" />
          <If Condition="sysml_state_pending">
            <Expression Expression="sysml_conditional_5 = 1000" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_5 = 0" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_5" />
          <Expression Expression="*io_4 = sysml_value_0" />
          <Expression Expression="*io_5 = sysml_value_1" />
          <Expression Expression="*io_6 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>