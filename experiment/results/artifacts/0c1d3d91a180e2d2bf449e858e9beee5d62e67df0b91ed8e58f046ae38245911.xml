          <Expression Expression="sysml_state_mode = 0" />
          <Expression Expression="sysml_state_brightness = 255" />
          <Expression Expression="sysml_state_breathSpeed = 2000" />
          <Expression Expression="sysml_state_accumMs = 0" />
          <Expression Expression="sysml_state_prevModeBtnPressed = false" />
          <Expression Expression="sysml_state_prevParamBtnPressed = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_mode" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_brightness" Type="int" DefaultValue="255" />
    <GlobalVariable Name="sysml_state_breathSpeed" Type="int" DefaultValue="2000" />
    <GlobalVariable Name="sysml_state_accumMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_prevModeBtnPressed" Type="bool" DefaultValue="false" />
    <GlobalVariable Name="sysml_state_prevParamBtnPressed" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_1" Type="bool" />
      <Input Name="io_5" Type="int" />
      <Output Name="io_2" Type="double" />
      <Output Name="io_3" Type="int" />
      <Output Name="io_4" Type="bool" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_1" Type="bool" Source="io_1" />
          <Input Name="io_5" Type="int" Source="io_5" />
          <Output Name="io_2" Type="double" />
          <Output Name="io_3" Type="int" />
          <Output Name="io_4" Type="bool" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="int" />
          <LocalVariable Name="sysml_lazy_2" Type="bool" />
          <LocalVariable Name="sysml_conditional_3" Type="int" />
          <LocalVariable Name="sysml_conditional_4" Type="int" />
          <LocalVariable Name="sysml_conditional_5" Type="double" />
          <LocalVariable Name="sysml_conditional_6" Type="double" />
          <LocalVariable Name="sysml_lazy_7" Type="bool" />
          <LocalVariable Name="sysml_conditional_8" Type="double" />
          <LocalVariable Name="sysml_conditional_9" Type="double" />
          <LocalVariable Name="sysml_conditional_10" Type="double" />
          <LocalVariable Name="sysml_conditional_11" Type="double" />
          <LocalVariable Name="sysml_arithmetic_12" Type="double" />
          <LocalVariable Name="sysml_arithmetic_13" Type="double" />
          <LocalVariable Name="sysml_conditional_14" Type="double" />
          <LocalVariable Name="sysml_arithmetic_15" Type="double" />
          <LocalVariable Name="sysml_arithmetic_16" Type="double" />
          <LocalVariable Name="sysml_conditional_17" Type="int" />
          <LocalVariable Name="sysml_conditional_18" Type="int" />
          <LocalVariable Name="sysml_conditional_19" Type="bool" />
          <Expression Expression="sysml_state_accumMs = (sysml_state_accumMs + io_5)" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_prevModeBtnPressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <If Condition="sysml_state_mode == 2">
              <Expression Expression="sysml_conditional_1 = 0" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_1 = sysml_state_mode + 1" />
            </Else>
            <Expression Expression="sysml_state_mode = sysml_conditional_1" />
          </If>
          <Expression Expression="sysml_lazy_2 = io_1" />
          <If Condition="sysml_lazy_2">
            <Expression Expression="sysml_lazy_2 = !sysml_state_prevParamBtnPressed" />
          </If>
          <If Condition="sysml_lazy_2">
            <If Condition="(sysml_state_mode == 1)">
              <If Condition="sysml_state_brightness == 255">
                <Expression Expression="sysml_conditional_3 = 16" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_3 = sysml_state_brightness + 16" />
              </Else>
              <Expression Expression="sysml_state_brightness = sysml_conditional_3" />
            </If>
            <If Condition="(sysml_state_mode == 2)">
              <If Condition="sysml_state_breathSpeed == 5000">
                <Expression Expression="sysml_conditional_4 = 500" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_4 = sysml_state_breathSpeed + 500" />
              </Else>
              <Expression Expression="sysml_state_breathSpeed = sysml_conditional_4" />
            </If>
          </If>
          <Expression Expression="sysml_state_prevModeBtnPressed = io_0" />
          <Expression Expression="sysml_state_prevParamBtnPressed = io_1" />
          <If Condition="(sysml_state_mode != 2)">
            <Expression Expression="sysml_state_accumMs = 0" />
          </If>
          <LocalVariable Name="sysml_value_0" Type="double" />
          <If Condition="sysml_state_mode == 0">
            <Expression Expression="sysml_conditional_5 = 0.0" />
          </If>
          <Else>
            <If Condition="sysml_state_mode == 1">
              <Expression Expression="sysml_lazy_7 = sysml_state_brightness &gt;= 0" />
              <If Condition="sysml_lazy_7">
                <Expression Expression="sysml_lazy_7 = sysml_state_brightness &lt;= 255" />
              </If>
              <If Condition="sysml_lazy_7">
                <Expression Expression="sysml_conditional_8 = sysml_state_brightness * 1.0" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_8 = 0.0" />
              </Else>
              <Expression Expression="sysml_conditional_6 = sysml_conditional_8" />
            </If>
            <Else>
              <If Condition="sysml_state_breathSpeed &lt;= 0">
                <Expression Expression="sysml_conditional_9 = 0.0" />
              </If>
              <Else>
                <If Condition="sysml_state_accumMs &lt; (sysml_state_breathSpeed * 0.5)">
                  <If Condition="sysml_state_breathSpeed == 0">
                    <Expression Expression="sysml_conditional_11 = 0.0" />
                  </If>
                  <Else>
                    <Expression Expression="sysml_arithmetic_12 = sysml_state_accumMs * 1.0" />
                    <Expression Expression="sysml_arithmetic_13 = (sysml_state_breathSpeed * 1.0) * 0.5" />
                    <Expression Expression="sysml_conditional_11 = ((double) ((sysml_state_brightness * 1.0) * sysml_arithmetic_12)) / sysml_arithmetic_13" />
                  </Else>
                  <Expression Expression="sysml_conditional_10 = sysml_conditional_11" />
                </If>
                <Else>
                  <If Condition="sysml_state_breathSpeed == 0">
                    <Expression Expression="sysml_conditional_14 = 0.0" />
                  </If>
                  <Else>
                    <Expression Expression="sysml_arithmetic_15 = ((sysml_state_breathSpeed * 1.0) * 1.0) - (sysml_state_accumMs * 1.0)" />
                    <Expression Expression="sysml_arithmetic_16 = (sysml_state_breathSpeed * 1.0) * 0.5" />
                    <Expression Expression="sysml_conditional_14 = ((double) ((sysml_state_brightness * 1.0) * sysml_arithmetic_15)) / sysml_arithmetic_16" />
                  </Else>
                  <Expression Expression="sysml_conditional_10 = sysml_conditional_14" />
                </Else>
                <Expression Expression="sysml_conditional_9 = sysml_conditional_10" />
              </Else>
              <Expression Expression="sysml_conditional_6 = sysml_conditional_9" />
            </Else>
            <Expression Expression="sysml_conditional_5 = sysml_conditional_6" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_5" />
          <LocalVariable Name="sysml_value_1" Type="int" />
          <If Condition="sysml_state_mode == 0">
            <Expression Expression="sysml_conditional_17 = 0" />
          </If>
          <Else>
            <If Condition="sysml_state_mode == 1">
              <Expression Expression="sysml_conditional_18 = sysml_state_brightness" />
            </If>
            <Else>
              <Expression Expression="sysml_conditional_18 = sysml_state_breathSpeed" />
            </Else>
            <Expression Expression="sysml_conditional_17 = sysml_conditional_18" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_17" />
          <LocalVariable Name="sysml_value_2" Type="bool" />
          <If Condition="sysml_state_mode == 0">
            <Expression Expression="sysml_conditional_19 = false" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_19 = true" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_19" />
          <Expression Expression="*io_2 = sysml_value_0" />
          <Expression Expression="*io_3 = sysml_value_1" />
          <Expression Expression="*io_4 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>