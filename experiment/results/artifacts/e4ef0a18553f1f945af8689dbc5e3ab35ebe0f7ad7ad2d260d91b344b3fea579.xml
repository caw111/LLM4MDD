<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_selectedChannel = 0" />
          <Expression Expression="sysml_state_previousPressed = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_selectedChannel" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_previousPressed" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_0" Type="bool" />
      <Input Name="io_1" Type="double" />
      <Output Name="io_2" Type="double" />
      <Output Name="io_3" Type="double" />
      <Output Name="io_4" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_0" Type="bool" Source="io_0" />
          <Input Name="io_1" Type="double" Source="io_1" />
          <Output Name="io_2" Type="double" />
          <Output Name="io_3" Type="double" />
          <Output Name="io_4" Type="double" />
          <LocalVariable Name="sysml_lazy_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="double" />
          <LocalVariable Name="sysml_conditional_2" Type="double" />
          <LocalVariable Name="sysml_conditional_3" Type="double" />
          <LocalVariable Name="sysml_conditional_4" Type="double" />
          <LocalVariable Name="sysml_conditional_5" Type="double" />
          <LocalVariable Name="sysml_conditional_6" Type="double" />
          <LocalVariable Name="sysml_conditional_7" Type="double" />
          <LocalVariable Name="sysml_conditional_8" Type="double" />
          <LocalVariable Name="sysml_conditional_9" Type="double" />
          <Expression Expression="sysml_lazy_0 = io_0" />
          <If Condition="sysml_lazy_0">
            <Expression Expression="sysml_lazy_0 = !sysml_state_previousPressed" />
          </If>
          <If Condition="sysml_lazy_0">
            <If Condition="(sysml_state_selectedChannel == 0)">
              <Expression Expression="sysml_state_selectedChannel = 1" />
            </If>
            <Else>
              <If Condition="(sysml_state_selectedChannel == 1)">
                <Expression Expression="sysml_state_selectedChannel = 2" />
              </If>
              <Else>
                <Expression Expression="sysml_state_selectedChannel = 0" />
              </Else>
            </Else>
            <Expression Expression="sysml_state_previousPressed = io_0" />
          </If>
          <Else>
            <Expression Expression="sysml_state_previousPressed = io_0" />
          </Else>
          <LocalVariable Name="sysml_value_0" Type="double" />
          <If Condition="sysml_state_selectedChannel == 0">
            <If Condition="io_1 &gt;= 255.0">
              <Expression Expression="sysml_conditional_2 = 255.0" />
            </If>
            <Else>
              <If Condition="io_1 &lt;= 0.0">
                <Expression Expression="sysml_conditional_3 = 0.0" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_3 = io_1" />
              </Else>
              <Expression Expression="sysml_conditional_2 = sysml_conditional_3" />
            </Else>
            <Expression Expression="sysml_conditional_1 = sysml_conditional_2" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_1 = 0.0" />
          </Else>
          <Expression Expression="sysml_value_0 = sysml_conditional_1" />
          <LocalVariable Name="sysml_value_1" Type="double" />
          <If Condition="sysml_state_selectedChannel == 1">
            <If Condition="io_1 &gt;= 255.0">
              <Expression Expression="sysml_conditional_5 = 255.0" />
            </If>
            <Else>
              <If Condition="io_1 &lt;= 0.0">
                <Expression Expression="sysml_conditional_6 = 0.0" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_6 = io_1" />
              </Else>
              <Expression Expression="sysml_conditional_5 = sysml_conditional_6" />
            </Else>
            <Expression Expression="sysml_conditional_4 = sysml_conditional_5" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_4 = 0.0" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_4" />
          <LocalVariable Name="sysml_value_2" Type="double" />
          <If Condition="sysml_state_selectedChannel == 2">
            <If Condition="io_1 &gt;= 255.0">
              <Expression Expression="sysml_conditional_8 = 255.0" />
            </If>
            <Else>
              <If Condition="io_1 &lt;= 0.0">
                <Expression Expression="sysml_conditional_9 = 0.0" />
              </If>
              <Else>
                <Expression Expression="sysml_conditional_9 = io_1" />
              </Else>
              <Expression Expression="sysml_conditional_8 = sysml_conditional_9" />
            </Else>
            <Expression Expression="sysml_conditional_7 = sysml_conditional_8" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_7 = 0.0" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_7" />
          <Expression Expression="*io_2 = sysml_value_0" />
          <Expression Expression="*io_3 = sysml_value_1" />
          <Expression Expression="*io_4 = sysml_value_2" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>