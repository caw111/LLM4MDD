<Root xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.example.org/IRMetadata">
  <Config>
    <IterationCount Value="1" />
    <MainInitFunction Name="ProgramPage1_Init" />
    <MainExecFunction Name="ProgramPage1" />
    <MainCompositeState Name="ProgramPage1_state" />
  </Config>
  <File Name="ProgramPage1">
    <Struct Name="ProgramPage1_state" />
    <GlobalVariable Name="ProgramPage1_instance" Type="ProgramPage1_state" />
    <Function Name="ProgramPage1_Init" Type="FunctionInit" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="self" Type="ProgramPage1_state" IsAddress="1" />
      <Schedule>
        <Calculate Name="ProgramPage1_reset">
          <Ref Actor="CompositeActor" Path="ProgramPage1.reset" />
          <Expression Expression="sysml_state_servoPhaseMs = 0" />
          <Expression Expression="sysml_state_ledPhaseMs = 0" />
          <Expression Expression="sysml_state_ledToggle = false" />
        </Calculate>
      </Schedule>
    </Function>
    <GlobalVariable Name="sysml_state_servoPhaseMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_ledPhaseMs" Type="int" DefaultValue="0" />
    <GlobalVariable Name="sysml_state_ledToggle" Type="bool" DefaultValue="false" />
    <Function Name="ProgramPage1" Type="FunctionExec" ReturnType="void">
      <Ref Actor="CompositeActor" Path="ProgramPage1" />
      <Input Name="io_5" Type="int" />
      <Output Name="io_0" Type="bool" />
      <Output Name="io_1" Type="bool" />
      <Output Name="io_2" Type="double" />
      <Output Name="io_3" Type="double" />
      <Output Name="io_4" Type="double" />
      <Schedule>
        <Calculate Name="ProgramPage1_body">
          <Ref Actor="CompositeActor" Path="ProgramPage1.body" />
          <Input Name="io_5" Type="int" Source="io_5" />
          <Output Name="io_0" Type="bool" />
          <Output Name="io_1" Type="bool" />
          <Output Name="io_2" Type="double" />
          <Output Name="io_3" Type="double" />
          <Output Name="io_4" Type="double" />
          <LocalVariable Name="sysml_conditional_0" Type="bool" />
          <LocalVariable Name="sysml_conditional_1" Type="double" />
          <LocalVariable Name="sysml_conditional_2" Type="double" />
          <LocalVariable Name="sysml_conditional_3" Type="double" />
          <Expression Expression="sysml_state_ledPhaseMs = (sysml_state_ledPhaseMs + io_5)" />
          <Expression Expression="sysml_state_servoPhaseMs = (sysml_state_servoPhaseMs + io_5)" />
          <If Condition="(sysml_state_ledPhaseMs &gt;= 2000)">
            <Expression Expression="sysml_state_ledPhaseMs = (sysml_state_ledPhaseMs - 2000)" />
            <Expression Expression="sysml_state_ledToggle = (!sysml_state_ledToggle)" />
          </If>
          <If Condition="(sysml_state_servoPhaseMs &gt;= 4000)">
            <Expression Expression="sysml_state_servoPhaseMs = (sysml_state_servoPhaseMs - 4000)" />
          </If>
          <LocalVariable Name="sysml_value_0" Type="bool" />
          <Expression Expression="sysml_value_0 = sysml_state_ledToggle" />
          <LocalVariable Name="sysml_value_1" Type="bool" />
          <If Condition="sysml_state_ledToggle">
            <Expression Expression="sysml_conditional_0 = false" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_0 = true" />
          </Else>
          <Expression Expression="sysml_value_1 = sysml_conditional_0" />
          <LocalVariable Name="sysml_value_2" Type="double" />
          <If Condition="sysml_state_servoPhaseMs &lt; 2000">
            <Expression Expression="sysml_conditional_1 = 0.0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_1 = 180.0" />
          </Else>
          <Expression Expression="sysml_value_2 = sysml_conditional_1" />
          <LocalVariable Name="sysml_value_3" Type="double" />
          <If Condition="sysml_state_servoPhaseMs &lt; 2000">
            <Expression Expression="sysml_conditional_2 = 90.0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_2 = 0.0" />
          </Else>
          <Expression Expression="sysml_value_3 = sysml_conditional_2" />
          <LocalVariable Name="sysml_value_4" Type="double" />
          <If Condition="sysml_state_servoPhaseMs &lt; 2000">
            <Expression Expression="sysml_conditional_3 = 180.0" />
          </If>
          <Else>
            <Expression Expression="sysml_conditional_3 = 90.0" />
          </Else>
          <Expression Expression="sysml_value_4 = sysml_conditional_3" />
          <Expression Expression="*io_0 = sysml_value_0" />
          <Expression Expression="*io_1 = sysml_value_1" />
          <Expression Expression="*io_2 = sysml_value_2" />
          <Expression Expression="*io_3 = sysml_value_3" />
          <Expression Expression="*io_4 = sysml_value_4" />
        </Calculate>
      </Schedule>
    </Function>
  </File>
</Root>