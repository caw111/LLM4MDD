  "reference_cpp": "#include <Arduino.h>\n\nstatic bool evenOn = true;\nstatic unsigned long lastChange;\n\nstatic void render() {\n  for (uint8_t position = 0; position < 10; ++position) {\n    bool lit = ((position % 2 == 0) == evenOn);\n    digitalWrite(position + 2, lit ? HIGH : LOW);\n  }\n}\n\nvoid setup() {\n  for (uint8_t pin = 2; pin <= 11; ++pin) {\n    pinMode(pin, OUTPUT);\n  }\n  render();\n  lastChange = millis();\n}\n\nvoid loop() {\n  unsigned long now = millis();\n  if (now - lastChange >= 2000UL) {\n    lastChange += 2000UL;\n    evenOn = !evenOn;\n    render();\n  }\n}\n"
}
