  "reference_cpp": "#include <Arduino.h>\nconst byte buttons[4] = {2,3,4,5};\nconst byte buzzers[4] = {9,10,11,12};\nconst unsigned int frequencies[4] = {262,294,330,349};\nint active = -1;\nvoid setup() {\n  for (byte i=0; i<4; ++i) {\n    pinMode(buttons[i], INPUT);\n    pinMode(buzzers[i], OUTPUT);\n    digitalWrite(buzzers[i], LOW);\n  }\n}\nvoid loop() {\n  int selected = -1;\n  for (byte i=0; i<4; ++i) {\n    if (digitalRead(buttons[i]) == HIGH) { selected = i; break; }\n  }\n  if (selected != active) {\n    if (active >= 0) {\n      noTone(buzzers[active]);\n      digitalWrite(buzzers[active], LOW);\n    }\n    active = selected;\n    if (active >= 0) tone(buzzers[active], frequencies[active]);\n  }\n}\n"
}
