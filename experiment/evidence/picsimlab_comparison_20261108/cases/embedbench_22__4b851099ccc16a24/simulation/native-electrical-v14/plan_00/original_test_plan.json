  "reference_cpp": "#include <Arduino.h>\nconst int RED_PIN = 2;  \nconst int GREEN_PIN = 3;  \nconst int BLUE_PIN = 4;  \n\nvoid setup();\nvoid loop();\nvoid setup() {  \n  pinMode(RED_PIN, OUTPUT);  \n  pinMode(GREEN_PIN, OUTPUT);  \n  pinMode(BLUE_PIN, OUTPUT);  \n  analogWrite(RED_PIN, 0);  \n  analogWrite(GREEN_PIN, 0);  \n  analogWrite(BLUE_PIN, 0);  \n}  \nvoid loop() {  \n  int redValue = analogRead(A3);  \n  int greenValue = analogRead(A4);  \n  int blueValue = analogRead(A5);  \n  analogWrite(RED_PIN, map(redValue, 0, 1023, 0, 255));  \n  analogWrite(GREEN_PIN, map(greenValue, 0, 1023, 0, 255));  \n  analogWrite(BLUE_PIN, map(blueValue, 0, 1023, 0, 255));  \n  delay(20); \n}  "
