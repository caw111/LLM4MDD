  "reference_cpp": "#include <Arduino.h>\n\nvoid setup() {\n  pinMode(5, OUTPUT);\n  analogWrite(5, 0);\n}\n\nvoid loop() {\n  unsigned long phase = millis() % 2000UL;\n  unsigned long ramp = phase <= 1000UL ? phase : 2000UL - phase;\n  int brightness = (int)((ramp * 255UL + 500UL) / 1000UL);\n  analogWrite(5, brightness);\n  delay(1);\n}\n"
