  "reference_cpp": "#include <Arduino.h>\n\nvoid setup() {\n  pinMode(2, INPUT_PULLUP);\n  pinMode(A0, INPUT);\n  pinMode(9, OUTPUT);\n  analogWrite(9, 0);\n}\n\nvoid loop() {\n  if (digitalRead(2) == LOW) {\n    int raw = analogRead(A0);\n    int duty = (long)raw * 255 / 1023;\n    analogWrite(9, duty);\n  } else {\n    analogWrite(9, 0);\n  }\n}\n",
