  "reference_cpp": "#include <Arduino.h>\n#include <TM1637Display.h>\nTM1637Display display(4,5);\nint countValue=0;\nstruct Button { uint8_t pin; int raw; int stable; unsigned long changed; };\nButton up={2,HIGH,HIGH,0};\nButton down={3,HIGH,HIGH,0};\nbool pressed(Button &b) {\n  int r=digitalRead(b.pin);\n  unsigned long now=millis();\n  if(r!=b.raw){b.raw=r;b.changed=now;}\n  if(r!=b.stable && now-b.changed>=30){\n    b.stable=r;\n    return r==LOW;\n  }\n  return false;\n}\nvoid changeCount(int delta){\n  int next=countValue+delta;\n  if(next<0) next=0;\n  if(next>20) next=20;\n  countValue=next;\n  display.showNumberDec(countValue,false);\n  if(countValue==0 || countValue==20) tone(6,1000,200);\n}\nvoid setup(){\n  pinMode(2,INPUT_PULLUP);\n  pinMode(3,INPUT_PULLUP);\n  pinMode(6,OUTPUT);\n  display.setBrightness(7);\n  display.showNumberDec(countValue,false);\n  tone(6,1000,200);\n}\nvoid loop(){\n  if(pressed(up)) changeCount(1);\n  if(pressed(down)) changeCount(-1);\n}\n",
