  "reference_cpp": "#include <Arduino.h>\n\nvoid setup() {\n  pinMode(A0, INPUT);\n  for (int pin = 2; pin <= 11; ++pin) {\n    pinMode(pin, OUTPUT);\n    digitalWrite(pin, LOW);\n  }\n}\n\nvoid loop() {\n  int raw = analogRead(A0);\n  int count = (int)map(raw, 1023, 0, 0, 10);\n  for (int segment = 1; segment <= 10; ++segment) {\n    digitalWrite(segment + 1, segment <= count ? HIGH : LOW);\n  }\n  delay(10);\n}\n"
