  "reference_cpp": "#include <Arduino.h>\n\nconst uint8_t masks[10] = {0x3f,0x06,0x5b,0x4f,0x66,0x6d,0x7d,0x07,0x7f,0x6f};\nuint8_t lastDigit = 255;\n\nvoid showDigit(uint8_t digit) {\n  for (uint8_t i = 0; i < 7; ++i) {\n    digitalWrite(2 + i, (masks[digit] & (1U << i)) ? LOW : HIGH);\n  }\n  digitalWrite(9, HIGH);\n}\n\nvoid setup() {\n  for (uint8_t pin = 2; pin <= 9; ++pin) {\n    digitalWrite(pin, HIGH);\n    pinMode(pin, OUTPUT);\n  }\n  lastDigit = (millis() / 1000UL) % 10;\n  showDigit(lastDigit);\n}\n\nvoid loop() {\n  uint8_t digit = (millis() / 1000UL) % 10;\n  if (digit != lastDigit) {\n    showDigit(digit);\n    lastDigit = digit;\n  }\n}\n",
