  "reference_cpp": "#include <Arduino.h>\n#include <stdlib.h>\n\nchar buffer[24];\nuint8_t used = 0;\nunsigned long lastByte = 0;\n\nvoid applyThreshold(long threshold) {\n  for (int anode = 1; anode <= 10; ++anode) {\n    digitalWrite(anode + 1, anode < threshold ? HIGH : LOW);\n  }\n}\n\nvoid finishInput() {\n  if (!used) return;\n  buffer[used] = '\\0';\n  char *end;\n  long threshold = strtol(buffer, &end, 10);\n  if (end != buffer) applyThreshold(threshold);\n  used = 0;\n}\n\nvoid setup() {\n  for (int pin = 2; pin <= 11; ++pin) {\n    pinMode(pin, OUTPUT);\n    digitalWrite(pin, LOW);\n  }\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  while (Serial.available() > 0) {\n    char c = (char)Serial.read();\n    lastByte = millis();\n    if (c == '\\n' || c == '\\r') {\n      finishInput();\n    } else if (used < sizeof(buffer) - 1) {\n      buffer[used++] = c;\n    }\n  }\n  if (used && (unsigned long)(millis() - lastByte) >= 20) {\n    finishInput();\n  }\n}\n",
