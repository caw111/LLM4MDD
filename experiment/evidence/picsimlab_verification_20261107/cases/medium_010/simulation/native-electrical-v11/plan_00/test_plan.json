  "reference_cpp": "#include <Arduino.h>\n#include <TM1637Display.h>\n\nTM1637Display display(4, 5);\n\nvoid setup() {\n  pinMode(A1, INPUT);\n  pinMode(2, INPUT_PULLUP);\n  display.setBrightness(7);\n}\n\nvoid loop() {\n  int value = (digitalRead(2) == LOW) ? 8888 : analogRead(A1);\n  display.showNumberDec(value, false);\n  delay(20);\n}\n",
