  "reference_cpp": "#include <Arduino.h>\n\nvoid setup() {\n  for (int pin = 2; pin <= 11; ++pin) {\n    pinMode(pin, OUTPUT);\n    digitalWrite(pin, LOW);\n  }\n  pinMode(A0, INPUT);\n}\n\nvoid loop() {\n  int raw = analogRead(A0);\n  int count = (int)map(raw, 0, 1023, 0, 10);\n  for (int i = 0; i < 10; ++i) {\n    digitalWrite(i + 2, i < count ? HIGH : LOW);\n  }\n}\n",
