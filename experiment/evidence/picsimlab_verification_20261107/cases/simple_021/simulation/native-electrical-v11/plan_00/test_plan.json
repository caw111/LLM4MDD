  "reference_cpp": "#include <Arduino.h>\n\nconst uint8_t BUZZER = 6;\nunsigned long nextStart = 1000UL;\nunsigned long startedAt = 0;\nbool sounding = false;\n\nvoid setup() {\n  pinMode(BUZZER, OUTPUT);\n  noTone(BUZZER);\n  digitalWrite(BUZZER, LOW);\n}\n\nvoid loop() {\n  unsigned long now = millis();\n  if (sounding && now - startedAt >= 100UL) {\n    noTone(BUZZER);\n    digitalWrite(BUZZER, LOW);\n    sounding = false;\n  }\n  if ((long)(now - nextStart) >= 0) {\n    startedAt = now;\n    nextStart += 1000UL;\n    tone(BUZZER, 1000);\n    sounding = true;\n  }\n}\n",
