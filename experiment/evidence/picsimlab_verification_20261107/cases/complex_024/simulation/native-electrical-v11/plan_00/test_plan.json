  "reference_cpp": "#include <Arduino.h>\n\nconst uint8_t BUTTON = 2;\nconst uint8_t BUZZER = 6;\nbool lastRaw = HIGH;\nbool stableState = HIGH;\nunsigned long changedAt = 0;\nunsigned long sampleCount = 0;\n\nvoid takeSample() {\n  int light = analogRead(A0);\n  int rawTemperature = analogRead(A1);\n  float temperature = rawTemperature * (500.0f / 1023.0f);\n  ++sampleCount;\n  Serial.print(\"Light: \");\n  Serial.print(light);\n  Serial.print(\" Temperature: \");\n  Serial.print(temperature, 2);\n  Serial.print(\" C Count: \");\n  Serial.println(sampleCount);\n  if (sampleCount % 5 == 0) tone(BUZZER, 2000, 100);\n}\n\nvoid setup() {\n  pinMode(BUTTON, INPUT_PULLUP);\n  pinMode(BUZZER, OUTPUT);\n  digitalWrite(BUZZER, LOW);\n  Serial.begin(9600);\n}\n\nvoid loop() {\n  unsigned long now = millis();\n  bool raw = digitalRead(BUTTON);\n  if (raw != lastRaw) {\n    lastRaw = raw;\n    changedAt = now;\n  }\n  if (raw != stableState && now - changedAt >= 25) {\n    stableState = raw;\n    if (stableState == LOW) takeSample();\n  }\n}\n",
