      "reference_cpp": "#include <Arduino.h>\n\nbool running = false;\nbool ledOn = false;\nint previousButton = HIGH;\nunsigned long lastToggle = 0;\n\nvoid setup() {\n  pinMode(2, INPUT_PULLUP);\n  pinMode(13, OUTPUT);\n  digitalWrite(13, LOW);\n}\n\nvoid loop() {\n  unsigned long now = millis();\n  int button = digitalRead(2);\n  if (previousButton == HIGH && button == LOW) {\n    running = !running;\n    ledOn = false;\n    digitalWrite(13, LOW);\n    lastToggle = now;\n  }\n  previousButton = button;\n  if (running && now - lastToggle >= 500UL) {\n    lastToggle = now;\n    ledOn = !ledOn;\n    digitalWrite(13, ledOn ? HIGH : LOW);\n  }\n}\n"
