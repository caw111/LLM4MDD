      "reference_cpp": "#include <Arduino.h>\n#include <DHT.h>\n#include <math.h>\n\nDHT dht(7, DHT11);\nunsigned long lastPoll = 0;\nunsigned int consecutiveNear = 0;\nbool reportedRun = false;\n\nfloat readDistanceCm() {\n  digitalWrite(8, LOW);\n  delayMicroseconds(2);\n  digitalWrite(8, HIGH);\n  delayMicroseconds(10);\n  digitalWrite(8, LOW);\n  unsigned long duration = pulseIn(9, HIGH, 30000UL);\n  if (duration == 0) return NAN;\n  return duration / 58.0f;\n}\n\nvoid setup() {\n  pinMode(8, OUTPUT);\n  digitalWrite(8, LOW);\n  pinMode(9, INPUT);\n  pinMode(13, OUTPUT);\n  digitalWrite(13, LOW);\n  Serial.begin(9600);\n  dht.begin();\n  lastPoll = millis();\n}\n\nvoid loop() {\n  unsigned long now = millis();\n  if ((unsigned long)(now - lastPoll) < 3000UL) return;\n  lastPoll += 3000UL;\n  float temperature = dht.readTemperature();\n  float distance = readDistanceCm();\n  Serial.print(\"Temperature C: \");\n  Serial.println(temperature);\n  Serial.print(\"Distance cm: \");\n  Serial.println(distance);\n  if (!isnan(distance) && distance < 20.0f) {\n    if (consecutiveNear < 3) ++consecutiveNear;\n    if (consecutiveNear >= 3) {\n      digitalWrite(13, HIGH);\n      if (!reportedRun) {\n        Serial.println(\"persistent object detected\");\n        reportedRun = true;\n      }\n    }\n  } else {\n    consecutiveNear = 0;\n    reportedRun = false;\n  }\n}\n"
    },
