      "reference_cpp": "#include <Arduino.h>\n#include <DHT.h>\n#include <TM1637Display.h>\n#include <math.h>\n\nDHT sensor(7, DHT11);\nTM1637Display display(4, 5);\nunsigned long lastRefresh = 0;\n\nvoid setup() {\n  sensor.begin();\n  display.setBrightness(7);\n  display.clear();\n  lastRefresh = millis();\n}\n\nvoid loop() {\n  unsigned long now = millis();\n  if (now - lastRefresh >= 2000UL) {\n    lastRefresh = now;\n    float temperature = sensor.readTemperature();\n    if (!isnan(temperature)) {\n      display.showNumberDec((int)round(temperature), false);\n    }\n  }\n}\n",
