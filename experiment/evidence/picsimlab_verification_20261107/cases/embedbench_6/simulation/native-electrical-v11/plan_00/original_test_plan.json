  "reference_cpp": "#include <Arduino.h>\n\nvoid setup() {\n  digitalWrite(2, LOW);\n  digitalWrite(3, LOW);\n  digitalWrite(4, LOW);\n  pinMode(2, OUTPUT);\n  pinMode(3, OUTPUT);\n  pinMode(4, OUTPUT);\n  pinMode(A3, INPUT);\n}\n\nvoid loop() {\n  int value = analogRead(A3);\n  int region = (value < 342) ? 0 : ((value < 683) ? 1 : 2);\n  analogWrite(2, region == 0 ? 255 : 0);\n  analogWrite(3, region == 1 ? 255 : 0);\n  analogWrite(4, region == 2 ? 255 : 0);\n}\n"
