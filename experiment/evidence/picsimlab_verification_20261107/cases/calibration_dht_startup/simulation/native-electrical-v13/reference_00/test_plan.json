{
  "horizon_ms": 3000,
  "input_steps": [
    {
      "at_ms": 0,
      "kind": "temperature",
      "pin": 7,
      "value": 32
    },
    {
      "at_ms": 0,
      "kind": "humidity",
      "pin": 7,
      "value": 50
    }
  ],
  "checks": [
    {
      "id": "initial_value",
      "kind": "serial",
      "from_ms": 0,
      "to_ms": 800,
      "regex": "^INITIAL:32[.]00$",
      "min_count": 1,
      "requirement_quote": "Time-zero physical temperature is 32 C before the first read"
    }
  ],
  "reference_cpp": "#include <Arduino.h>\n#include <DHT.h>\nDHT dht(7,DHT11);void setup(){Serial.begin(9600);dht.begin();Serial.print(\"INITIAL:\");Serial.println(dht.readTemperature(),2);}void loop(){}\n",
  "electrical_led_pins": {}
}