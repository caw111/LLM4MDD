      "reference_cpp": "#include <Arduino.h>\n#include <TM1637Display.h>\n\nTM1637Display display(4, 5);\nconst uint8_t players[4] = {2, 3, 7, 8};\nunsigned long totals[4] = {0, 0, 0, 0};\nbool locked = false;\nbool resetHeld = false;\nbool cleared = false;\nunsigned long resetStart = 0;\nuint8_t rawState[5];\nuint8_t stableState[5];\nunsigned long changedAt[5];\n\nuint8_t inputPin(uint8_t i) { return i < 4 ? players[i] : 9; }\n\nvoid resetRound() {\n  locked = false;\n  display.clear();\n  digitalWrite(13, LOW);\n  noTone(6);\n}\n\nvoid setup() {\n  Serial.begin(9600);\n  for (uint8_t i = 0; i < 5; ++i) {\n    pinMode(inputPin(i), INPUT_PULLUP);\n    rawState[i] = stableState[i] = HIGH;\n    changedAt[i] = 0;\n  }\n  pinMode(13, OUTPUT);\n  pinMode(6, OUTPUT);\n  display.setBrightness(7);\n  resetRound();\n}\n\nvoid loop() {\n  unsigned long now = millis();\n  bool pressed[5] = {false, false, false, false, false};\n  for (uint8_t i = 0; i < 5; ++i) {\n    uint8_t v = digitalRead(inputPin(i));\n    if (v != rawState[i]) {\n      rawState[i] = v;\n      changedAt[i] = now;\n    }\n    if (v != stableState[i] && now - changedAt[i] >= 25) {\n      stableState[i] = v;\n      pressed[i] = (v == LOW);\n    }\n  }\n  if (pressed[4]) {\n    resetHeld = true;\n    resetStart = now;\n    cleared = false;\n    resetRound();\n  }\n  if (resetHeld && stableState[4] == HIGH) resetHeld = false;\n  if (resetHeld) {\n    if (!cleared && now - resetStart >= 3000) {\n      for (uint8_t i = 0; i < 4; ++i) totals[i] = 0;\n      cleared = true;\n    }\n    return;\n  }\n  if (locked) return;\n  for (uint8_t i = 0; i < 4; ++i) {\n    if (pressed[i]) {\n      locked = true;\n      ++totals[i];\n      display.showNumberDec(i + 1, false);\n      digitalWrite(13, HIGH);\n      tone(6, 1800, 120);\n      Serial.print(\"timestamp_ms=\");\n      Serial.print(now);\n      Serial.print(\" player=\");\n      Serial.println(i + 1);\n      break;\n    }\n  }\n}\n"
    },
    "engine": null
