{
  "states":[{"name":"count","type":"i32","initial":0},{"name":"previousPressed","type":"bool","initial":false}],
  "updates":[
    {"if":"pressed and not previousPressed","then":[{"assign":"count","value":"count + 37"},{"if":"count > 99","then":[{"assign":"count","value":0}]}]},
    {"assign":"previousPressed","value":"pressed"}
  ],
  "outputs":{"displayNumber":"count"}
}
