      "meaning": "up",
      "device": "digital_input",
      "hardware": "2",
      "binding": {
        "kind": "digital_input",
        "pin": 2,
        "pullup": true,
        "active_high": false
      }
    },
    {
      "name": "down",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "sample_period_ms": 10,
      "meaning": "down",
      "device": "digital_input",
      "hardware": "3",
      "binding": {
        "kind": "digital_input",
        "pin": 3,
        "pullup": true,
        "active_high": false
      }
    },
    {
      "name": "reset",
      "direction": "input",
      "type": "bool",
      "unit": "1",
      "initial": false,
      "sample_period_ms": 10,
      "meaning": "reset",
      "device": "digital_input",
      "hardware": "4",
      "binding": {
        "kind": "digital_input",
        "pin": 4,
        "pullup": true,
        "active_high": false
      }
