  "requirements": [
    {
      "id": "R1",
      "text": "验收约定：目标板Mega2560；A3、A4分别控制D2、D3的PWM，原始ADC0..1023线性映射0..255，容差1计数；A5映射floor(ADC*99/1023)得到显示整数0..99。偶数只允许D2按A3设定亮度输出，D3为0；奇数相反，D2为0、D3按A4亮度输出，亮度设为0时允许熄灭。初始显示00且两个LED熄灭，之后连续响应真实采样值，变化50ms内反映。sr1十位、sr2个位，保留前导零，遵守原接线及共阳极。",
      "assertion_ids": [
        "independent_display_and_pwm"
      ]
    }
  ],
