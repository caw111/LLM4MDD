{
  "states": [],
  "updates": [],
  "calculations": [
    {
      "name": "shown",
      "type": "i32",
      "expression": "RealFunctions::floor(numberAdc * 99.0 / 1023.0)"
    },
    {
      "name": "isEven",
      "type": "bool",
      "expression": "shown == 2 * RealFunctions::floor(shown / 2.0)"
    }
  ],
  "outputs": {
    "displayNumber": "shown",
    "brightnessA": {
      "if": "isEven",
      "then": "levelA * 255.0 / 1023.0",
      "else": 0.0
    },
    "brightnessB": {
      "if": "isEven",
      "then": 0.0,
      "else": "levelB * 255.0 / 1023.0"
    }
  }
}